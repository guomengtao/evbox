<template>
  <div class="pro-card-inline" style="background-color: {{ theme.card }}">
    <div class="pro-card-top">
      <text class="pro-icon">♛</text>
      <text class="pro-title" style="color: {{ theme.accent }}">{{ title }}</text>
    </div>

    <text class="pro-desc" style="color: {{ theme.textSecondary }}">{{ description }}</text>

    <div class="pro-benefits">
      <div for="{{ benefits }}" class="benefit-row">
        <text class="benefit-check" style="color: {{ theme.accent }}">✓</text>
        <text class="benefit-text" style="color: {{ theme.text }}">{{ $item }}</text>
      </div>
    </div>

    <div class="pro-btn-row">
      <input class="pro-btn" type="button" value="立即解锁" onclick="doUnlock"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="pro-btn-cancel" type="button" value="{{ cancelText }}" onclick="doCancel"
             style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../data/store.js")

export default {
  private: {
    title: "解锁高级功能",
    description: "一次性解锁，永久使用全部高级功能",
    benefits: ["全部工具", "数据备份与恢复", "首页自定义", "多套主题"],
    cancelText: "继续使用标准版",
    theme: {
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      bg: "#1a1a2e",
      btnSecondary: "#333355",
      btnSecondaryText: "#a0a0b0"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
  },

  configure(options) {
    options = options || {}
    this.title = options.title || "解锁高级功能"
    this.description = options.description || "一次性解锁，永久使用全部高级功能"
    this.benefits = options.benefits || ["全部工具", "数据备份与恢复", "首页自定义", "多套主题"]
    this.cancelText = options.cancelText || "继续使用标准版"
  },

  doUnlock() {
    router.push({ uri: "/pages/activation" })
  },

  doCancel() {
    this.$emit("cancel")
  }
}
</script>

