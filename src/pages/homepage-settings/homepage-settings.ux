<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">首页设置</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="section section-first" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">时钟</text>
        <div class="switch-track" style="background-color: {{ showTime ? theme.accent : theme.border }}" onclick="toggleTime">
          <div class="switch-thumb" style="left: {{ showTime ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}" if="{{ showTime }}"></div>
      <div class="time-format-row" if="{{ showTime }}">
        <div class="unit-chip" style="border-color: {{ timeFormat.year ? theme.accent : theme.border }}; background-color: {{ timeFormat.year ? theme.cardLight : theme.border }}" onclick="toggleYear">
          <text class="unit-text" style="color: {{ timeFormat.year ? theme.accent : theme.textSecondary }}">年</text>
        </div>
        <div class="unit-chip" style="border-color: {{ timeFormat.month ? theme.accent : theme.border }}; background-color: {{ timeFormat.month ? theme.cardLight : theme.border }}" onclick="toggleMonth">
          <text class="unit-text" style="color: {{ timeFormat.month ? theme.accent : theme.textSecondary }}">月</text>
        </div>
        <div class="unit-chip" style="border-color: {{ timeFormat.day ? theme.accent : theme.border }}; background-color: {{ timeFormat.day ? theme.cardLight : theme.border }}" onclick="toggleDay">
          <text class="unit-text" style="color: {{ timeFormat.day ? theme.accent : theme.textSecondary }}">日</text>
        </div>
        <text class="colon-sep" style="color: {{ theme.textMuted }}"></text>
        <div class="unit-chip" style="border-color: {{ timeFormat.hour ? theme.accent : theme.border }}; background-color: {{ timeFormat.hour ? theme.cardLight : theme.border }}" onclick="toggleHour">
          <text class="unit-text" style="color: {{ timeFormat.hour ? theme.accent : theme.textSecondary }}">时</text>
        </div>
        <text class="colon-sep" style="color: {{ theme.textMuted }}">:</text>
        <div class="unit-chip" style="border-color: {{ timeFormat.minute ? theme.accent : theme.border }}; background-color: {{ timeFormat.minute ? theme.cardLight : theme.border }}" onclick="toggleMinute">
          <text class="unit-text" style="color: {{ timeFormat.minute ? theme.accent : theme.textSecondary }}">分</text>
        </div>
        <text class="colon-sep" style="color: {{ theme.textMuted }}">:</text>
        <div class="unit-chip" style="border-color: {{ timeFormat.second ? theme.accent : theme.border }}; background-color: {{ timeFormat.second ? theme.cardLight : theme.border }}" onclick="toggleSecond">
          <text class="unit-text" style="color: {{ timeFormat.second ? theme.accent : theme.textSecondary }}">秒</text>
        </div>
      </div>
      <text class="time-preview" if="{{ showTime }}" style="color: {{ theme.accent }}">{{ timePreview }}</text>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">倒数日大数字</text>
        <div class="switch-track" style="background-color: {{ showCountdown ? theme.accent : theme.border }}" onclick="toggleCountdown">
          <div class="switch-thumb" style="left: {{ showCountdown ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}" if="{{ showCountdown }}"></div>
      <div class="item-row item-row-last" onclick="openCountdownManage" if="{{ showCountdown }}">
        <text class="item-label" style="color: {{ theme.text }}">管理倒数日</text>
        <text class="item-hint" style="color: {{ theme.textMuted }}">钉首页</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row" onclick="toggleToolMode">
        <text class="item-label" style="color: {{ theme.text }}">工具显示</text>
        <div class="row-right">
          <text class="item-hint" style="color: {{ theme.textMuted }}">{{ toolModeLabel }}</text>
          <text class="fold-arrow" style="color: {{ theme.textMuted }}">{{ showToolMode ? 'v' : '›' }}</text>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}" if="{{ showToolMode }}"></div>
      <div class="time-format-row" if="{{ showToolMode }}">
        <div class="unit-chip" onclick="selectToolViewMode('icon')"
             style="border-color: {{ toolViewMode === 'icon' ? theme.accent : theme.border }}; background-color: {{ toolViewMode === 'icon' ? theme.cardLight : 'transparent' }}">
          <text class="unit-text" style="color: {{ toolViewMode === 'icon' ? theme.accent : theme.textSecondary }}">图标</text>
        </div>
        <div class="unit-chip" onclick="selectToolViewMode('list')"
             style="border-color: {{ toolViewMode === 'list' ? theme.accent : theme.border }}; background-color: {{ toolViewMode === 'list' ? theme.cardLight : 'transparent' }}">
          <text class="unit-text" style="color: {{ toolViewMode === 'list' ? theme.accent : theme.textSecondary }}">列表</text>
        </div>
        <div class="unit-chip" onclick="selectToolViewMode('rich')"
             style="border-color: {{ toolViewMode === 'rich' ? theme.accent : theme.border }}; background-color: {{ toolViewMode === 'rich' ? theme.cardLight : 'transparent' }}">
          <text class="unit-text" style="color: {{ toolViewMode === 'rich' ? theme.accent : theme.textSecondary }}">图文</text>
        </div>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row" onclick="toggleFontSize">
        <text class="item-label" style="color: {{ theme.text }}">字号</text>
        <div class="row-right">
          <text class="item-hint" style="color: {{ theme.textMuted }}">{{ displaySize }}px</text>
          <text class="fold-arrow" style="color: {{ theme.textMuted }}">{{ showFontSize ? 'v' : '›' }}</text>
        </div>
      </div>
      <div class="row-divider" style="background-color: {{ theme.border }}" if="{{ showFontSize }}"></div>
      <div if="{{ showFontSize }}" class="font-size-body">
        <div class="scale-row">
          <input class="scale-btn" type="button" value="−" onclick="decreaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="scale-value" style="color: {{ theme.accent }}">{{ displaySize }}px</text>
          <input class="scale-btn" type="button" value="+" onclick="increaseFont" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="preview-box" style="background-color: {{ theme.cardLight }}">
          <text class="preview-font" style="font-size: {{ displaySize }}px; color: {{ theme.text }}">示例文本</text>
        </div>
        <text class="scope-hint" style="color: {{ theme.textMuted }}">影响首页等页面的正文字号</text>
      </div>
    </div>

    <div class="section" style="background-color: {{ theme.card }}">
      <div class="item-row">
        <text class="item-label" style="color: {{ theme.text }}">钉首页</text>
        <div class="switch-track" style="background-color: {{ showPinnedBar ? theme.accent : theme.border }}" onclick="togglePinnedBar">
          <div class="switch-thumb" style="left: {{ showPinnedBar ? '22px' : '2px' }}; background-color: {{ theme.bg }}"></div>
        </div>
      </div>
      <div if="{{ showPinnedBar }}">
        <div class="row-divider" style="background-color: {{ theme.border }}"></div>
        <div class="item-row item-row-last" onclick="openPinnedPages">
          <text class="item-label" style="color: {{ theme.text }}">管理钉首页</text>
          <text class="item-hint" style="color: {{ theme.textMuted }}">管理</text>
        </div>
      </div>
    </div>

    <div class="overlay-modal" show="{{ showDialog }}" onclick="dismissDialog">
      <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级版</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">一次性解锁，永久使用全部高级功能</text>
        <div class="benefit-list">
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 全部工具</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
        </div>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="返回" onclick="goBack"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    showTime: true,
    showPinnedBar: true,
    showCountdown: true,
    showToolMode: false,
    toolViewMode: "icon",
    toolModeLabel: "图标",
    displaySize: 48,
    showFontSize: false,
    timeFormat: { year: false, month: false, day: false, hour: true, minute: true, second: false },
    timePreview: "",
    showDialog: false
  },
  onInit() {
    dlog("[HOMEPAGE-SETTINGS] onInit: page created")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadSettings()
  },
  onReady() {
    dlog("[HOMEPAGE-SETTINGS] onReady: checking premium...")
    this.checkAndShowOverlay()
  },
  onShow() {
    dlog("[HOMEPAGE-SETTINGS] onShow: page shown")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadSettings()
  },
  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },
  loadSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showTime = settings.showTime !== false
      self.showPinnedBar = settings.showPinnedBar !== false
      self.showCountdown = settings.showCountdown !== false
      self.toolViewMode = settings.toolViewMode === "list" || settings.toolViewMode === "rich"
        ? settings.toolViewMode
        : "icon"
      self.toolModeLabel = self.modeLabel(self.toolViewMode)
      self.displaySize = settings.displaySize || 48
      self.timeFormat = settings.timeFormat || { year: false, month: false, day: false, hour: true, minute: true, second: true }
      self.updateTimePreview()
    })
  },
  saveSettings() {
    store.setHomepageSettings({
      showTime: this.showTime,
      showPinnedBar: this.showPinnedBar,
      showCountdown: this.showCountdown,
      toolViewMode: this.toolViewMode,
      timeFormat: this.timeFormat
    })
  },

  modeLabel(mode) {
    if (mode === "list") return "列表"
    if (mode === "rich") return "图文"
    return "图标"
  },

  toggleToolMode() {
    this.showToolMode = !this.showToolMode
  },

  selectToolViewMode(mode) {
    this.toolViewMode = mode
    this.toolModeLabel = this.modeLabel(mode)
    this.saveSettings()
  },
  checkAndShowOverlay() {
    dlog("[HOMEPAGE-SETTINGS] checkAndShowOverlay: checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      if (!unlocked) {
        dlog("[HOMEPAGE-SETTINGS] checkAndShowOverlay: not premium, showing dialog")
        self.showDialog = true
      }
    })
  },

  goToPremium() {
    dlog("[HOMEPAGE-SETTINGS] goToPremium: navigating to activation")
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  goBack() {
    store.setHomepageSettings({
      showTime: this.showTime,
      showPinnedBar: this.showPinnedBar,
      showCountdown: this.showCountdown,
      toolViewMode: this.toolViewMode,
      timeFormat: this.timeFormat
    }, function() { router.back() })
  },

  dismissDialog() {
    this.showDialog = false
  },

  stopBubble() {
  },

  toggleTime() {
    this.showTime = !this.showTime
    this.saveSettings()
  },
  togglePinnedBar() {
    this.showPinnedBar = !this.showPinnedBar
    this.saveSettings()
  },
  toggleCountdown() {
    this.showCountdown = !this.showCountdown
    this.saveSettings()
  },
  openCountdownManage() {
    router.push({ uri: "/pages/countdown-manage" })
  },
  toggleFontSize() {
    this.showFontSize = !this.showFontSize
  },
  openPinnedPages() {
    router.push({ uri: "/pages/pinned-pages" })
  },

  toggleTimeUnit(unit) {
    this.timeFormat[unit] = !this.timeFormat[unit]
    this.updateTimePreview()
    this.saveSettings()
  },
  toggleYear() { this.toggleTimeUnit("year") },
  toggleMonth() { this.toggleTimeUnit("month") },
  toggleDay() { this.toggleTimeUnit("day") },
  toggleHour() { this.toggleTimeUnit("hour") },
  toggleMinute() { this.toggleTimeUnit("minute") },
  toggleSecond() { this.toggleTimeUnit("second") },
  updateTimePreview() {
    var now = new Date()
    var dateParts = []
    var timeParts = []
    if (this.timeFormat.year) dateParts.push(now.getFullYear() + "年")
    if (this.timeFormat.month) dateParts.push((now.getMonth() + 1) + "月")
    if (this.timeFormat.day) dateParts.push(now.getDate() + "日")
    if (this.timeFormat.hour) timeParts.push((now.getHours() < 10 ? "0" : "") + now.getHours())
    if (this.timeFormat.minute) timeParts.push((now.getMinutes() < 10 ? "0" : "") + now.getMinutes())
    if (this.timeFormat.second) timeParts.push((now.getSeconds() < 10 ? "0" : "") + now.getSeconds())
    var dateStr = dateParts.join(" ")
    var timeStr = timeParts.join(":")
    if (dateStr && timeStr) {
      this.timePreview = dateStr + " " + timeStr
    } else {
      this.timePreview = dateStr || timeStr || "00:00:00"
    }
  }
}
</script>

