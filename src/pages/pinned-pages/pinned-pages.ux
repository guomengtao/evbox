<template>
  <div class="pinned-pages-page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">已钉页面</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="empty-state" if="pinnedList.length === 0">
      <text class="empty-icon">📌</text>
      <text class="empty-title" style="color: {{ theme.textSecondary }}">暂无已钉页面</text>
      <text class="empty-desc" style="color: {{ theme.textMuted }}">打开任意页面，将其钉到首页可快速访问。</text>
    </div>

    <scroll class="pinned-scroll" scroll-y="true" if="pinnedList.length > 0">
      <div class="pinned-section">
        <div class="pinned-card" for="{{ pinnedList }}" style="background-color: {{ theme.card }}">
          <div class="card-body" onclick="openPage($item.uri)">
            <text class="card-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          </div>
          <text class="unpin-btn" onclick="unpinPage($idx)" style="color: {{ theme.textMuted }}">取消</text>
        </div>
      </div>
    </scroll>

    <div class="footer-area">
      <text class="pin-self-btn" onclick="togglePinSelf" style="color: {{ theme.textMuted }}">{{ isThisPinned ? '取消钉本页' : '钉本页到首页' }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var pinHelper = require("../../data/pin-helper.js")

var PAGE_URI = "/pages/pinned-pages"
var PAGE_NAME = "已钉页面"

export default {
  private: {
    iconTheme: "dark",
    pinnedList: [],
    isThisPinned: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadData()
  },

  loadData() {
    var self = this
    pinHelper.getList(function(list) {
      self.pinnedList = list
    })
    pinHelper.isPinned(PAGE_URI, function(yes) {
      self.isThisPinned = yes
    })
  },

  openPage(uri) {
    router.push({ uri: uri })
  },

  unpinPage(idx) {
    var self = this
    var item = self.pinnedList[idx]
    pinHelper.unpinPage(item.uri, function() {
      self.loadData()
    })
  },

  togglePinSelf() {
    var self = this
    if (self.isThisPinned) {
      pinHelper.unpinPage(PAGE_URI, function() {
        self.isThisPinned = false
      })
    } else {
      pinHelper.pinPage(PAGE_NAME, PAGE_URI, function() {
        self.isThisPinned = true
      })
    }
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.pinned-pages-page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
}

/* Empty state */
.empty-state {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 40px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
  line-height: 58px;
}

.empty-title {
  font-size: 28px;
  margin-bottom: 10px;
  line-height: 36px;
}

.empty-desc {
  font-size: 24px;
  text-align: center;
  line-height: 32px;
  padding: 0 20px;
}

/* Scroll area */
.pinned-scroll {
  flex: 1;
  flex-direction: column;
}

.pinned-section {
  flex-direction: column;
  padding-bottom: 10px;
}

.pinned-card {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 14px;
  padding: 16px 18px;
  margin-bottom: 10px;
}

.card-body {
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 30px;
  line-height: 38px;
  lines: 1;
  min-width: 0;
}

.unpin-btn {
  font-size: 22px;
  padding: 6px 0 6px 14px;
  flex-shrink: 0;
  line-height: 28px;
}

/* Footer */
.footer-area {
  flex-direction: row;
  justify-content: center;
  padding: 14px 0 6px 0;
}

.pin-self-btn {
  font-size: 26px;
  text-align: center;
  padding: 6px 20px;
  border-radius: 16px;
  line-height: 34px;
}

/* Capsule primary */
@media (shape: capsule), (shape: pill-shaped) {
  .pinned-pages-page {
    padding: 38px 8px 10px 8px;
  }
  
  
  
  .empty-icon {
    font-size: 40px;
    margin-bottom: 12px;
    line-height: 48px;
  }
  .empty-title {
    font-size: 24px;
    line-height: 32px;
  }
  .empty-desc {
    font-size: 20px;
    line-height: 28px;
    padding: 0 16px;
  }
  .pinned-card {
    padding: 12px 14px;
    margin-bottom: 8px;
    border-radius: 12px;
  }
  .card-name {
    font-size: 26px;
    line-height: 34px;
    lines: 1;
  }
  .unpin-btn {
    font-size: 20px;
    line-height: 26px;
  }
  .pin-self-btn {
    font-size: 22px;
    line-height: 30px;
    padding: 4px 16px;
  }
  .footer-area {
    padding: 10px 0 4px 0;
  }
}

@media (shape: circle) {
  .pinned-pages-page {
    padding: 44px 36px 44px 36px;
  }
  
  
  .card-name {
    font-size: 26px;
  }
  .card-hint {
    font-size: 20px;
  }
}

@media (shape: rect) {
  .pinned-pages-page {
    padding: 6px 12px 16px 12px;
  }
  
  
  .card-name {
    font-size: 28px;
  }
}
</style>