<template>
  <div id="evbox-page" class="schedule-page" style="background-color: {{ theme.bg }}">
    <div class="clock-row" if="{{ showTime }}">
      <text class="clock-text" style="color: {{ theme.textSecondary }}">{{ currentTime }}</text>
    </div>

    <!-- 2026-10-02 按用户反馈：头部去掉日期行，只保留时钟 -->
    <!-- 倒数日大数字（数据源 pages/countdown-manage，模块 countdownHero） -->
    <div class="cd-hero" if="{{ showCountdown && hasCountdown }}" onclick="openCountdown" style="background-color: {{ theme.cardLight }}">
      <div class="cd-hero-left">
        <text class="cd-hero-num" style="color: {{ theme.accent }}">{{ cdBadge }}</text>
        <text class="cd-hero-unit" if="{{ cdUnit }}" style="color: {{ theme.textSecondary }}">{{ cdUnit }}</text>
      </div>
      <div class="cd-hero-right">
        <text class="cd-hero-title" style="color: {{ theme.text }}">{{ cdTitle }}</text>
        <text class="cd-hero-sub" style="color: {{ theme.textSecondary }}">{{ cdSubText }}</text>
      </div>
      <text class="cd-hero-pin" if="{{ cdPinned }}" style="color: {{ theme.bg }}; background-color: {{ theme.accent }}">钉</text>
    </div>

    <div class="pinned-bar" if="{{ showPinnedBar && hasPinned }}" style="background-color: {{ theme.cardLight }}">
      <div class="left-accent left-accent-4" style="background-color: {{ theme.accent }}"></div>
      <div class="pinned-content">
        <div class="pinned-row">
          <div for="{{ pinnedPages }}" class="pinned-tag" onclick="openPinnedPage($item.uri)" style="background-color: {{ theme.card }}; border-color: {{ theme.borderLight }}">
            <text class="pinned-tag-text" style="color: {{ theme.accent }}">{{ $item.name }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 工具显示模式：图标 / 列表 / 图文（偏好存 homepage_settings.toolViewMode） -->
    <div class="mode-row" style="background-color: {{ theme.card }}">
      <div class="mode-seg" onclick="setToolMode('icon')" style="background-color: {{ toolViewMode === 'icon' ? theme.accent : 'transparent' }}">
        <text class="mode-text" style="color: {{ toolViewMode === 'icon' ? theme.bg : theme.textSecondary }}">图标</text>
      </div>
      <div class="mode-seg" onclick="setToolMode('list')" style="background-color: {{ toolViewMode === 'list' ? theme.accent : 'transparent' }}">
        <text class="mode-text" style="color: {{ toolViewMode === 'list' ? theme.bg : theme.textSecondary }}">列表</text>
      </div>
      <div class="mode-seg" onclick="setToolMode('rich')" style="background-color: {{ toolViewMode === 'rich' ? theme.accent : 'transparent' }}">
        <text class="mode-text" style="color: {{ toolViewMode === 'rich' ? theme.bg : theme.textSecondary }}">图文</text>
      </div>
    </div>

    <scroll class="class-list" scroll-y="true">
      <!-- 模式一：图标（胶囊屏一行 2 列） -->
      <div class="tool-grid" if="{{ toolViewMode === 'icon' }}">
        <div for="{{ tools }}" class="tool-card" onclick="openTool($item)" style="background-color: {{ theme.card }}">
          <image class="tool-icon-img" src="/common/icons/tools/{{ iconTheme }}/{{ $item.iconFile }}"></image>
          <text class="tool-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
      </div>

      <!-- 模式二：列表（扫视最快） -->
      <div class="tool-list" if="{{ toolViewMode === 'list' }}">
        <div for="{{ tools }}" class="tool-row" onclick="openTool($item)" style="background-color: {{ theme.card }}">
          <div class="tool-row-icon-box" style="background-color: {{ theme.cardLight }}">
            <image class="tool-row-icon" src="/common/icons/tools/{{ iconTheme }}/{{ $item.iconFile }}"></image>
          </div>
          <text class="tool-row-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <image class="tool-row-arrow" src="/common/icons/{{ iconTheme }}/icon_chevron_right.png"></image>
        </div>
      </div>

      <!-- 模式三：图文（图标 + 名称 + 实时摘要） -->
      <div class="tool-rich" if="{{ toolViewMode === 'rich' }}">
        <div for="{{ richTools }}" class="rich-card" onclick="openTool($item)" style="background-color: {{ theme.card }}">
          <div class="rich-icon-box" style="background-color: {{ theme.cardLight }}">
            <image class="rich-icon" src="/common/icons/tools/{{ iconTheme }}/{{ $item.iconFile }}"></image>
          </div>
          <div class="rich-info">
            <text class="rich-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
            <text class="rich-sum" if="{{ $item.summary }}" style="color: {{ theme.textSecondary }}">{{ $item.summary }}</text>
          </div>
        </div>
      </div>
    </scroll>

    <!-- 2026-10-26 底部按钮补底色：列表可滚动，滚到末行时卡片会从按钮背后透出来 -->
    <div class="bottom-buttons" style="background-color: {{ theme.bg }}">
      <input class="style-btn" type="button" value="工具" onclick="openTools" style="margin-right: 4px; background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <input class="style-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const device = require("@system.device")
const toolSummaries = require("./modules/tool-summaries.js")

var isCapsuleScreen = false

function pad(n) {
  return n < 10 ? "0" + n : "" + n
}

function formatDateShort(d) {
  return pad(d.getMonth() + 1) + "-" + pad(d.getDate())
}

var indexInstance = null

// 屏型异步返回，拿到后回填并刷新
device.getInfo({
  success: function(data) {
    var shape = data.screenShape || ""
    var capsule = (shape === "capsule" || shape === "pill-shaped")
    isCapsuleScreen = capsule
    if (indexInstance && indexInstance.isCapsule !== capsule) {
      indexInstance.isCapsule = capsule
      try { indexInstance.$forceUpdate() } catch (e) {}
    }
  },
  fail: function() {}
})

var modules = {}
// 时钟 / 钉首页 / 倒数日大数字
var moduleNames = [
  { key: "clock" },
  { key: "pinnedPages", defer: true },
  { key: "countdownHero", defer: true }
]

function loadModule(key, mod) {
  if (mod && mod.init) {
    modules[key] = mod
  } else {
    modules[key] = null
  }
}

loadModule("clock", require("./modules/clock.js"))
loadModule("pinnedPages", require("./modules/pinned-pages.js"))
loadModule("countdownHero", require("./modules/countdown-hero.js"))

// 工具箱入口：图标一律走 PNG 双图（/common/icons/tools/{dark,light}/）
// 名称控制在 ≤3 字，保证胶囊屏「图标模式」2 列卡片（76px 宽）能单行放下
var TOOLS = [
  { id: "countdown", name: "倒数日", iconFile: "tool_countdown.png", uri: "/pages/countdown-manage" },
  { id: "lunar", name: "农历", iconFile: "tool_lunar.png", uri: "/pages/lunar-calendar" },
  { id: "calculator", name: "计算器", iconFile: "tool_calculator.png", uri: "/pages/calculator" },
  { id: "quote", name: "一言", iconFile: "tool_quote.png", uri: "/pages/daily-quote" },
  { id: "answer", name: "答案", iconFile: "tool_answer.png", uri: "/pages/answer-book" },
  { id: "qrcode", name: "二维码", iconFile: "tool_qrcode.png", uri: "/pages/qrcode-generator" },
  { id: "vibrate", name: "震动", iconFile: "tool_vibrate.png", uri: "/pages/vibration-lab" },
  { id: "backup", name: "备份", iconFile: "tool_backup.png", uri: "/pages/backup-restore" },
  { id: "device", name: "设备", iconFile: "tool_device.png", uri: "/pages/device-info" },
  // 退出固定为最后一项：不是跳转，点击直接退出快应用
  { id: "exit", name: "退出", iconFile: "tool_exit.png", exit: true }
]

export default {
  private: {
    isCapsule: false,
    iconTheme: "dark",
    currentTime: "",
    showTime: true,
    showPinnedBar: true,
    showCountdown: true,
    hasCountdown: false,
    cdBadge: "",
    cdUnit: "",
    cdTitle: "",
    cdSubText: "",
    cdPinned: false,
    timeFormat: { hour: true, minute: true, second: false },
    pinnedPages: [],
    hasPinned: false,
    tools: TOOLS,
    richTools: TOOLS,
    toolViewMode: "icon",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    }
  },

  onInit() {
    var self = this
    indexInstance = self
    self.isCapsule = isCapsuleScreen
    self.initialized = false
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.loadHomepageSettings()
    self.initAllModules()
  },

  onShow() {
    var self = this
    self.isCapsule = isCapsuleScreen
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    }, true)
    self.loadHomepageSettings()
    if (self.loadPinnedPages && typeof self.loadPinnedPages === 'function') {
      self.loadPinnedPages()
    }
    if (self.loadCountdownHero && typeof self.loadCountdownHero === 'function') {
      self.loadCountdownHero()
    }
    if (self.loadToolSummaries && typeof self.loadToolSummaries === 'function' && self.toolViewMode === "rich") {
      self.loadToolSummaries()
    }
    try { this.$forceUpdate() } catch (e) {}
  },

  onDestroy() {
    if (this.deferTimer) clearTimeout(this.deferTimer)
    if (this.stopClockTimer && typeof this.stopClockTimer === 'function') this.stopClockTimer()
  },

  loadHomepageSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showTime = settings.showTime !== false
      self.showPinnedBar = settings.showPinnedBar !== false
      self.showCountdown = settings.showCountdown !== false
      // 工具显示模式：缺省即图标模式（旧数据无此字段时自动落到 icon）
      self.toolViewMode = settings.toolViewMode === "list" || settings.toolViewMode === "rich"
        ? settings.toolViewMode
        : "icon"
      if (self.toolViewMode === "rich") self.loadToolSummaries()
      self.timeFormat = settings.timeFormat || { hour: true, minute: true, second: false }
      if (isCapsuleScreen) {
        self.timeFormat.second = false
      }
      if (typeof self.updateClock === 'function') {
        self.updateClock()
      }
      self.initialized = true
      try { self.$forceUpdate() } catch (e) {}
    }, true)
  },

  // 工具显示模式：图标 / 列表 / 图文（偏好持久化到 homepage_settings.toolViewMode）
  setToolMode(mode) {
    if (mode !== "icon" && mode !== "list" && mode !== "rich") return
    if (this.toolViewMode === mode) return
    this.toolViewMode = mode
    try {
      require("@system.vibrator").vibrate({ mode: "short" })
    } catch (e) {}
    store.getHomepageSettings(function(settings) {
      settings.toolViewMode = mode
      store.setHomepageSettings(settings)
    }, true)
    if (mode === "rich") this.loadToolSummaries()
    try { this.$forceUpdate() } catch (e) {}
  },

  // 图文模式的实时摘要（取不到的项摘要为空，UI 不渲染该行）
  loadToolSummaries() {
    var self = this
    toolSummaries.getAll(function(map) {
      var out = []
      for (var i = 0; i < TOOLS.length; i++) {
        var t = TOOLS[i]
        out.push({
          id: t.id,
          name: t.name,
          iconFile: t.iconFile,
          uri: t.uri,
          summary: map[t.id] || ""
        })
      }
      self.richTools = out
    })
  },

  initAllModules() {
    var self = this
    var deferred = []
    for (var i = 0; i < moduleNames.length; i++) {
      var m = moduleNames[i]
      if (m.defer) {
        deferred.push(m.key)
        continue
      }
      self.initOneModule(m.key)
    }
    if (deferred.length > 0) {
      self.deferTimer = setTimeout(function() {
        self.deferTimer = null
        for (var j = 0; j < deferred.length; j++) {
          self.initOneModule(deferred[j])
        }
      }, 50)
    }
  },

  initOneModule(key) {
    var mod = modules[key]
    if (mod && mod.init && !mod.__inited) {
      try {
        mod.__inited = true
        mod.init(this)
      } catch (e) {
        console.error("[index] module " + key + " init failed: " + (e.message || e))
      }
    }
  },

  // 传入整条工具数据：普通项跳转，退出项直接退出快应用
  openTool(item) {
    if (!item) return
    if (item.exit) {
      try {
        require("@system.vibrator").vibrate({ mode: "short" })
      } catch (e) {}
      var utils = require("../../data/utils.js")
      if (!utils.exitApp()) {
        prompt.showToast({ message: "此设备不支持直接退出，请用手势返回表盘" })
      }
      return
    }
    router.push({ uri: item.uri })
  },

  openTools() {
    router.push({ uri: "/pages/tools" })
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  onBackPress() {
    var utils = require("../../data/utils.js")
    return utils.exitApp() === true
  }
}
</script>

<style>
