  height: 44px;
  border-radius: 22px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  line-height: 44px;
}

.week-indicator {
  padding: 12px 8px;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  width: 100%;
}

.week-swap-icon {
  width: 16px;
  height: 16px;
  margin-right: 4px;
}

.week-text {
  flex-shrink: 0;
  font-size: 20px;
  line-height: 28px;
  text-align: center;
}

.left-accent {
  width: 4px;
  border-radius: 2px;
  margin-right: 8px;
}

.left-accent-4 {
  height: 24px;
}

.left-accent-6 {
  height: 28px;
}

.workday-tip-bar {
  flex-direction: row;
  width: 100%;
  align-items: center;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.workday-tip-text {
  font-size: 18px;
  line-height: 26px;
  flex: 1;
}

.workday-info-btn {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  font-size: 16px;
  font-weight: bold;
  line-height: 28px;
  text-align: center;
  flex-shrink: 0;
  margin-left: 6px;
}

.holiday-greeting-card {
  flex-direction: column;
  padding: 14px;
  border-radius: 8px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.holiday-greeting-name {
  font-size: 20px;
  font-weight: bold;
  line-height: 28px;
  margin-bottom: 2px;
}

.holiday-greeting-text {
  font-size: 22px;
  line-height: 30px;
}

@media (shape: circle) {
  .schedule-page {
    padding: 44px 36px 44px 36px;
  }
  /* 圆屏横向空间同样紧张，取 44px 而非规范 48px */
  /* 胶囊屏 header 实际只有 ◀ + 标题 + ▶（总/今/明已移到 nav-toolbar），
     48×2 = 96px，标题仍有 64px（单字 26px 绰绰有余），可提到 48px */
  .nav-btn-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
  }
  .nav-btn-img {
    width: 22px;
    height: 22px;
  }
  .day-nav-circle {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    margin-left: 2px;
  }
  .add-btn-wrapper,
  .style-btn {
    height: 40px;
    border-radius: 20px;
  }
  .add-btn-icon {
    width: 22px;
    height: 22px;
  }
  .add-btn-label {
    font-size: 18px;
  }
  .bottom-buttons {
    margin-bottom: 8px;
  }
  .cd-hero {
    padding: 6px 8px;
    margin-bottom: 4px;
  }
  .cd-hero-left {
    margin-right: 8px;
  }
  .cd-hero-num {
    font-size: 34px;
    line-height: 40px;
  }
  .cd-hero-unit {
    font-size: 18px;
    line-height: 24px;
  }
  .cd-hero-title {
    font-size: 22px;
    line-height: 30px;
  }
  .cd-hero-sub {
    font-size: 18px;
    line-height: 24px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .schedule-page {
    padding: 30px 16px 30px 16px;
  }
  .clock-row {
    padding: 4px 0;
    margin-bottom: 4px;
  }
  .clock-text {
    font-size: 20px;
    line-height: 28px;
  }
  .header {
    padding: 2px 0;
    margin-bottom: 4px;
  }
  /* 胶囊屏 header 横向要放 ◀ 标题 [总] ▶，192px 物理宽下
     3×48px 会把标题挤没，故取 44px 作为物理上限 */
  /* 胶囊屏 header 实际只有 ◀ + 标题 + ▶（总/今/明已移到 nav-toolbar），
     48×2 = 96px，标题仍有 64px（单字 26px 绰绰有余），可提到 48px */
  .nav-btn-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
  }
  .nav-btn-img {
    width: 22px;
    height: 22px;
  }
  .day-title {
    font-size: 26px;
    font-weight: bold;
    text-align: center;
    flex: 1;
    lines: 1;
    min-width: 0;
  }
  /* 胶囊屏下「总 / 今 / 明」已移到 header 下方的 nav-toolbar，不再与标题抢宽度，
     48×3 + 间距 = 150px < 160px 内容区，可提到规范的 48px */
  .day-nav-circle {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-left: 2px;
  }
  .day-nav-text {
    font-size: 20px;
    line-height: 28px;
  }
  .custom-content-text {
    font-size: 20px;
    line-height: 28px;
  }
  .status-bar {
    padding: 8px 8px;
    margin-bottom: 4px;
  }
  /* Capsule status bar: two-line layout for narrow 160px content area */
  .status-capsule-row {
    flex-direction: row;
    width: 100%;
    align-items: center;
    flex: 1;
  }
  .status-capsule-accent {
    width: 3px;
    height: 42px;
    border-radius: 2px;
    margin-right: 8px;
    flex-shrink: 0;
    align-self: center;
  }
  .status-capsule-body {
    flex: 1;
    flex-direction: column;
  }
  .status-capsule-line1 {
    flex-direction: row;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
  }
  .status-capsule-tag {
    font-size: 18px;
    padding: 1px 8px;
    border-radius: 4px;
    line-height: 24px;
    flex-shrink: 0;
  }
  .status-capsule-time {
    font-size: 18px;
    line-height: 24px;
    margin-left: 6px;
    flex-shrink: 0;
  }
  .status-capsule-name {
    font-size: 22px;
    font-weight: bold;
    line-height: 28px;
    lines: 1;
    min-width: 0;
    text-overflow: ellipsis;
  }
  .section-label {
    font-size: 20px;
    line-height: 28px;
    padding: 6px 4px;
  }
  .quick-add-header {
    padding: 8px 12px;
  }
  .quick-add-title {
    font-size: 20px;
  }
  .quick-add-scroll {
    height: 48px;
  }
  .quick-add-tag {
    border-radius: 20px;
    padding: 4px 10px;
  }
  .quick-add-tag-text {
    font-size: 20px;
  }
  .add-btn-wrapper {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 4px;
    justify-content: center;
    align-items: center;
  }
  .add-btn-icon {
    width: 24px;
    height: 24px;
  }
  .add-btn-label {
    display: none;
  }
  .style-btn {
    flex: 1;
    height: 48px;
    border-radius: 24px;
    font-size: 24px;
    line-height: 48px;
  }
  /* 胶囊屏：换行规则 */
  .class-card-body {
    padding: 6px 10px 6px 10px;
    flex-direction: column;
    align-items: flex-start;
  }
  .card-name-row {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 2px;
  }
  .grid-item-name {
    margin-bottom: 0;
    flex-shrink: 1;
    lines: 1;
    min-width: 0;
    text-overflow: ellipsis;
  }
  .grid-item-location-inline {
    margin-left: 4px;
    lines: 1;
    min-width: 0;
    flex-shrink: 0;
  }
  .grid-item-time {
    font-size: 20px;
    margin-bottom: 0;
    lines: 1;
    min-width: 0;
  }
  .grid-item-location {
    font-size: 20px;
    lines: 1;
    min-width: 0;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .week-text {
    font-size: 20px;
  }
  .left-accent-4 {
    height: 24px;
  }
  .left-accent-6 {
    height: 28px;
  }
  /* 倒数日大数字：胶囊屏纵向最紧张，压到 56px 一行 */
  .cd-hero {
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 8px;
  }
  .cd-hero-left {
    margin-right: 8px;
  }
  .cd-hero-num {
    font-size: 32px;
    line-height: 38px;
  }
  .cd-hero-unit {
    font-size: 18px;
    line-height: 24px;
  }
  .cd-hero-title {
    font-size: 22px;
    line-height: 28px;
  }
  .cd-hero-sub {
    font-size: 18px;
    line-height: 24px;
  }
  .cd-hero-pin {
    font-size: 16px;
    line-height: 24px;
    margin-left: 6px;
  }
  /* 胶囊屏隐藏顶部三切换按钮（模式改从「首页设置」切换），净释放约 58px 垂直空间 */
  .mode-row {
    display: none;
  }
  .mode-seg {
    height: 52px;
  }
  .mode-text {
    font-size: 24px;
    line-height: 52px;
  }
  /* 2026-10-26 图标模式的卡片样式见文件末尾「首页工具卡片」段：
     本文件 base 的 .tool-card/.tool-name 定义在 media 块之后，同权重后者胜，
     覆盖必须写在 <style> 最末尾才生效（原始 display:none 之所以有效是因为 base 没这条） */
  .tool-row {
    height: 56px;
    padding: 0 8px;
    margin-bottom: 4px;
  }
  .tool-row-name {
    font-size: 28px;
    line-height: 36px;
  }
  .rich-card {
    height: 72px;
    padding: 0 8px;
    margin-bottom: 6px;
  }
  .rich-name {
    font-size: 26px;
    line-height: 32px;
  }
  .rich-sum {
    font-size: 22px;
    line-height: 28px;
  }
}

@media (shape: rect) {
  .schedule-page {
    padding: 6px 6px 6px 6px;
  }
  .clock-row {
    padding: 3px 0;
    margin-bottom: 3px;
  }
  .clock-text {
    font-size: 20px;
    line-height: 28px;
  }
  .header {
    padding: 3px 0;
    margin-bottom: 3px;
  }
  /* 方屏: 圆圈容器保持48px, 箭头三角缩小到24px与胶囊屏一致 */
  .nav-btn-img {
    width: 24px;
    height: 24px;
  }
  .day-title {
    font-size: 26px;
    font-weight: bold;
    text-align: center;
    flex: 1;
    lines: 1;
    min-width: 0;
  }
  .day-nav-circle {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    margin-left: 2px;
  }
  .day-nav-text {
    font-size: 20px;
    line-height: 28px;
  }
  .custom-content-bar {
    padding: 6px 8px;
    border-radius: 6px;
    margin-bottom: 3px;
  }
  .custom-content-text {
    font-size: 20px;
    line-height: 28px;
  }
  .status-bar {
    padding: 6px 8px;
    border-radius: 6px;
    margin-bottom: 3px;
  }
  .status-tag {
    font-size: 20px;
    padding: 2px 6px;
    margin-right: 6px;
    line-height: 28px;
  }
  .status-middle {
    font-size: 20px;
    line-height: 28px;
  }
  .status-right {
    font-size: 20px;
    line-height: 28px;
  }
  
  .pinned-bar {
    padding: 4px 6px;
    border-radius: 6px;
    margin-bottom: 3px;
  }
  .pinned-tag-text {
    font-size: 20px;
    line-height: 28px;
    lines: 1;
    min-width: 0;
  }
  .pinned-tag {
    padding: 5px 12px;
    border-radius: 16px;
    margin-right: 6px;
    margin-bottom: 3px;
  }
  .section-label {
    font-size: 20px;
    line-height: 28px;
    padding: 5px 4px;
  }
  .quick-add {
    border-radius: 8px;
    margin-bottom: 3px;
  }
  .quick-add-header {
    padding: 7px 10px;
    border-radius: 8px;
  }
  .quick-add-title {
    font-size: 20px;
    line-height: 28px;
  }
  .quick-add-time {
    font-size: 20px;
    margin-right: 5px;
    line-height: 28px;
  }
  .quick-add-arrow-img {
    width: 20px;
    height: 20px;
    margin-left: 4px;
  }
  /* 快捷添加标签按钮提到规范的 48px（容器跟随） */
  .quick-add-scroll {
    height: 48px;
  }
  .quick-add-tag {
    border-radius: 20px;
    padding: 4px 10px;
    margin-right: 6px;
  }
  .quick-add-tag-text {
    font-size: 20px;
    line-height: 28px;
  }
  .quick-add-empty {
    font-size: 20px;
    line-height: 28px;
    padding: 5px 10px;
  }
  .add-btn-wrapper {
    flex: 1;
    height: 42px;
    border-radius: 21px;
    margin-right: 3px;
  }
  .add-btn-icon {
    width: 24px;
    height: 24px;
  }
  .add-btn-label {
    font-size: 20px;
  }
  .style-btn {
    flex: 1;
    height: 42px;
    border-radius: 21px;
    font-size: 20px;
    line-height: 42px;
  }
  .bottom-buttons {
    margin-bottom: 3px;
  }
  .class-grid-item {
    min-height: 54px;
    border-radius: 10px;
    margin-bottom: 8px;
  }
  .class-card-body {
    padding: 10px 12px 10px 12px;
  }
  /* 字号与行高由脚本按屏型计算后内联下发，这里只保留布局相关属性 */
  .grid-item-name {
    margin-bottom: 4px;
    lines: 1;
    min-width: 0;
    text-overflow: ellipsis;
  }
  .class-card-meta {
    flex-direction: row;
    width: 100%;
    align-items: center;
    flex-wrap: wrap;
  }
  .grid-item-time {
    margin-right: 10px;
    lines: 1;
    min-width: 0;
    flex-shrink: 0;
  }
  .grid-item-location {
    lines: 1;
    min-width: 0;
    flex-shrink: 0;
  }
  .empty-card {
    padding: 16px;
  }
  .empty-text {
    font-size: 20px;
    line-height: 28px;
  }
  .week-indicator {
    padding: 8px 6px;
  }
  .week-text {
    font-size: 20px;
    line-height: 28px;
  }
  .left-accent-4 {
    height: 20px;
  }
  .left-accent-6 {
    height: 24px;
  }
  .holiday-greeting-text {
    font-size: 22px;
    line-height: 30px;
  }
}

/* ---------------- 工具显示模式切换行 ---------------- */

.mode-row {
  flex-direction: row;
  width: 100%;
  height: 52px;
  border-radius: 26px;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.mode-seg {
  flex: 1;
  height: 52px;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
}

.mode-text {
  font-size: 24px;
  line-height: 52px;
  text-align: center;
}

/* ---------------- 模式一：图标 ---------------- */

.tool-grid {
  flex-direction: row;
  width: 100%;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 2px 0;
}

.tool-card {
  width: 48%;
  margin-bottom: 8px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  /* 12 + 56 + 8 + 36 + 10 = 122px（一行 2 个，卡片放大） */
  padding: 12px 4px 10px 4px;
}

.tool-icon-img {
  width: 56px;
  height: 56px;
  margin-bottom: 8px;
}

.tool-name {
  font-size: 28px;
  line-height: 36px;
  text-align: center;
  lines: 1;
  min-width: 0;
  text-overflow: ellipsis;
}

/* ---------------- 模式二：列表 ---------------- */

.tool-list {
  flex-direction: column;
}

.tool-row {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 56px;
  border-radius: 10px;
  padding: 0 10px;
  margin-bottom: 6px;
}

.tool-row-icon-box {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.tool-row-icon {
  width: 28px;
  height: 28px;
}

.tool-row-name {
  flex: 1;
  font-size: 28px;
  line-height: 36px;
  margin-left: 8px;
  lines: 1;
  min-width: 0;
  text-overflow: ellipsis;
}

.tool-row-arrow {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

/* ---------------- 模式三：图文 ---------------- */

.tool-rich {
  flex-direction: column;
}

.rich-card {
  flex-direction: row;
  width: 100%;
  align-items: center;
  height: 72px;
  border-radius: 12px;
  padding: 0 10px;
  margin-bottom: 8px;
}

.rich-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.rich-icon {
  width: 36px;
  height: 36px;
}

.rich-info {
  flex: 1;
  flex-direction: column;
  margin-left: 8px;
  min-width: 0;
}

.rich-name {
  font-size: 28px;
  line-height: 34px;
  lines: 1;
  min-width: 0;
  text-overflow: ellipsis;
}

.rich-sum {
  font-size: 24px;
  line-height: 30px;
  lines: 1;
  min-width: 0;
  text-overflow: ellipsis;
  margin-top: 2px;
}

@media (shape: circle) {
  .tool-card {
    width: 48%;
    padding: 14px 6px 12px 6px;
  }

  .tool-icon-img {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
  }

  .tool-name {
    font-size: 30px;
    line-height: 40px;
  }
}

/* ==================================================================
   2026-10-26 首页工具卡片：工具名常显 + 按屏型换版式（ev-twins 双屏）
   ⚠️ 必须放在 <style> 最后：本文件 base 的 .tool-card/.tool-name/.rich-*
      定义在 media 块**之后**，同权重下后者胜 —— 早期把覆盖写进前面的
      @media(shape: rect) 完全不生效（改完截图仍是两列，排查半天）。
   ================================================================== */

/* —— 胶囊屏 192x490：原设计 display:none 把名字全砍，只剩 10 个无标注图标，
      用户反馈「认不出是哪个工具」。内容区 160px(30/16 padding) → 卡片 48%≈77px，
      3 字名 3×24=72px 放得下，名字取 v5 下限 24px，图标 56→40 把高度让出来。 */
@media (shape: capsule), (shape: pill-shaped) {
  /* 高度预算：490 − 上下 30 padding − 底部按钮 56 = 374；10 个工具 2 列 5 行，
     每行 74（3+34+2+26+3 = 68 卡高 + 6 间距）→ 370，刚好不溢出（上一版 86/行
     = 430，溢 56px：首行顶到屏外、末行被底部按钮压住） */
  .tool-card {
    width: 48%;
    padding: 3px 2px 3px 2px;
    margin-bottom: 6px;
    border-radius: 10px;
  }
  .tool-icon-img {
    width: 34px;
    height: 34px;
    margin-bottom: 2px;
  }
  .tool-name {
    font-size: 24px;
    line-height: 28px;
    text-align: center;
    lines: 1;
    min-width: 0;
    text-overflow: ellipsis;
  }
  .rich-name {
    font-size: 26px;
    line-height: 32px;
  }
  .rich-sum {
    font-size: 24px;
    line-height: 28px;
  }
}

/* —— 矩形屏 336x480（手环 10 Pro）：336px 宽两列 48% 时卡片 155px、图标仅 56px，
      右边整片空白。改三列 32%（≈103px），名字 3 字 3×28=84px 仍放得下，
      一屏可见 9 个工具（旧版 6 个）。列表/图文两视图同步放大到 30px。 */
@media (shape: rect) {
  .tool-grid {
    padding: 0;
  }
  .tool-card {
    width: 32%;
    padding: 10px 2px 8px 2px;
    margin-bottom: 8px;
  }
  .tool-icon-img {
    width: 52px;
    height: 52px;
    margin-bottom: 6px;
  }
  .tool-name {
    font-size: 28px;
    line-height: 34px;
  }
  .tool-row {
    height: 64px;
    padding: 0 12px;
  }
  .tool-row-icon-box {
    width: 48px;
    height: 48px;
  }
  .tool-row-icon {
    width: 32px;
    height: 32px;
  }
  .tool-row-name {
    font-size: 30px;
    line-height: 38px;
    margin-left: 10px;
  }
  .rich-card {
    height: 84px;
    padding: 0 12px;
  }
  .rich-icon-box {
    width: 52px;
    height: 52px;
  }
  .rich-icon {
    width: 40px;
    height: 40px;
  }
  .rich-name {
    font-size: 30px;
    line-height: 36px;
  }
  .rich-sum {
    font-size: 24px;
    line-height: 30px;
  }
}

