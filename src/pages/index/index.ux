<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="content" scroll-y="true">
      <!-- ① 状态层：裸文、无底色、不可点。
           钟开 44px 时刻 + 24px 短日期；钟关改为品牌 + 日期两行，首帧绝不空半屏 -->
      <div class="status">
        <div class="status-clock" style="display: {{ showTime ? 'flex' : 'none' }}">
          <text class="clock-main" style="color: {{ theme.accent }}">{{ currentTime }}</text>
          <text class="date-sub" style="color: {{ subColor }}">{{ dateText }}</text>
        </div>
        <div class="status-brand" style="display: {{ showTime ? 'none' : 'flex' }}">
          <text class="brand-main" style="color: {{ theme.accent }}">Ev工具箱</text>
          <text class="date-sub" style="color: {{ subColor }}">{{ dateText }}</text>
        </div>
      </div>

      <!-- ② 内容层：默认推荐 + 用户钉选混排，每款带实时摘要。
           倒数日有数据时同一张卡切 44px 大数字，不另起焦点层，避免同内容出现两次 -->
      <div class="slot" for="{{ slots }}" onclick="openSlot($idx)" style="background-color: {{ theme.card }}">
        <div class="slot-hero" style="display: {{ $item.hero ? 'flex' : 'none' }}">
          <div class="hero-num-row">
            <text class="num-main" style="color: {{ theme.accent }}">{{ $item.badge }}</text>
            <text class="num-unit" style="color: {{ subColor }}">{{ $item.unit }}</text>
          </div>
          <text class="hero-title" style="color: {{ theme.text }}">{{ $item.heroTitle }}</text>
        </div>
        <div class="slot-normal" style="display: {{ $item.hero ? 'none' : 'flex' }}">
          <text class="slot-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <!-- 摘要按 6P 手动拆成两行，每行仍是 lines:1：长句完整可读，绝不出现残句或省略号 -->
          <text class="slot-summary" style="display: {{ $item.line1 ? 'flex' : 'none' }}; color: {{ subColor }}">{{ $item.line1 }}</text>
          <text class="slot-summary" style="display: {{ $item.line2 ? 'flex' : 'none' }}; color: {{ subColor }}">{{ $item.line2 }}</text>
        </div>
      </div>

      <!-- 槽位被全部移除时的空态，不用 toast -->
      <text class="empty-hint" style="display: {{ hasSlots ? 'none' : 'flex' }}; color: {{ subColor }}">去管理首页添加</text>

      <!-- ③ 入口层：只留两个内容相关入口，设置与退出不再与内容同权 -->
      <div class="action action-primary" onclick="openTools" style="background-color: {{ theme.cardLight }}">
        <text class="action-text" style="color: {{ theme.text }}">全部工具</text>
      </div>
      <div class="action" onclick="openManage" style="background-color: {{ theme.card }}">
        <text class="action-text" style="color: {{ theme.text }}">管理首页</text>
      </div>
    </scroll>

    <div class="scroll-hint-wrap" style="display: {{ needScroll ? 'flex' : 'none' }}">
      <text class="scroll-hint" style="color: {{ subColor }}">下滑查看</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const store = require("../../data/store.js")
const utils = require("../../data/utils.js")
var slotStore = require("../../data/homepage-slots.js")
var toolSummaries = require("./modules/tool-summaries.js")

/**
 * EvBox 首页 v3 · 内容承载页
 * 正本：docs/pages/core/index.md v3 ／ docs/pages/core/index-职责重定位分析-20261114.md
 * 规范：总纲 §3.21 ev-six 六位开发准则
 *
 * v2 把首页做成导航页（5 行约 20 字，连 48~60 字预算一半都没到）。
 * v3 = 状态层 + 内容槽位（每款带实时摘要）+ 两个入口，首帧不点也有内容。
 *
 * 硬约束：字号只出现 44/28/24；页面左右 padding 12px、卡片 8px；
 * 无行内箭头 / 分隔符 / 徽标 / text-overflow / showToast / if 指令 / 逗号媒体查询。
 */

var modules = {}
// countdownHero 必须同步 init：defer 50ms 会让 onShow 时 loadCountdownHero 还没定义，
// 倒数日大数字分支永远不触发（v3 首轮实测踩到）。init 只挂函数、不读 storage，无性能代价。
var moduleNames = [
  { key: "clock" },
  { key: "countdownHero" }
]

function loadModule(key, mod) {
  modules[key] = (mod && mod.init) ? mod : null
}

loadModule("clock", require("./modules/clock.js"))
loadModule("countdownHero", require("./modules/countdown-hero.js"))

function dateShort(d) {
  return (d.getMonth() + 1) + "月" + d.getDate() + "日"
}

/** 派生次要文字色：theme.textSecondary 对深底约 4.0:1，低于 WCAG AA，按底色亮度重新派生 */
function resolveSubColor(bg) {
  var hex = (bg || "#1a1a2e").replace("#", "")
  if (hex.length !== 6) return "#a8a8bd"
  var parts = [hex.slice(0, 2), hex.slice(2, 4), hex.slice(4, 6)]
  var lin = []
  for (var i = 0; i < 3; i++) {
    var v = parseInt(parts[i], 16) / 255
    lin.push(v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4))
  }
  var L = 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2]
  return L > 0.45 ? "#3a3a4e" : "#a8a8bd"
}

/**
 * 摘要清洗：ev-six 的点税与宽度预算
 *  - tool-summaries.js 的文案带 " · "（单体 0.5P + 两侧空格 = 1.1P）→ 去掉，不改原文案
 *    （tools 页图文视图复用同一模块，不能动它的输出）；
 *  - 中文长句优先取第一个逗号前的分句；
 *  - 按 P 计费（汉字 1.0 / 拉丁数字 0.55 / 空格 0.3）裁到 6.0P：
 *    卡片内容宽 152px，24px 汉字 6 字 = 144px 才不折行；
 *  - 绝不压字号、绝不加省略号、绝不靠 text-overflow 截断。
 */
function cutByP(text, maxP) {
  var out = ""
  var p = 0
  var i = 0
  for (; i < text.length; i++) {
    var ch = text.charAt(i)
    var c = text.charCodeAt(i)
    var w = 1.0
    if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) w = 0.55
    else if (c === 32) w = 0.3
    if (p + w > maxP) break
    out += ch
    p += w
  }
  return { text: out, rest: text.slice(i) }
}

/** 去点税：tool-summaries 的 " · " 单体 0.5P + 两侧空格 = 1.1P，一律清掉 */
function cleanSummary(text) {
  return String(text || "").split(" · ").join("").split("·").join("")
}

/** 单行摘要：中文长句先取逗号前分句，再按 6P 裁 */
function fitSummary(text) {
  if (!text) return ""
  var s = cleanSummary(text)
  var comma = s.indexOf("，")
  if (comma > 0) s = s.slice(0, comma)
  return cutByP(s, 6.0).text
}

/** 长句摘要（一言）：按 6P 手动折成两行，两行合起来是完整句，不产生残句 */
function wrapSummary(text) {
  if (!text) return ["", ""]
  var a = cutByP(cleanSummary(text), 6.0)
  if (!a.rest) return [a.text, ""]
  var b = cutByP(a.rest, 6.0)
  return [a.text, b.text]
}

/** 把数据层槽位 + 摘要表 + 倒数日 hero 数据合并成模板直接可渲染的视图模型 */
function buildViewSlots(list, summaryMap, heroOn, hero) {
  var out = []
  for (var i = 0; i < list.length; i++) {
    var s = list[i]
    var isHero = !!(heroOn && s.id === "countdown" && hero.badge)
    var raw = (s.summaryKey && summaryMap[s.summaryKey]) ? summaryMap[s.summaryKey] : ""
    // 倒数日的摘要是「标题 · 还有 N 天」，首页更该给值而不是标题：取点号后段
    if (s.summaryKey === "countdown" && raw.indexOf("·") >= 0) {
      var parts = raw.split("·")
      raw = parts[parts.length - 1].trim()
    }
    // 一言是完整句子，允许两行；其余摘要单行
    var lines = s.summaryKey === "quote" ? wrapSummary(raw) : [fitSummary(raw), ""]
    out.push({
      id: s.id,
      name: s.name,
      uri: s.uri,
      line1: lines[0],
      line2: lines[1],
      hero: isHero,
      badge: isHero ? hero.badge : "",
      unit: isHero ? hero.unit : "",
      heroTitle: isHero ? fitSummary(hero.title) : ""
    })
  }
  return out
}

/** 首帧同步占位：storage 摘要未回来前，三张卡也必须有名称可读 */
function placeholderSlots() {
  return buildViewSlots(slotStore.getDefaults().slice(0, 3), {}, false, { badge: "", unit: "", title: "" })
}

export default {
  private: {
    showTime: true,
    showCountdown: true,
    hasCountdown: false,
    currentTime: "",
    dateText: "",
    cdBadge: "",
    cdUnit: "",
    cdTitle: "",
    slots: placeholderSlots(),
    hasSlots: true,
    slotTotal: 3,
    needScroll: false,
    subColor: "#a8a8bd",
    slotData: null,
    summaryMap: null,
    timeFormat: { hour: true, minute: true, second: false },
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    }
  },

  onInit() {
    var self = this
    self.dateText = dateShort(new Date())
    self.applyTheme(false)
    self.loadHomepageSettings()
    self.initAllModules()
    self.loadSlots()
  },

  onShow() {
    var self = this
    self.applyTheme(true)
    self.loadHomepageSettings()
    self.dateText = dateShort(new Date())
    if (self.loadCountdownHero && typeof self.loadCountdownHero === 'function') {
      self.loadCountdownHero()
    }
    self.loadSlots()
    // 槽位配置、摘要、倒数日 hero 三路都是 storage 异步回填：
    // 延迟两次重算，保证最终画面与 needScroll 落定，不做「点了才刷新」
    if (self.hintTimer) clearTimeout(self.hintTimer)
    self.hintTimer = setTimeout(function() {
      self.hintTimer = null
      // 模块同步 init 后这里必然有 loadCountdownHero；再取一次保证 hero 数据落定
      if (self.loadCountdownHero && typeof self.loadCountdownHero === 'function') {
        self.loadCountdownHero()
      }
      self.mergeSlots()
    }, 350)
    if (self.settleTimer) clearTimeout(self.settleTimer)
    self.settleTimer = setTimeout(function() {
      self.settleTimer = null
      self.mergeSlots()
    }, 900)
  },

  onDestroy() {
    if (this.deferTimer) clearTimeout(this.deferTimer)
    if (this.hintTimer) clearTimeout(this.hintTimer)
    if (this.settleTimer) clearTimeout(this.settleTimer)
    if (this.stopClockTimer && typeof this.stopClockTimer === 'function') this.stopClockTimer()
  },

  applyTheme(forceRefresh) {
    var self = this
    store.getTheme(function(t) {
      try {
        self.theme = t
        self.subColor = resolveSubColor(t.bg)
      } catch (e) {
        console.error("[index] applyTheme fallback: " + (e.message || e))
      }
    }, forceRefresh === true)
  },

  loadHomepageSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showTime = settings.showTime !== false
      self.showCountdown = settings.showCountdown !== false
      self.timeFormat = { hour: true, minute: true, second: false }
      if (typeof self.updateClock === 'function') self.updateClock()
      self.mergeSlots()
    }, true)
  },

  /** 两路异步源谁先回来都能重算，避免互相等待导致首帧空白 */
  loadSlots() {
    var self = this
    slotStore.getSlots(function(data) {
      self.slotData = data
      self.mergeSlots()
    })
    toolSummaries.getAll(function(map) {
      self.summaryMap = map
      self.mergeSlots()
    })
  },

  mergeSlots() {
    var list = this.slotData ? this.slotData.slots : slotStore.getDefaults().slice(0, 3)
    var map = this.summaryMap || {}
    var hero = {
      badge: this.cdBadge,
      unit: this.cdUnit,
      title: this.cdTitle
    }
    this.slots = buildViewSlots(list, map, this.showCountdown && this.hasCountdown, hero)
    this.hasSlots = this.slots.length > 0
    this.slotTotal = this.slotData ? this.slotData.total : this.slots.length
    this.updateScrollHint()
    try { this.$forceUpdate() } catch (e) {}
  },

  /** 按实际渲染高度估算，超 442px 就给下滑提示；绝不靠压字号容纳 */
  updateScrollHint() {
    var h = 56 + (this.showTime ? 106 : 84)
    for (var i = 0; i < this.slots.length; i++) {
      var s = this.slots[i]
      if (s.hero) h += 120
      else if (s.line2) h += 132
      else if (s.line1) h += 98
      else h += 64
    }
    h += 148
    this.needScroll = h > 442
  },

  // 防黑屏十诫第 1 条：onInit 链路上的 for 必须包 try-catch
  initAllModules() {
    var self = this
    try {
      var deferred = []
      for (var i = 0; i < moduleNames.length; i++) {
        var m = moduleNames[i]
        if (m.defer) { deferred.push(m.key); continue }
        self.initOneModule(m.key)
      }
      if (deferred.length > 0) {
        self.deferTimer = setTimeout(function() {
          self.deferTimer = null
          for (var j = 0; j < deferred.length; j++) self.initOneModule(deferred[j])
        }, 50)
      }
    } catch (e) {
      console.error("[index] initAllModules fallback: " + (e.message || e))
    }
  },

  initOneModule(key) {
    var mod = modules[key]
    if (mod && mod.init && !mod.__inited) {
      try {
        mod.__inited = true
        mod.init(this)
      } catch (e) {
        console.error("[index] module " + key + " init failed: " + (e.message || e))
      }
    }
  },

  openSlot(idx) {
    var s = this.slots[idx]
    if (s && s.uri) router.push({ uri: s.uri })
  },

  openTools() {
    router.push({ uri: "/pages/tools" })
  },

  openManage() {
    router.push({ uri: "/pages/pinned-pages" })
  },

  onBackPress() {
    return utils.exitApp() === true
  }
}
</script>

<style>
/**
 * EvBox 首页 v3 · ev-six 设计令牌
 * 字号三档：44/60、28/38、24/34（30 档本页无节点）。
 * 宽度硬预算：屏 192 − 页面 padding 12×2 = 168px；卡片再扣 8×2 = 152px。
 * 留白只从高度买；三级底色：裸文（信息）→ card（内容卡/次操作）→ cardLight（P0 主操作）。
 * 刻意不用 @media：快应用不支持逗号分隔的媒体查询列表（防黑屏十诫第 5 条）。
 */

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  /* 固定 40px 胶囊屏圆角安全区 */
  padding: 40px 12px 16px 12px;
}

.content {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

/* ---- ① 状态层 ---- */
.status {
  flex-direction: column;
  width: 100%;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.status-clock,
.status-brand {
  flex-direction: column;
  width: 100%;
}

.brand-main {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

.clock-main {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

.date-sub {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

/* ---- ② 内容槽位：纵向 8px 免费，横向 8px 占位置 ---- */
.slot {
  flex-direction: column;
  width: 100%;
  padding: 8px 8px;
  border-radius: 14px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.slot-hero,
.slot-normal {
  flex-direction: column;
  width: 100%;
}

.hero-num-row {
  flex-direction: row;
  align-items: flex-end;
  width: 100%;
}

.num-main {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  lines: 1;
}

.num-unit {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  margin-left: 6px;
  margin-bottom: 8px;
}

.hero-title {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

.slot-name {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

.slot-summary {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

.empty-hint {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

/* ---- ③ 入口层 ---- */
.action {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 58px;
  padding: 10px 8px;
  border-radius: 14px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.action-primary {
  margin-bottom: 20px;
}

.action-text {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

/* ---- 溢出时的滚动提示（1.5 屏 ≤735px） ---- */
.scroll-hint-wrap {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 34px;
  flex-shrink: 0;
}

.scroll-hint {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  text-align: center;
}
</style>
