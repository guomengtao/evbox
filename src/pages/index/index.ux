<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <scroll class="content" scroll-y="true">
      <!-- ① 状态区：裸文锚点，始终占位、不可点。
           钟开 → 44px 时刻 + 24px 短日期；钟关 → 28px 品牌行，首页不至于空半屏 -->
      <div class="status">
        <div class="status-clock" style="display: {{ showTime ? 'flex' : 'none' }}">
          <text class="clock-main" style="color: {{ theme.accent }}">{{ currentTime }}</text>
          <text class="date-sub" style="color: {{ subColor }}">{{ dateText }}</text>
        </div>
        <div class="status-brand" style="display: {{ showTime ? 'none' : 'flex' }}">
          <text class="brand-main" style="color: {{ theme.accent }}">Ev工具箱</text>
        </div>
      </div>

      <!-- ② 焦点卡：倒数日。card 底色表达可点性，不用箭头、不用「钉」徽标 -->
      <div class="focus" onclick="openCountdown" style="display: {{ showCountdown && hasCountdown ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <div class="focus-num-row">
          <text class="num-main" style="color: {{ theme.accent }}">{{ cdBadge }}</text>
          <text class="num-unit" style="color: {{ subColor }}">{{ cdUnit }}</text>
        </div>
        <text class="focus-title" style="color: {{ theme.text }}">{{ cdTitle }}</text>
      </div>

      <!-- ③ 入口行：亮底 = P0 主操作，card = 次操作。无图标、无箭头、无徽标 -->
      <div class="action action-primary" onclick="openTools" style="background-color: {{ theme.cardLight }}">
        <text class="action-text" style="color: {{ theme.text }}">全部工具</text>
      </div>
      <div class="action" onclick="openPinned" style="background-color: {{ theme.card }}">
        <text class="action-text" style="color: {{ theme.text }}">已钉页面</text>
      </div>
      <div class="action" onclick="openSettings" style="background-color: {{ theme.card }}">
        <text class="action-text" style="color: {{ theme.text }}">设置</text>
      </div>
      <div class="action" onclick="exitBox" style="background-color: {{ theme.card }}">
        <text class="action-text" style="color: {{ theme.text }}">退出</text>
      </div>

      <!-- 内联状态条：固定 34px 高，只换文字不换高度；禁用 toast -->
      <div class="hint-wrap" style="display: {{ exitHint ? 'flex' : 'none' }}">
        <text class="inline-hint" style="color: {{ subColor }}">{{ exitHint }}</text>
      </div>
    </scroll>

    <div class="scroll-hint-wrap" style="display: {{ needScroll ? 'flex' : 'none' }}">
      <text class="scroll-hint" style="color: {{ subColor }}">下滑查看</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const store = require("../../data/store.js")
const utils = require("../../data/utils.js")

/**
 * EvBox 首页 · ev-six 合规实现
 * 正本：docs/pages/core/index.md ／ 总纲 §3.21 ／ 手环页面开工手册 v7
 *
 * 三条硬约束：
 *  1) 字号只出现 44 / 30 / 28 / 24（见 style），24px 是绝对下限；
 *  2) 页面左右 padding 12px、卡片/行 8px，留白只从高度买；
 *  3) 无行内箭头 / 分隔符 / 徽标 / text-overflow / showToast / if 指令。
 */

var modules = {}
var moduleNames = [
  { key: "clock" },
  { key: "pinnedPages", defer: true },
  { key: "countdownHero", defer: true }
]

function loadModule(key, mod) {
  modules[key] = (mod && mod.init) ? mod : null
}

loadModule("clock", require("./modules/clock.js"))
loadModule("pinnedPages", require("./modules/pinned-pages.js"))
loadModule("countdownHero", require("./modules/countdown-hero.js"))

function dateShort(d) {
  return (d.getMonth() + 1) + "月" + d.getDate() + "日"
}

/**
 * 派生次要文字色。theme.textSecondary (#888899) 对深底约 4.0:1，
 * 低于 WCAG AA 的 4.5:1；深底提亮、浅底压深，自动适配全部 THEMES。
 */
function resolveSubColor(bg) {
  var hex = (bg || "#1a1a2e").replace("#", "")
  if (hex.length !== 6) return "#a8a8bd"
  var parts = [hex.slice(0, 2), hex.slice(2, 4), hex.slice(4, 6)]
  var lin = []
  for (var i = 0; i < 3; i++) {
    var v = parseInt(parts[i], 16) / 255
    lin.push(v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4))
  }
  var L = 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2]
  return L > 0.45 ? "#3a3a4e" : "#a8a8bd"
}

export default {
  private: {
    showTime: true,
    showCountdown: true,
    showPinnedBar: true,
    hasCountdown: false,
    hasPinned: false,
    currentTime: "",
    dateText: "",
    cdBadge: "",
    cdUnit: "",
    cdTitle: "",
    cdSubText: "",
    cdPinned: false,
    pinnedPages: [],
    exitHint: "",
    needScroll: false,
    subColor: "#a8a8bd",
    // ev-six：44px 只放得下 HH:MM(2.7P → 158px)。带秒 4.3P → 252px、
    // 完整日期 12.3P，均超 168px 内容宽，故首页不消费 timeFormat 的年月日/秒设置。
    timeFormat: { hour: true, minute: true, second: false },
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    }
  },

  onInit() {
    var self = this
    self.initialized = false
    self.applyTheme(false)
    self.loadHomepageSettings()
    self.initAllModules()
  },

  onShow() {
    var self = this
    self.applyTheme(true)
    self.loadHomepageSettings()
    self.dateText = dateShort(new Date())
    self.exitHint = ""
    if (self.loadCountdownHero && typeof self.loadCountdownHero === 'function') {
      self.loadCountdownHero()
    }
    // 焦点数据由 storage 异步回填，延迟重算一次滚动提示（只影响一行提示文案）
    if (self.hintTimer) clearTimeout(self.hintTimer)
    self.hintTimer = setTimeout(function() {
      self.hintTimer = null
      self.updateScrollHint()
      try { self.$forceUpdate() } catch (e) {}
    }, 200)
  },

  onDestroy() {
    if (this.deferTimer) clearTimeout(this.deferTimer)
    if (this.hintTimer) clearTimeout(this.hintTimer)
    if (this.stopClockTimer && typeof this.stopClockTimer === 'function') this.stopClockTimer()
  },

  applyTheme(forceRefresh) {
    var self = this
    // 防黑屏十诫：异步回调里的异常不能让整页不渲染，保底沿用 private 里的默认主题
    store.getTheme(function(t) {
      try {
        self.theme = t
        self.subColor = resolveSubColor(t.bg)
      } catch (e) {
        console.error("[index] applyTheme fallback: " + (e.message || e))
      }
    }, forceRefresh === true)
  },

  loadHomepageSettings() {
    var self = this
    store.getHomepageSettings(function(settings) {
      self.showTime = settings.showTime !== false
      self.showCountdown = settings.showCountdown !== false
      self.showPinnedBar = settings.showPinnedBar !== false
      // 首页强制短时刻格式，理由见 private.timeFormat 注释。
      // homepage_settings.toolViewMode 首页不再消费，仍由 pages/tools 使用。
      self.timeFormat = { hour: true, minute: true, second: false }
      if (typeof self.updateClock === 'function') self.updateClock()
      self.updateScrollHint()
      self.initialized = true
      try { self.$forceUpdate() } catch (e) {}
    }, true)
  },

  /** 单屏可用 442px；按实际区块高度估算是否需要下滑提示，绝不靠压字号容纳 */
  updateScrollHint() {
    // 56 页 padding + 314 四个操作行(58×4 + 20×3 + 22) + 状态区(钟开 106 / 钟关 50)
    var h = 56 + 314 + (this.showTime ? 106 : 50)
    if (this.showCountdown && this.hasCountdown) h += 128
    this.needScroll = h > 442
  },

  // 防黑屏十诫第 1 条：onInit 链路上的 for 必须包 try-catch，
  // 渲染引擎可能在盒模型算完前执行，崩了会整页黑。
  initAllModules() {
    var self = this
    try {
      var deferred = []
      for (var i = 0; i < moduleNames.length; i++) {
        var m = moduleNames[i]
        if (m.defer) { deferred.push(m.key); continue }
        self.initOneModule(m.key)
      }
      if (deferred.length > 0) {
        self.deferTimer = setTimeout(function() {
          self.deferTimer = null
          for (var j = 0; j < deferred.length; j++) self.initOneModule(deferred[j])
        }, 50)
      }
    } catch (e) {
      console.error("[index] initAllModules fallback: " + (e.message || e))
    }
  },

  initOneModule(key) {
    var mod = modules[key]
    if (mod && mod.init && !mod.__inited) {
      try {
        mod.__inited = true
        mod.init(this)
      } catch (e) {
        console.error("[index] module " + key + " init failed: " + (e.message || e))
      }
    }
  },

  openCountdown() {
    router.push({ uri: "/pages/countdown-manage" })
  },

  openTools() {
    router.push({ uri: "/pages/tools" })
  },

  openPinned() {
    router.push({ uri: "/pages/pinned-pages" })
  },

  openSettings() {
    router.push({ uri: "/pages/settings" })
  },

  /** 退出失败走内联状态条，不用 prompt.showToast（系统浮层会压住页面） */
  exitBox() {
    if (utils.exitApp() === true) return
    this.exitHint = "手势返回"
    try { this.$forceUpdate() } catch (e) {}
  },

  onBackPress() {
    return utils.exitApp() === true
  }
}
</script>

<style>
/**
 * EvBox 首页 · ev-six 设计令牌落地
 * 正本：docs/pages/core/index.md ／ 总纲 §3.21 ／ 手环页面开工手册 v7
 *
 * 字号只有四档：44/60、30/40、28/38、24/34（本页实际只用 44/28/24）。
 * 宽度是硬预算：屏 192 − 页面 padding 12×2 = 168px；卡片再扣 8×2 = 152px。
 * 留白只从高度买：抬 line-height → 纵向 padding → 纵向 margin，横向一律不动。
 * 三级底色：裸文（信息）→ card（次操作）→ cardLight（P0 主操作），不靠符号表达可点性。
 */

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  /* 顶部 40px 留胶囊屏圆角安全区。刻意不用 @media：快应用引擎不支持
     逗号分隔的媒体查询列表（防黑屏十诫第 5 条，会令布局规则全失配）；
     本页只面向 192×490 手环 9 胶囊屏，固定值即唯一正确值。 */
  padding: 40px 12px 16px 12px;
}

.content {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

/* ---- ① 状态区：裸文，无底色，不参与可点性层级 ---- */
.status {
  flex-direction: column;
  width: 100%;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.status-clock {
  flex-direction: column;
  width: 100%;
}

.status-brand {
  flex-direction: row;
  width: 100%;
}

/* 钟关时的锚点：与操作行同字号，靠 accent 色 + 无底色区分层级 */
.brand-main {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

.clock-main {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

.date-sub {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

/* ---- ② 焦点卡：上下 12px 免费，左右 8px 占位置 ---- */
.focus {
  flex-direction: column;
  width: 100%;
  padding: 12px 8px;
  border-radius: 14px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.focus-num-row {
  flex-direction: row;
  align-items: flex-end;
  width: 100%;
}

.num-main {
  font-size: 44px;
  line-height: 60px;
  font-weight: bold;
  lines: 1;
}

.num-unit {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  margin-left: 6px;
  margin-bottom: 8px;
}

.focus-title {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

/* ---- ③ 操作行：min-height 58 = 38 行高 + 上下 10 padding ---- */
.action {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 58px;
  padding: 10px 8px;
  border-radius: 14px;
  /* 留白只从高度买：拉开纵向间距填满一屏，横向 padding 保持 8px 不动 */
  margin-bottom: 20px;
  flex-shrink: 0;
}

/* 主操作只从高度买一点区隔，横向一丝不动 */
.action-primary {
  margin-bottom: 22px;
}

.action-text {
  font-size: 28px;
  line-height: 38px;
  font-weight: bold;
  lines: 1;
  width: 100%;
}

/* ---- 内联状态条：固定 34px，只换文字不换高度 ---- */
.hint-wrap {
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 34px;
  flex-shrink: 0;
}

.inline-hint {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  width: 100%;
}

/* ---- 溢出时的滚动提示（1.5 屏 ≤735px 才需要） ---- */
.scroll-hint-wrap {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 34px;
  flex-shrink: 0;
}

.scroll-hint {
  font-size: 24px;
  line-height: 34px;
  lines: 1;
  text-align: center;
}

</style>
