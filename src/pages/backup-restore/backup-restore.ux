  background-color: rgba(0, 0, 0, 0.35);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-card {
  width: 80%;
  border-radius: 16px;
  padding: 28px 24px;
  flex-direction: column;
  align-items: center;
}

.modal-title {
