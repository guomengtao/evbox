  justify-content: space-between;
}

.backup-row-meta {
  font-size: 28px;
  line-height: 36px;
}

.meta-scroll {
  flex: 1;
  height: 36px;
  margin-right: 8px;
}

.backup-row-actions {
  flex-direction: row;
  width: 100%;
  align-items: center;
