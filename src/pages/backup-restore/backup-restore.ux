  font-weight: bold;
  margin-bottom: 12px;
  text-align: center;
  line-height: 46px;
}

.modal-desc {
  font-size: 28px;
  text-align: center;
  margin-bottom: 20px;
  line-height: 38px;
}

.benefit-list {
  width: 100%;
  flex-direction: column;
