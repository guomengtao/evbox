<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">备份</text>
      <div class="header-placeholder"></div>
    </div>

    <text class="result-text" if="{{ resultMessage }}" style="color: {{ resultSuccess ? theme.accent : theme.deleteText }}">{{ resultMessage }}</text>

    <div class="progress-bar" if="{{ restoreProgress >= 0 }}" style="background-color: {{ theme.cardLight }}">
      <text class="progress-text" style="color: {{ theme.accent }}">进度: {{ restoreProgress }}/{{ restoreTotal }}</text>
      <div class="progress-track" style="background-color: {{ theme.border || theme.borderLight }}">
        <div class="progress-fill" style="width: {{ restoreProgress / restoreTotal * 100 }}%; background-color: {{ theme.accent }}"></div>
      </div>
    </div>

    <text class="empty-msg" if="{{ backupList.length === 0 }}" style="color: {{ theme.textMuted }}">暂无备份</text>

    <div class="backup-row" for="$item in backupList" style="background-color: {{ theme.card }}">
      <scroll scroll-x="true" class="name-scroll">
        <text class="backup-row-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
      </scroll>
      <div class="backup-row-footer">
        <scroll scroll-x="true" class="meta-scroll">
          <text class="backup-row-meta" style="color: {{ theme.textSecondary }}">{{ $item.itemCount }} 项数据</text>
        </scroll>
        <div class="backup-row-actions">
          <input class="row-restore-btn" type="button" value="恢复" onclick="restoreBackup($idx)"
                 style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
          <input class="row-delete-btn" type="button" value="{{ deleteConfirmIndex === $idx ? '确认' : '删除' }}"
                 onclick="handleDeleteBackup($idx)"
                 style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : 'transparent' }}; color: {{ deleteConfirmIndex === $idx ? theme.text : theme.deleteText }}; border-color: {{ theme.deleteText }}" />
        </div>
      </div>
    </div>

    <div class="create-section">
      <input class="bottom-create-btn" type="button" value="+ 新建备份" onclick="doBackup"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <div class="info-section" style="background-color: {{ theme.card }}">
      <text class="info-title" style="color: {{ theme.text }}">备份内容</text>
      <text class="info-text" style="color: {{ theme.textSecondary }}">主题·字号·首页·钉首页·二维码·震动</text>
    </div>

    <div class="overlay-modal" show="{{ showDialog }}" onclick="dismissDialog">
      <div class="modal-card" style="background-color: {{ theme.card }}" onclick="stopBubble">
        <text class="modal-title" style="color: {{ theme.accent }}">解锁高级版</text>
        <text class="modal-desc" style="color: {{ theme.textSecondary }}">数据备份需要高级版，一次性解锁永久使用</text>
        <div class="benefit-list">
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 全部工具</text>
          </scroll>
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 数据备份与恢复</text>
          </scroll>
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 首页自定义</text>
          </scroll>
          <scroll scroll-x="true" class="benefit-scroll">
            <text class="benefit-item" style="color: {{ theme.text }}">✓ 多套主题</text>
          </scroll>
        </div>
        <input class="modal-btn-primary" type="button" value="立即解锁" onclick="goToPremium"
               style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        <input class="modal-btn-secondary" type="button" value="取消" onclick="dismissDialog"
               style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}

var BACKUP_LIST_KEY = "backup_list"
var MAX_BACKUPS = 20

// 工具箱需要备份的数据（不含激活信息，激活状态不随备份迁移）
var DATA_KEYS = [
  "appTheme", "baseFontSize", "userNickname",
  "homepage_settings", "homepage_template", "pinned_pages",
  "qrcode_text", "vibrationStyle", "vibration_presets",
  "background_running_config"
]

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    backupList: [],
    resultMessage: "",
    resultSuccess: false,
    deleteConfirmIndex: -1,
    restoreProgress: -1,
    restoreTotal: 0,
    showDialog: false
  },

  _logStatus() {
    dlog("[BACKUP] ===== ACCOUNT STATUS DEBUG =====")

    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] isPremiumUnlocked: " + unlocked)
      dlog("[BACKUP] status: " + (unlocked ? "高级会员" : "标准版"))
    })

    storage.get({
      key: "premium_unlocked",
      success: function(data) {
        dlog("[BACKUP] premium_unlocked storage: " + (data || "empty"))
      },
      fail: function() {
        dlog("[BACKUP] premium_unlocked storage: NOT FOUND")
      }
    })

    storage.get({
      key: "auth_data",
      success: function(data) {
        if (data) {
          try {
            var auth = JSON.parse(data)
            dlog("[BACKUP] auth_data: isActivated=" + auth.isActivated + " | isPermanent=" + auth.isPermanent + " | expireAt=" + (auth.expireAt || "none"))
          } catch (e) {
            dlog("[BACKUP] auth_data: parse error: " + e.message)
          }
        } else {
          dlog("[BACKUP] auth_data: empty")
        }
      },
      fail: function() {
        dlog("[BACKUP] auth_data: NOT FOUND")
      }
    })
    dlog("[BACKUP] ===== STATUS DEBUG END =====")
  },

  onInit() {
    dlog("[BACKUP] onInit: page created")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this.loadBackupList()
    this._logStatus()
  },

  onReady() {
    dlog("[BACKUP] onReady: all components ready, checking premium...")
    this.checkAndShowOverlay()
  },

  onShow() {
    dlog("[BACKUP] onShow: page shown")
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
    this._logStatus()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  checkAndShowOverlay() {
    dlog("[BACKUP] checkAndShowOverlay: START, calling store.isPremiumUnlocked...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] checkAndShowOverlay: CALLBACK fired, unlocked=" + unlocked)
      if (!unlocked) {
        dlog("[BACKUP] checkAndShowOverlay: setting showDialog=true, was=" + self.showDialog)
        self.showDialog = true
        dlog("[BACKUP] checkAndShowOverlay: showDialog now=" + self.showDialog)
      } else {
        dlog("[BACKUP] checkAndShowOverlay: user IS premium, skip overlay")
      }
    })
    dlog("[BACKUP] checkAndShowOverlay: END (async pending)")
  },

  goToPremium() {
    dlog("[BACKUP] goToPremium: navigating to premium page")
    this.showDialog = false
    router.push({ uri: "/pages/activation" })
  },

  loadBackupList() {
    var self = this
    storage.get({
      key: BACKUP_LIST_KEY,
      success: function(data) {
        try {
          var list = JSON.parse(data)
          if (Array.isArray(list)) {
            self.backupList = list
          } else {
            self.backupList = []
          }
        } catch (e) {
          self.backupList = []
        }
      },
      fail: function() {
        self.backupList = []
      }
    })
  },

  saveBackupList(list) {
    var self = this
    storage.set({
      key: BACKUP_LIST_KEY,
      value: JSON.stringify(list),
      success: function() {
        self.backupList = list
      },
      fail: function() {
        self.backupList = list
      }
    })
  },

  goBack() {
    router.back()
  },

  dismissDialog() {
    this.showDialog = false
  },

  stopBubble() {
  },

  doBackup() {
    dlog("[BACKUP] doBackup: START, user clicked backup, checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] doBackup: CALLBACK, unlocked=" + unlocked + ", showDialog=" + self.showDialog)
      if (unlocked) {
        dlog("[BACKUP] doBackup: premium, performing backup")
        self.performBackup()
      } else {
        dlog("[BACKUP] doBackup: NOT premium, setting showDialog=true")
        self.showDialog = true
        dlog("[BACKUP] doBackup: showDialog now=" + self.showDialog)
      }
    })
  },

  performBackup() {
    var self = this
    var backupData = {}
    var total = DATA_KEYS.length

    function loadKey(index) {
      if (index >= total) {
        saveBackup(backupData)
        return
      }
      var key = DATA_KEYS[index]
      storage.get({
        key: key,
        success: function(data) {
          if (data) {
            backupData[key] = data
          }
          loadKey(index + 1)
        },
        fail: function() {
          loadKey(index + 1)
        }
      })
    }

    function saveBackup(data) {
      var now = new Date()
      var timeStr = now.getFullYear() + "-" +
        (now.getMonth() + 1 < 10 ? "0" : "") + (now.getMonth() + 1) + "-" +
        (now.getDate() < 10 ? "0" : "") + now.getDate() + " " +
        (now.getHours() < 10 ? "0" : "") + now.getHours() + ":" +
        (now.getMinutes() < 10 ? "0" : "") + now.getMinutes()

      // 统计本次备份包含的有效数据项数量
      var itemCount = 0
      for (var k = 0; k < DATA_KEYS.length; k++) {
        var v = data[DATA_KEYS[k]]
        if (v !== undefined && v !== null && v !== "") {
          itemCount++
        }
      }

      var backupEntry = {
        id: now.getTime(),
        name: "备份 " + timeStr,
        time: timeStr,
        itemCount: itemCount,
        data: data
      }

      var list = self.backupList.slice()
      list.unshift(backupEntry)

      if (list.length > MAX_BACKUPS) {
        list = list.slice(0, MAX_BACKUPS)
      }

      self.saveBackupList(list)
      self.resultMessage = "备份成功！(" + timeStr + ")"
      self.resultSuccess = true
    }

    loadKey(0)
  },

  restoreBackup(index) {
    dlog("[BACKUP] restoreBackup: START, index=" + index + ", checking premium...")
    var self = this
    store.isPremiumUnlocked(function(unlocked) {
      dlog("[BACKUP] restoreBackup: CALLBACK, unlocked=" + unlocked + ", showDialog=" + self.showDialog)
      if (unlocked) {
        dlog("[BACKUP] restoreBackup: premium, performing restore")
        self.performRestore(index)
      } else {
        dlog("[BACKUP] restoreBackup: NOT premium, setting showDialog=true")
        self.showDialog = true
        dlog("[BACKUP] restoreBackup: showDialog now=" + self.showDialog)
      }
    })
  },

  performRestore(index) {
    var self = this
    var backup = self.backupList[index]
    if (!backup || !backup.data) {
      self.resultMessage = "备份数据无效"
      self.resultSuccess = false
      return
    }

    var backupData = backup.data
    var keys = Object.keys(backupData)
    var total = keys.length

    if (total === 0) {
      self.resultMessage = "备份数据为空"
      self.resultSuccess = false
      return
    }

    self.restoreProgress = 0
    self.restoreTotal = total

    function saveKey(i) {
      if (i >= total) {
        self.restoreProgress = -1
        self.resultMessage = "已恢复 " + total + " 项"
        self.resultSuccess = true
        // 备份是直接写存储的，先清掉内存缓存再重新加载，否则会读到恢复前的旧数据
        if (store.clearCache) store.clearCache()
        store.getTheme(function() {}, true)
        return
      }
      var key = keys[i]
      storage.set({
        key: key,
        value: backupData[key],
        success: function() {
          self.restoreProgress = i + 1
          saveKey(i + 1)
        },
        fail: function() {
          self.restoreProgress = i + 1
          saveKey(i + 1)
        }
      })
    }

    saveKey(0)
  },

  handleDeleteBackup(index) {
    var self = this
    if (self.deleteConfirmIndex === index) {
      var list = self.backupList.slice()
      list.splice(index, 1)
      self.saveBackupList(list)
      self.deleteConfirmIndex = -1
      self.resultMessage = "备份已删除"
      self.resultSuccess = true
    } else {
      self.deleteConfirmIndex = index
    }
  }
}
</script>

<style>
@import '../../common/header.css';

