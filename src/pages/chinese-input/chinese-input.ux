<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">{{ pageTitle }}</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="input-display" style="background-color: {{ theme.card }}; border-color: {{ theme.accent }}">
      <scroll class="input-scroll" scroll-x="true">
        <div class="input-chars">
          <text if="{{ !inputText && !beforeChars.length && !afterChars.length }}" class="input-placeholder" style="color: {{ theme.textSecondary }}">{{ placeholder }}</text>
          <div for="{{beforeChars}}" @click="moveCursor(beforeChars[$idx])" class="input-char-wrap">
            <text class="input-char" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
          <div class="cursor" style="background-color: {{ theme.text }}"></div>
          <div for="{{afterChars}}" @click="moveCursorAfter(afterChars[$idx])" class="input-char-wrap">
            <text class="input-char" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
          <div class="cursor-end-zone" @click="moveCursorEnd"></div>
        </div>
      </scroll>
    </div>

    <div class="done-row">
      <input class="done-btn" type="button" value="完成" onclick="confirmInput" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <!-- 键盘区：下展面板已移除，不再存在「scroll 套 list」的嵌套滚动冲突，恢复原有 scroll 包裹 -->
    <scroll class="keyboard-scroll" scroll-y="true">
      <input-method
        hide="{{ false }}"
        keyboardtype="QWERTY"
        maxlength="{{ maxlen }}"
        vibratemode="short"
        screentype="{{ screenType }}"
        oncomplete="onCharacter"
        ondelete="onDeleteChar"
      ></input-method>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")

export default {
  private: {
    pageTitle: "输入",
    placeholder: "请输入",
    inputText: "",
    maxlen: "10",
    returnKey: "chinese_input_result",
    showCursor: false,
    cursorPos: 0,
    beforeChars: [],
    afterChars: [],
    screenType: "pill-shaped",
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t) { self.theme = t })
    store.getThemeName(function(name) {
      self.iconTheme = (name === 'light' || name === 'warm') ? 'light' : 'dark'
    })
    device.getInfo({
      success: function(data) {
        var shape = data.screenShape || "circle"
        if (shape === "capsule") {
          shape = "pill-shaped"
        }
        self.screenType = shape
      }
    })
    this.loadParams()
  },

  onReady() {
    // 注意（2026-09-25）：此处曾用 keyboardHidden 延迟一帧展开键盘（当时怀疑单帧负载致崩）。
    // 后经真机 A/B 确认崩溃来自组件差异，组件已换回官方原版，该错峰不再需要；
    // 而且它会让组件 onInit 时 hide=true → 跳过词典初始化 → 表现为"英文能打、中文无候选"。
    // 现改回 hide=false 直接展开，与官方用法一致（G 项验证时即为该形态）。
    this.showCursor = true
  },

  loadParams() {
    var self = this
    var storage = require("@system.storage")
    storage.get({ key: "chinese_input_title", success: function(data) {
      if (data) self.pageTitle = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_placeholder", success: function(data) {
      if (data) self.placeholder = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_value", success: function(data) {
      if (data) self.inputText = data
      self.cursorPos = self.inputText.length
      self.updateCharArrays()
    }, fail: function() {} })
    storage.get({ key: "chinese_input_maxlen", success: function(data) {
      if (data) self.maxlen = data
    }, fail: function() {} })
    storage.get({ key: "chinese_input_return_key", success: function(data) {
      if (data) self.returnKey = data
    }, fail: function() {} })
  },

  onCharacter(e) {
    if (e && e.detail && e.detail.content) {
      var maxLen = parseInt(this.maxlen) || 10
      if (this.inputText.length < maxLen) {
        var pos = this.cursorPos
        this.inputText = this.inputText.slice(0, pos) + e.detail.content + this.inputText.slice(pos)
        this.cursorPos = pos + 1
        this.updateCharArrays()
      }
    }
  },

  onDeleteChar() {
    var pos = this.cursorPos
    if (pos > 0) {
      this.inputText = this.inputText.slice(0, pos - 1) + this.inputText.slice(pos)
      this.cursorPos = pos - 1
      this.updateCharArrays()
    }
  },

  updateCharArrays() {
    var text = this.inputText
    var pos = Math.min(this.cursorPos, text.length)
    this.cursorPos = Math.max(0, pos)
    this.beforeChars = text.slice(0, this.cursorPos).split('')
    this.afterChars = text.slice(this.cursorPos).split('')
  },

  moveCursor(ch) {
    var idx = this.beforeChars.indexOf(ch)
    if (idx >= 0) {
      this.cursorPos = idx
      this.updateCharArrays()
    }
  },

  moveCursorAfter(ch) {
    var idx = this.afterChars.indexOf(ch)
    if (idx >= 0) {
      this.cursorPos = this.cursorPos + 1 + idx
      this.updateCharArrays()
    }
  },

  moveCursorEnd() {
    this.cursorPos = this.inputText.length
    this.updateCharArrays()
  },

  confirmInput() {
    var storage = require("@system.storage")
    var text = this.inputText.trim()
    var key = this.returnKey || "chinese_input_result"
    storage.set({
      key: key,
      value: text,
      success: function() {
        router.back()
      },
      fail: function() {
        router.back()
      }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 30px 0 0 0;
}

.header {
  flex-direction: row;
  align-items: center;
  height: 48px;
  margin-bottom: 8px;
  padding: 0 4px;
}

.back-btn-wrapper {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 26px;
  font-weight: bold;
  text-align: center;
  line-height: 34px;
  lines: 1;
  text-overflow: ellipsis;
}

.header-placeholder {
  width: 0;
  height: 0;
  margin: 0;
}

.input-display {
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  border-radius: 10px;
  border-width: 2px;
  margin: 0 4px 6px 4px;
  min-height: 44px;
  flex-shrink: 0;
}

.input-scroll {
  flex: 1;
  flex-direction: row;
}

.input-chars {
  flex-direction: row;
  align-items: center;
}

.input-placeholder {
  font-size: 24px;
}

.input-char {
  font-size: 26px;
}

.input-char-wrap {
  flex-shrink: 0;
}

.cursor-end-zone {
  width: 12px;
  height: 26px;
  flex-shrink: 0;
}

.keyboard-scroll {
  flex: 1;
  flex-direction: column;
  width: 100%;
}

.cursor {
  width: 2px;
  height: 26px;
  margin: 0 2px;
  flex-shrink: 0;
  animation-name: blink;
  animation-duration: 1200ms;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.done-row {
  flex-direction: row;
  justify-content: center;
  padding: 0 4px;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.done-btn {
  width: 160px;
  height: 38px;
  border-radius: 19px;
  font-size: 22px;
  font-weight: bold;
  line-height: 34px;
  border: none;
}

</style>