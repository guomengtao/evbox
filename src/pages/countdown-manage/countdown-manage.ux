<!--
  倒数日列表页（Ev倒数日 版 · ev-six 重排）

  设计依据 docs/pages/core/countdown.md：
    一行一条，两行文字 —— 28px 标题 + 30px 数字（附 24px 单位）。
    天数用条目自己的分类色（经 adaptColor 提亮/压暗），标题与其余文字走主题色；
    颜色归用户、方向归单位（「天后」= 未来，「天前」= 过去），不写「还有/已经」占宽度。
  规范约束：字号只有 44/30/28/24 四档；禁折行、禁省略号、禁 · 分隔符、禁箭头与文字徽标；
          条件块一律用 display 绑定（if 会重建节点导致列表跳位）。
-->
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">倒数</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="cd-scroll" scroll-y="true">
      <div class="cd-list">
        <div class="cd-row" for="{{ list }}" onclick="openEdit($item.id)" style="background-color: {{ theme.card }}">
          <!-- 左侧分类色条：4px 竖条替代色块图标，不占横向文案预算 -->
          <div class="cd-bar" style="background-color: {{ $item.daysColor }}"></div>
          <div class="cd-body">
            <text class="cd-title" style="color: {{ $item.titleColor }}">{{ $item.titleFit }}</text>
            <div class="cd-num-row">
              <text class="cd-num" style="color: {{ $item.daysColor }}">{{ $item.numText }}</text>
              <text class="cd-unit" style="color: {{ $item.daysColor }}; display: {{ $item.unitText ? 'flex' : 'none' }}">{{ $item.unitText }}</text>
            </div>
            <!-- 进度细条：只对「一次性 + 倒数」的条目出现，重复与正计时没有可参照终点 -->
            <div class="cd-track" style="background-color: {{ theme.borderLight }}; display: {{ $item.showBar ? 'flex' : 'none' }}">
              <div class="cd-fill" style="width: {{ $item.barPx }}px; background-color: {{ $item.daysColor }}"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="cd-empty" style="display: {{ list.length ? 'none' : 'flex' }}">
        <text class="cd-empty-t" style="color: {{ theme.textSecondary }}">还没有倒数日</text>
        <text class="cd-empty-s" style="color: {{ theme.textMuted }}">点下方添加一个</text>
      </div>
    </scroll>

    <div class="bottom-bar">
      <div class="add-btn" onclick="startAdd" style="background-color: {{ theme.accent }}">
        <text class="add-t" style="color: {{ theme.bg }}">添加</text>
      </div>
      <div class="sort-btn" onclick="toggleSort" style="background-color: {{ theme.cardLight }}">
        <text class="sort-t" style="color: {{ theme.text }}">{{ sortRecent ? '按时间' : '按名称' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
var storage = require("@system.storage")
const store = require("../../data/store.js")
const countdown = require("../../data/countdown.js")
const textFit = require("../../common/text-fit.js")

var EDIT_ID_KEY = "cd_edit_id"
var SORT_KEY = "cd_sort_name"

// 标题列宽度：行宽 168 − 色条 4 − 间隙 8 − 右内边距 8 = 148px；28px 汉字 1P = 28px
var TITLE_MAX_P = 5.2
// 进度轨道宽度：148px，留 1px 余量防溢出
var TRACK_W = 147

export default {
  private: {
    iconTheme: "dark",
    isLight: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a'
    },
    list: [],
    sortRecent: true
  },

  onInit() {
    this.applyTheme()
    this.loadSortThenRead()
  },

  onShow() {
    // 从编辑页返回必须重排：新增、改名、改日期、删除都要立刻可见
    this.applyTheme()
    this.loadSortThenRead()
  },

  applyTheme() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.isLight = (themeName === 'light' || themeName === 'warm')
      self.iconTheme = self.isLight ? 'light' : 'dark'
      self.readList()
    })
  },

  loadSortThenRead() {
    var self = this
    storage.get({
      key: SORT_KEY,
      success: function(v) {
        self.sortRecent = (v !== "1")
        self.readList()
      },
      fail: function() {
        self.sortRecent = true
        self.readList()
      }
    })
  },

  readList() {
    var self = this
    countdown.loadList(function(items) {
      var sorted = countdown.sortList(items, self.sortRecent ? "recent" : "name")
      var out = []
      for (var i = 0; i < sorted.length; i++) {
        var d = countdown.decorateItem(sorted[i])
        d.titleFit = textFit.clampP(d.title, TITLE_MAX_P)
        // 停用（首页不显示）仍是列表里的条目，只是不上首页 —— 用次级色降权，不写标签
        d.titleColor = d.enabled ? self.theme.text : self.theme.textSecondary
        d.daysColor = d.enabled ? countdown.adaptColor(d.color, self.isLight) : self.theme.textMuted
        d.showBar = (d.progressPct >= 0)
        d.barPx = d.showBar ? Math.max(6, Math.round(TRACK_W * d.progressPct / 100)) : 0
        out.push(d)
      }
      self.list = out
    })
  },

  toggleSort() {
    var self = this
    this.sortRecent = !this.sortRecent
    storage.set({
      key: SORT_KEY,
      value: this.sortRecent ? "0" : "1",
      success: function() { self.readList() },
      fail: function() { self.readList() }
    })
  },

  startAdd() {
    storage.set({
      key: EDIT_ID_KEY,
      value: "",
      success: function() {
        router.push({ uri: "/pages/countdown-edit" })
      },
      fail: function() {
        router.push({ uri: "/pages/countdown-edit" })
      }
    })
  },

  openEdit(id) {
    storage.set({
      key: EDIT_ID_KEY,
      value: String(id),
      success: function() {
        router.push({ uri: "/pages/countdown-edit" })
      },
      fail: function() {
        router.push({ uri: "/pages/countdown-edit" })
      }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 12px 12px 12px;
}

.back-header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  lines: 1;
}

.header-placeholder {
  width: 48px;
  height: 40px;
  flex-shrink: 0;
}

.cd-scroll {
  flex: 1;
  flex-direction: column;
}

.cd-list {
  flex-direction: column;
  width: 100%;
}

.cd-row {
  flex-direction: row;
  width: 100%;
  border-radius: 12px;
  margin-bottom: 8px;
  padding: 8px 8px 8px 0;
  align-items: stretch;
}

.cd-bar {
  width: 4px;
  border-radius: 2px;
  margin-right: 8px;
  flex-shrink: 0;
}

.cd-body {
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.cd-title {
  font-size: 28px;
  line-height: 36px;
  lines: 1;
  width: 100%;
}

.cd-num-row {
  flex-direction: row;
  align-items: flex-end;
  margin-top: 2px;
}

.cd-num {
  font-size: 30px;
  font-weight: bold;
  line-height: 38px;
  lines: 1;
}

.cd-unit {
  font-size: 24px;
  line-height: 38px;
  margin-left: 4px;
  lines: 1;
}

/* 进度条：4px 细条，只做「走了多远」的定性提示，不抢数字的主角位置 */
.cd-track {
  width: 100%;
  height: 4px;
  border-radius: 2px;
  margin-top: 6px;
  flex-direction: row;
}

.cd-fill {
  height: 4px;
  border-radius: 2px;
}

.cd-empty {
  flex-direction: column;
  width: 100%;
  padding-top: 60px;
  align-items: center;
}

.cd-empty-t {
  font-size: 28px;
  line-height: 36px;
  lines: 1;
}

.cd-empty-s {
  font-size: 24px;
  line-height: 32px;
  margin-top: 8px;
  lines: 1;
}

/* 底部操作行：主按钮 + 排序切换，落在 490 屏最稳定的低风险热区 */
.bottom-bar {
  flex-direction: row;
  width: 100%;
  height: 56px;
  flex-shrink: 0;
  margin-top: 8px;
}

.add-btn {
  flex: 1;
  height: 56px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-right: 8px;
}

.add-t {
  font-size: 28px;
  line-height: 36px;
  lines: 1;
}

.sort-btn {
  width: 76px;
  height: 56px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.sort-t {
  font-size: 24px;
  line-height: 32px;
  lines: 1;
}
</style>
