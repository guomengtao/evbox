<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">倒数日</text>
      <div class="header-placeholder"></div>
    </div>

    <div class="toolbar" if="{{ list.length > 0 }}">
      <text class="toolbar-count" style="color: {{ theme.textSecondary }}">{{ list.length }}个</text>
      <text class="toolbar-sort" onclick="toggleSort" style="color: {{ theme.accent }}">{{ sortRecent ? '最近' : '名称' }}</text>
      <input class="toolbar-clear" type="button" value="{{ clearAllConfirm ? '确认' : '清空' }}" onclick="clearAll"
             style="background-color: {{ clearAllConfirm ? theme.deleteText : theme.deleteBg }}; color: {{ clearAllConfirm ? theme.text : theme.deleteText }}" />
    </div>

    <scroll class="list-scroll" scroll-y="{{true}}">
      <div class="list-grid">
        <div for="{{ list }}" class="countdown-row" onclick="openEdit($idx)" style="background-color: {{ theme.card }}">
          <!-- 置顶态用左侧色条表达（ev-six v5 禁徽标：不再用「已钉」小标签） -->
          <div class="row-accent" if="{{ $item.pinnedHome }}" style="background-color: {{ theme.accent }}"></div>
          <div class="row-left">
            <div class="row-badge" style="background-color: {{ $item.daysLeft >= 0 ? theme.accent : theme.textMuted }}">
              <text class="badge-num" style="color: {{ theme.bg }}">{{ $item.badgeText }}</text>
            </div>
            <div class="row-info">
              <div class="row-title-line">
                <text class="row-name" style="color: {{ theme.text }}">{{ $item.title }}</text>
              </div>
              <div class="row-sub-line">
                <text class="row-date" style="color: {{ theme.textSecondary }}">{{ $item.dateText }}</text>
                <text class="row-repeat" if="{{ $item.repeat !== 'none' }}" style="color: {{ theme.accent }}">{{ $item.repeatText }}</text>
              </div>
              <text class="row-days" if="{{ $item.enabled !== false }}" style="color: {{ $item.daysLeft >= 0 ? theme.accent : theme.deleteText }}">{{ $item.daysText }}</text>
              <text class="row-days" if="{{ $item.enabled === false }}" style="color: {{ theme.textMuted }}">已停用</text>
            </div>
          </div>
        </div>
      </div>
      <text if="{{ list.length === 0 }}" class="empty-text" style="color: {{ theme.textMuted }}">暂无倒数日，点击下方按钮添加</text>
    </scroll>

    <!-- 2026-10-02 按用户反馈：「添加」按钮从标题栏移到列表下方固定区，
         胶囊屏上标题栏太窄，按钮会被截断贴边。
         2026-10-26：固定条补底色，否则列表滚到底时行内容会从按钮背后透出来 -->
    <div class="bottom-bar" style="background-color: {{ theme.bg }}">
      <input class="add-btn" type="button" value="+ 添加倒数日" onclick="startAdd"
             style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
    </div>

    <!-- 编辑器：公历/农历 + 年月日 + 重复规则 -->
    <div class="editor-mask" if="{{ showEditor }}" onclick="closeEditor">
      <div class="editor-card" onclick="stopBubble" style="background-color: {{ theme.card }}">
        <text class="editor-title" style="color: {{ theme.accent }}">{{ editorIsEdit ? '编辑倒数日' : '新建倒数日' }}</text>
        <div class="editor-name-row" onclick="editName" style="background-color: {{ theme.cardLight }}">
          <text class="editor-name" style="color: {{ theme.text }}">{{ editorTitle }}</text>
          <text class="editor-name-hint" style="color: {{ theme.textMuted }}">改名</text>
        </div>

        <!-- 2026-10-26 行内三颗操作按钮下沉到这里：胶囊屏上它们把正文挤成 0 宽，
             且 10Pro 上正文被截断。状态用底色表达，标签固定不跳动 -->
        <div class="editor-acts" if="{{ editorIsEdit }}">
          <input class="ea-chip" type="button" value="置顶" onclick="toggleEditorPin"
                 style="background-color: {{ editorPinned ? theme.accent : theme.btnSecondary }}; color: {{ editorPinned ? theme.bg : theme.btnSecondaryText }}" />
          <input class="ea-chip" type="button" value="启用" onclick="toggleEditorEnable"
                 style="background-color: {{ editorEnabled ? theme.accent : theme.btnSecondary }}; color: {{ editorEnabled ? theme.bg : theme.btnSecondaryText }}" />
          <input class="ea-chip ea-del" type="button" value="{{ deleteConfirm ? '确认删除' : '删除' }}" onclick="deleteFromEditor"
                 style="background-color: {{ deleteConfirm ? theme.deleteText : theme.deleteBg }}; color: {{ deleteConfirm ? theme.text : theme.deleteText }}" />
        </div>

        <div class="seg-row">
          <div class="seg-chip" onclick="setCalendar('solar')"
               style="border-color: {{ editorCalendar === 'solar' ? theme.accent : theme.border }}; background-color: {{ editorCalendar === 'solar' ? theme.cardLight : 'transparent' }}">
            <text class="seg-text" style="color: {{ editorCalendar === 'solar' ? theme.accent : theme.textSecondary }}">公历</text>
          </div>
          <div class="seg-chip" onclick="setCalendar('lunar')"
               style="border-color: {{ editorCalendar === 'lunar' ? theme.accent : theme.border }}; background-color: {{ editorCalendar === 'lunar' ? theme.cardLight : 'transparent' }}">
            <text class="seg-text" style="color: {{ editorCalendar === 'lunar' ? theme.accent : theme.textSecondary }}">农历</text>
          </div>
        </div>

        <scroll class="editor-body" scroll-y="{{true}}">
          <div class="step-row">
            <text class="step-label" style="color: {{ theme.textSecondary }}">年</text>
            <input class="step-btn" type="button" value="−" onclick="stepYear(-1)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
            <text class="step-value" style="color: {{ theme.text }}">{{ editorYear }}</text>
            <input class="step-btn" type="button" value="＋" onclick="stepYear(1)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          </div>

          <div class="step-row">
            <text class="step-label" style="color: {{ theme.textSecondary }}">月</text>
            <input class="step-btn" type="button" value="−" onclick="stepMonth(-1)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
            <text class="step-value" style="color: {{ theme.text }}">{{ monthText }}</text>
            <input class="step-btn" type="button" value="＋" onclick="stepMonth(1)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          </div>

          <div class="step-row">
            <text class="step-label" style="color: {{ theme.textSecondary }}">日</text>
            <input class="step-btn" type="button" value="−" onclick="stepDay(-1)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
            <text class="step-value" style="color: {{ theme.text }}">{{ dayText }}</text>
            <input class="step-btn" type="button" value="＋" onclick="stepDay(1)" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          </div>

          <div class="leap-row" if="{{ showLeapChip }}">
            <div class="seg-chip" onclick="toggleLeap"
                 style="border-color: {{ editorIsLeap ? theme.accent : theme.border }}; background-color: {{ editorIsLeap ? theme.cardLight : 'transparent' }}">
              <text class="seg-text" style="color: {{ editorIsLeap ? theme.accent : theme.textSecondary }}">{{ leapChipLabel }}</text>
            </div>
          </div>

          <div class="preview-box" style="background-color: {{ theme.cardLight }}">
            <text class="preview-main" style="color: {{ theme.accent }}">{{ previewMain }}</text>
            <text class="preview-sub" style="color: {{ theme.textSecondary }}">{{ previewSub }}</text>
          </div>

          <text class="block-label" style="color: {{ theme.textSecondary }}">重复</text>
          <div class="repeat-row">
            <div for="{{ repeatOptions }}" class="repeat-chip" onclick="setRepeat($item.key)"
                 style="border-color: {{ editorRepeat === $item.key ? theme.accent : theme.border }}; background-color: {{ editorRepeat === $item.key ? theme.cardLight : 'transparent' }}">
              <text class="repeat-text" style="color: {{ editorRepeat === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.label }}</text>
            </div>
          </div>
          <text class="editor-tip" style="color: {{ theme.textMuted }}">每年 + 农历 可推算农历生日与节日</text>
        </scroll>

        <div class="editor-btns">
          <input class="btn-cancel" type="button" value="取消" onclick="closeEditor" style="background-color: {{ theme.btnSecondary }}; color: {{ theme.btnSecondaryText }}" />
          <input class="btn-save" type="button" value="保存" onclick="saveEditor" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const countdown = require("../../data/countdown.js")
const lunar = require("../../lib/lunar.js")

var MIN_YEAR = 1900
var MAX_YEAR = 2100

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      keyBg: '#1a1a3e',
      keyBorder: '#2a2a5a',
      btnSecondary: '#333355',
      btnSecondaryText: '#a0a0b0',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    },
    rawList: [],
    list: [],
    sortRecent: true,
    clearAllConfirm: false,
    deleteConfirm: false,
    deleteTimer: null,
    clearTimer: null,

    // 编辑器
    showEditor: false,
    editorIsEdit: false,
    editorId: "",
    editorTitle: "",
    editorCalendar: "solar",
    editorYear: 2026,
    editorMonth: 1,
    editorDay: 1,
    editorIsLeap: false,
    editorRepeat: "none",
    editorCreated: 0,
    editorPinned: false,
    editorEnabled: true,
    monthText: "",
    dayText: "",
    showLeapChip: false,
    leapChipLabel: "闰月",
    previewMain: "",
    previewSub: "",
    repeatOptions: [
      { key: "none", label: "不重复" },
      { key: "weekly", label: "每周" },
      { key: "monthly", label: "每月" },
      { key: "yearly", label: "每年" }
    ]
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadList()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadList()
    this.checkInputResult()
  },

  updateIconSrc(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  // ---------------------------------------------------------------- 列表

  loadList() {
    var self = this
    countdown.loadList(function(items) {
      self.rawList = countdown.sortList(items, self.sortRecent ? "recent" : "name")
      self.list = countdown.decorateList(self.rawList)
    })
  },

  persist(callback) {
    var self = this
    countdown.saveList(this.rawList, function() {
      self.loadList()
      if (callback) callback()
    })
  },

  toggleSort() {
    this.sortRecent = !this.sortRecent
    this.rawList = countdown.sortList(this.rawList, this.sortRecent ? "recent" : "name")
    this.list = countdown.decorateList(this.rawList)
  },

  // 点行 = 直接进编辑（旧版是先进改名输入法，看日期也得先过一遍键盘，2026-10-26 改）
  openEdit(idx) {
    var item = this.rawList[idx]
    if (!item) return
    this.openEditor(item, item.title)
  },

  toggleEditorPin() {
    this.editorPinned = !this.editorPinned
  },

  toggleEditorEnable() {
    this.editorEnabled = !(this.editorEnabled !== false)
  },

  deleteFromEditor() {
    var self = this
    if (this.deleteConfirm) {
      clearTimeout(this.deleteTimer)
      this.deleteConfirm = false
      var idx = -1
      for (var i = 0; i < this.rawList.length; i++) {
        if (this.rawList[i].id === this.editorId) {
          idx = i
          break
        }
      }
      if (idx >= 0) this.rawList = countdown.removeAt(this.rawList, idx)
      this.showEditor = false
      this.persist(function() {
        prompt.showToast({ message: "已删除" })
      })
      return
    }
    this.deleteConfirm = true
    clearTimeout(this.deleteTimer)
    this.deleteTimer = setTimeout(function() {
      self.deleteConfirm = false
    }, 3000)
  },

  clearAll() {
    var self = this
    if (this.clearAllConfirm) {
      this.rawList = []
      clearTimeout(this.clearTimer)
      this.clearAllConfirm = false
      this.persist()
      return
    }
    this.clearAllConfirm = true
    clearTimeout(this.clearTimer)
    this.clearTimer = setTimeout(function() {
      self.clearAllConfirm = false
    }, 3000)
  },

  // ---------------------------------------------------------------- 中文输入法（名称）

  startAdd() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "添加倒数日", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入名称", success: function() {} })
    storage.set({ key: "chinese_input_value", value: "", success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "12", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "countdown_add_title", success: function() {
      router.push({ uri: "/pages/chinese-input" })
    }})
  },

  // 编辑器内改名：index = -1 表示"只改当前编辑器里的标题"
  editName() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "编辑名称", success: function() {} })
    storage.set({ key: "chinese_input_placeholder", value: "输入名称", success: function() {} })
    storage.set({ key: "chinese_input_value", value: this.editorTitle, success: function() {} })
    storage.set({ key: "chinese_input_maxlen", value: "12", success: function() {} })
    storage.set({ key: "chinese_input_return_key", value: "countdown_edit_title", success: function() {
      storage.set({ key: "countdown_edit_index", value: "-1", success: function() {
        router.push({ uri: "/pages/chinese-input" })
      }})
    }})
  },

  checkInputResult() {
    var self = this
    var storage = require("@system.storage")

    storage.get({
      key: "countdown_add_title",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          var title = data.trim()
          storage.delete({ key: "countdown_add_title", fail: function() {} })
          if (title) self.openEditor(null, title)
        }
      },
      fail: function() {}
    })

    storage.get({
      key: "countdown_edit_title",
      success: function(data) {
        if (data !== undefined && data !== null && data !== "") {
          var title = data.trim()
          storage.delete({ key: "countdown_edit_title", fail: function() {} })
          storage.get({
            key: "countdown_edit_index",
            success: function(idxData) {
              storage.delete({ key: "countdown_edit_index", fail: function() {} })
              var idx = parseInt(idxData)
              if (isNaN(idx)) idx = -1
              if (idx >= 0 && idx < self.rawList.length) {
                self.openEditor(self.rawList[idx], title)
              } else if (self.showEditor) {
                self.editorTitle = title
              }
            },
            fail: function() {}
          })
        }
      },
      fail: function() {}
    })
  },

  // ---------------------------------------------------------------- 编辑器

  openEditor(item, title) {
    var now = new Date()
    if (item) {
      this.editorIsEdit = true
      this.editorId = item.id
      this.editorTitle = title || item.title
      this.editorCalendar = item.calendar === "lunar" ? "lunar" : "solar"
      this.editorRepeat = item.repeat || "none"
      this.editorCreated = item.created || 0
      this.editorPinned = item.pinnedHome === true
      this.editorEnabled = item.enabled !== false
      if (this.editorCalendar === "lunar" && item.lunar) {
        this.editorYear = this.currentLunarYear()
        if (item.repeat === "none") {
          // 一次性农历日期：把基准公历日反推成农历年，保持"那一年"的语义
          var b0 = countdown.parseKey(item.date)
          var bl = b0 ? lunar.solarToLunar(b0.year, b0.month, b0.day) : null
          if (bl) this.editorYear = bl.year
        }
        this.editorMonth = item.lunar.month
        this.editorDay = item.lunar.day
        this.editorIsLeap = item.lunar.isLeap === true
      } else {
        var b = countdown.parseKey(item.date)
        this.editorYear = b ? b.year : now.getFullYear()
        this.editorMonth = b ? b.month : now.getMonth() + 1
        this.editorDay = b ? b.day : now.getDate()
        this.editorIsLeap = false
      }
    } else {
      this.editorIsEdit = false
      this.editorId = ""
      this.editorTitle = title || ""
      this.editorCalendar = "solar"
      this.editorYear = now.getFullYear()
      this.editorMonth = now.getMonth() + 1
      this.editorDay = now.getDate()
      this.editorIsLeap = false
      this.editorRepeat = "none"
      this.editorCreated = 0
      this.editorPinned = false
      this.editorEnabled = true
    }
    this.normalizeEditorDate()
    this.deleteConfirm = false
    clearTimeout(this.deleteTimer)
    this.showEditor = true
  },

  currentLunarYear() {
    var now = new Date()
    var l = lunar.solarToLunar(now.getFullYear(), now.getMonth() + 1, now.getDate())
    return l ? l.year : now.getFullYear()
  },

  closeEditor() {
    clearTimeout(this.deleteTimer)
    this.deleteConfirm = false
    this.showEditor = false
  },

  stopBubble() {},

  maxDayOf(year, month, isLeap) {
    if (this.editorCalendar === "lunar") {
      return countdown.lunarMonthMaxDay(year, month, isLeap)
    }
    return lunar.solarMonthDays(year, month)
  },

  normalizeEditorDate() {
    if (this.editorYear < MIN_YEAR) this.editorYear = MIN_YEAR
    if (this.editorYear > MAX_YEAR) this.editorYear = MAX_YEAR
    if (this.editorMonth < 1) this.editorMonth = 12
    if (this.editorMonth > 12) this.editorMonth = 1
    var leap = lunar.leapMonth(this.editorYear)
    if (this.editorCalendar !== "lunar" || leap !== this.editorMonth) this.editorIsLeap = false
    var maxDay = this.maxDayOf(this.editorYear, this.editorMonth, this.editorIsLeap)
    if (this.editorDay < 1) this.editorDay = maxDay
    if (this.editorDay > maxDay) this.editorDay = maxDay
    this.refreshEditorText()
  },

  refreshEditorText() {
    if (this.editorCalendar === "lunar") {
      this.monthText = lunar.monthText(this.editorMonth, this.editorIsLeap)
      this.dayText = lunar.dayText(this.editorDay)
    } else {
      this.monthText = this.editorMonth + "月"
      this.dayText = this.editorDay + "日"
    }
    var leap = lunar.leapMonth(this.editorYear)
    this.showLeapChip = this.editorCalendar === "lunar" && leap === this.editorMonth
    this.leapChipLabel = "闰" + lunar.monthText(this.editorMonth, false)
    this.updatePreview()
  },

  updatePreview() {
    var y = this.editorYear
    var m = this.editorMonth
    var d = this.editorDay
    if (this.editorCalendar === "lunar") {
      var s = lunar.lunarToSolar(y, m, d, this.editorIsLeap)
      var main = "农历" + lunar.formatLunar({ month: m, day: d, isLeap: this.editorIsLeap })
      if (s) {
        var sl = lunar.solarToLunar(s.year, s.month, s.day)
        var fest = lunar.lunarFestival(sl) || lunar.solarFestival(s.month, s.day)
        this.previewMain = main
        this.previewSub = "公历 " + countdown.toKey(s.year, s.month, s.day) + (fest ? " · " + fest : "")
      } else {
        this.previewMain = main
        this.previewSub = "超出可换算范围"
      }
    } else {
      var l = lunar.solarToLunar(y, m, d)
      var fest2 = lunar.solarFestival(m, d) || (l ? lunar.lunarFestival(l) : "")
      this.previewMain = "公历 " + countdown.toKey(y, m, d)
      this.previewSub = (l ? lunar.formatLunarWithPrefix(l) : "") + (fest2 ? " · " + fest2 : "")
    }
  },

  setCalendar(kind) {
    if (kind === this.editorCalendar) return
    var y = this.editorYear
    var m = this.editorMonth
    var d = this.editorDay
    if (kind === "lunar") {
      var l = lunar.solarToLunar(y, m, d)
      if (l) {
        this.editorYear = l.year
        this.editorMonth = l.month
        this.editorDay = l.day
        this.editorIsLeap = l.isLeap
      }
    } else {
      var s = lunar.lunarToSolar(y, m, d, this.editorIsLeap)
      if (s) {
        this.editorYear = s.year
        this.editorMonth = s.month
        this.editorDay = s.day
      }
      this.editorIsLeap = false
    }
    this.editorCalendar = kind
    this.normalizeEditorDate()
  },

  stepYear(delta) {
    var y = this.editorYear + delta
    if (y < MIN_YEAR) y = MIN_YEAR
    if (y > MAX_YEAR) y = MAX_YEAR
    this.editorYear = y
    this.normalizeEditorDate()
  },

  stepMonth(delta) {
    var m = this.editorMonth + delta
    if (m < 1) m = 12
    if (m > 12) m = 1
    this.editorMonth = m
    this.normalizeEditorDate()
  },

  stepDay(delta) {
    var maxDay = this.maxDayOf(this.editorYear, this.editorMonth, this.editorIsLeap)
    var d = this.editorDay + delta
    if (d < 1) d = maxDay
    if (d > maxDay) d = 1
    this.editorDay = d
    this.normalizeEditorDate()
  },

  toggleLeap() {
    this.editorIsLeap = !this.editorIsLeap
    this.normalizeEditorDate()
  },

  setRepeat(key) {
    this.editorRepeat = key
  },

  saveEditor() {
    var title = (this.editorTitle || "").trim()
    if (!title) {
      prompt.showToast({ message: "请先输入名称" })
      return
    }
    var item = countdown.createItem({
      id: this.editorId,
      title: title,
      calendar: this.editorCalendar,
      year: this.editorYear,
      month: this.editorMonth,
      day: this.editorDay,
      isLeap: this.editorIsLeap,
      repeat: this.editorRepeat,
      created: this.editorCreated,
      pinnedHome: this.editorPinned,
      enabled: this.editorEnabled
    })
    if (!item) {
      prompt.showToast({ message: "日期无效，请调整后再保存" })
      return
    }

    var replaced = false
    for (var i = 0; i < this.rawList.length; i++) {
      if (this.rawList[i].id === item.id) {
        this.rawList[i] = item
        replaced = true
        break
      }
    }
    if (!replaced) this.rawList.push(item)

    this.rawList = countdown.sortList(this.rawList, this.sortRecent ? "recent" : "name")
    this.showEditor = false
    this.persist(function() {
      prompt.showToast({ message: replaced ? "已保存" : "已添加" })
    })
  },

  goBack() {
    router.back()
  }
}
</script>

