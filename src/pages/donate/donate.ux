  lines: 1;
}

.thanks-section {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 28px;
  flex-shrink: 0;
  margin-top: 6px;
}

.thanks-icon {
  font-size: 20px;
  line-height: 28px;
  margin-right: 6px;
}

.thanks-text {
  font-size: 20px;
  line-height: 28px;
  lines: 1;
}

@media (shape: capsule), (shape: pill-shaped) {
  .header-title {
    font-size: 24px;
    font-weight: bold;
    line-height: 32px;
    lines: 1;
    text-overflow: ellipsis;
  }

  .header {
    padding: 0 6px;
    margin-bottom: 8px;
  }
  .page-root {
    padding: 40px 0 16px 0;
  }
  .qr-card {
    width: 100%;
    padding: 10px 0;
    border-radius: 0;
    margin-bottom: 10px;
    align-items: center;
  }
  .platform-name {
    font-size: 26px;
    line-height: 34px;
  }
  .qr-wrapper {
    padding: 0;
    border-radius: 0;
    width: 100%;
    align-items: center;
    justify-content: center;
  }
  .scan-hint {
    font-size: 20px;
    line-height: 28px;
  }
  .thanks-section {
    height: 28px;
    margin-top: 6px;
  }
  .thanks-icon {
    font-size: 20px;
    line-height: 28px;
  }
  .thanks-text {
    font-size: 20px;
    line-height: 28px;
  }
}

@media (shape: rect) {
  .header-title {
    font-size: 32px;
    font-weight: bold;
    line-height: 42px;
    lines: 1;
    text-overflow: ellipsis;
  }

  .page-root {
    padding: 6px 12px 20px 12px;
  }
  .qr-card {
    padding: 18px 16px;
    border-radius: 18px;
    margin-bottom: 12px;
  }
  .platform-name {
    font-size: 28px;
    line-height: 38px;
  }
  .qr-wrapper {
    padding: 8px;
    border-radius: 14px;
  }
  .scan-hint {
    font-size: 22px;
    line-height: 30px;
  }
  .thanks-section {
    height: 32px;
    margin-top: 8px;
  }
  .thanks-icon {
    font-size: 22px;
    line-height: 32px;
  }
  .thanks-text {
    font-size: 22px;
    line-height: 32px;
  }
}

@media (shape: circle) {
  .header-title {
    font-size: 34px;
    font-weight: bold;
    line-height: 44px;
    lines: 1;
    text-overflow: ellipsis;
  }

  .page-root {
    padding: 50px 28px 36px 28px;
  }
  .qr-card {
    padding: 12px 10px;
    border-radius: 14px;
    margin-bottom: 8px;
  }
  .platform-name {
    font-size: 24px;
