<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">

    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">打赏支持</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 二维码放大到可用宽度 100% 后，三张卡片总高远超屏幕，需要纵向滚动才能全部看到 -->
    <scroll class="content-area" scroll-y="true">
      <div class="qr-card" for="{{ platforms }}" style="background-color: {{ theme.card }}">
        <text class="platform-name" style="color: {{ $item.color }}">{{ $item.name }}</text>
        <div class="qr-wrapper">
          <qrcode value="{{ $item.url }}"
                  style="width: {{ qrSize }}px; height: {{ qrSize }}px; color: #000000; background-color: #ffffff;"></qrcode>
        </div>
        <text class="scan-hint" style="color: {{ theme.textSecondary }}">请使用 {{ $item.name }} 扫码</text>
      </div>
    </scroll>

    <div class="thanks-section">
      <text class="thanks-icon" style="color: {{ theme.accent }}">♥</text>
      <text class="thanks-text" style="color: {{ theme.textSecondary }}">感谢您的支持</text>
    </div>

  </div>
</template>

<script>
import router from "@system.router"
import device from "@system.device"
const store = require("../../data/store.js")

var WECHAT_URL = "wxp://f2f0i7FYfQ5xBhxQtXDwsQpkyGZLB7UsjrRjsrXn02Qx8NQHjn8WlZEnozT2BURX_JRy"
var ALIPAY_URL = "https://qr.alipay.com/fkx11582syvbdeymczggr3c"
var AFDIAN_URL = "https://ifdian.net/a/peipeijin/plan"

var PLATFORMS = [
  { name: "微信",   color: "#07C160", url: WECHAT_URL },
  { name: "支付宝", color: "#1677FF", url: ALIPAY_URL },
  { name: "爱发电", color: "#FF6B35", url: AFDIAN_URL }
]

var QR_PADDINGS = {
  capsule: { sum: 0, max: 200 },
  rect: { sum: 12 + 16 + 8, max: 280 },
  circle: { sum: 28 + 10 + 5, max: 280 }
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#9a9ab0"
    },
    platforms: PLATFORMS,
    qrSize: 120
  },

  onInit() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.calcQrSize()
  },

  onShow() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    self.calcQrSize()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  computeQrSize(w, shape) {
    var conf
    if (shape === "capsule" || shape === "pill-shaped") {
      conf = QR_PADDINGS.capsule
    } else if (shape === "rect") {
      conf = QR_PADDINGS.rect
    } else if (shape === "circle") {
      conf = QR_PADDINGS.circle
    } else {
      // 未识别屏型：按宽度保守回落，沿用原有分档逻辑
      if (w > 300) return Math.floor(w - 12 * 2 - 16 * 2 - 8 * 2 - 4)
      if (w > 200) return Math.floor(w - 10 * 2 - 14 * 2 - 7 * 2 - 4)
      return Math.floor(w - 8 * 2 - 12 * 2 - 6 * 2 - 4)
    }
    var size = Math.floor(w - conf.sum * 2)
    if (size > conf.max) size = conf.max
    if (size < 80) size = 80
    return size
  },

  calcQrSize() {
    var self = this
    device.getInfo({
      success: function (info) {
        var w = info.screenWidth || 192
        var shape = info.screenShape || ""
        var size = self.computeQrSize(w, shape)
        console.log("[qr] w=" + w + " shape=" + shape + " qrSize=" + size)
        self.qrSize = size
      },
      fail: function () {
        console.log("[qr] getInfo failed")
        self.qrSize = 120
      }
    })
  },

  goBack() {
    router.back()
  }
}
</script>

