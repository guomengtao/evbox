  }
  .thanks-section {
    height: 28px;
    margin-top: 4px;
  }
  .thanks-icon {
    font-size: 20px;
    line-height: 28px;
  }
  .thanks-text {
    font-size: 20px;
    line-height: 28px;
  }
}
</style>