  flex: 1;
  flex-direction: column;
}

.item {
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 12px 10px;
  margin-bottom: 6px;
}

.item-num {
  font-size: 20px;
  font-weight: bold;
  width: 26px;
  text-align: center;
  margin-right: 8px;
  flex-shrink: 0;
}

.item-name {
  font-size: 20px;
  flex: 1;
  line-height: 28px;
}

.item-status {
  font-size: 20px;
  font-weight: bold;
  margin-left: 4px;
  flex-shrink: 0;
}

.reset-btn {
  width: 100%;
  height: 44px;
  border-radius: 22px;
  font-size: 20px;
  text-align: center;
  line-height: 40px;
  margin-top: 6px;
  flex-shrink: 0;
}

@media (shape: circle) {
  .page-root {
    padding: 44px 36px 44px 36px;
  }
  
  
  
  .hint {
    font-size: 22px;
    line-height: 30px;
  }
  .item {
    padding: 16px 14px;
    margin-bottom: 8px;
  }
  .item-num {
    font-size: 26px;
    width: 34px;
    margin-right: 10px;
  }
  .item-name {
    font-size: 26px;
    line-height: 36px;
  }
  .item-status {
    font-size: 28px;
    margin-left: 6px;
  }
  .reset-btn {
    height: 36px;
    font-size: 22px;
    margin-top: 8px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  
  
  

}

@media (shape: rect) {
  .page-root {
    padding: 44px 6px 6px 6px;
  }
  
  
}
</style>