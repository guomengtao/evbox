<template>
  <div class="page-root" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">黑屏检测</text>
      <div class="header-placeholder"></div>
    </div>

    <text class="hint" style="color: {{ theme.textSecondary }}">逐个测试，返回后观察是否黑屏。已测项目会变灰标记。</text>

    <div class="items">
      <div class="item" style="background-color: {{ testedItems['bs-demo1'] ? theme.cardLight : theme.card }}"
           onclick="openDemo('bs-demo1')">
        <text class="item-num" style="color: {{ testedItems['bs-demo1'] ? theme.textMuted : theme.accent }}">1</text>
        <text class="item-name" style="color: {{ testedItems['bs-demo1'] ? theme.textMuted : theme.text }}">min-height:100% 塌缩</text>
        <text class="item-status" style="color: {{ testedItems['bs-demo1'] ? theme.accent : theme.textMuted }}">
          {{ testedItems['bs-demo1'] ? '✓' : '›' }}
        </text>
      </div>

      <div class="item" style="background-color: {{ testedItems['bs-demo2'] ? theme.cardLight : theme.card }}"
           onclick="openDemo('bs-demo2')">
        <text class="item-num" style="color: {{ testedItems['bs-demo2'] ? theme.textMuted : theme.accent }}">2</text>
        <text class="item-name" style="color: {{ testedItems['bs-demo2'] ? theme.textMuted : theme.text }}">@media shape 适配缺失</text>
        <text class="item-status" style="color: {{ testedItems['bs-demo2'] ? theme.accent : theme.textMuted }}">
          {{ testedItems['bs-demo2'] ? '✓' : '›' }}
        </text>
      </div>

      <div class="item" style="background-color: {{ testedItems['bs-demo3'] ? theme.cardLight : theme.card }}"
           onclick="openDemo('bs-demo3')">
        <text class="item-num" style="color: {{ testedItems['bs-demo3'] ? theme.textMuted : theme.accent }}">3</text>
        <text class="item-name" style="color: {{ testedItems['bs-demo3'] ? theme.textMuted : theme.text }}">激活页同款结构</text>
        <text class="item-status" style="color: {{ testedItems['bs-demo3'] ? theme.accent : theme.textMuted }}">
          {{ testedItems['bs-demo3'] ? '✓' : '›' }}
        </text>
      </div>

      <div class="item" style="background-color: {{ testedItems['bs-demo4'] ? theme.cardLight : theme.card }}"
           onclick="openDemo('bs-demo4')">
        <text class="item-num" style="color: {{ testedItems['bs-demo4'] ? theme.textMuted : theme.accent }}">4</text>
        <text class="item-name" style="color: {{ testedItems['bs-demo4'] ? theme.textMuted : theme.text }}">right/bottom 浮层定位</text>
        <text class="item-status" style="color: {{ testedItems['bs-demo4'] ? theme.accent : theme.textMuted }}">
          {{ testedItems['bs-demo4'] ? '✓' : '›' }}
        </text>
      </div>

      <div class="item" style="background-color: {{ testedItems['bs-demo5'] ? theme.cardLight : theme.card }}"
           onclick="openDemo('bs-demo5')">
        <text class="item-num" style="color: {{ testedItems['bs-demo5'] ? theme.textMuted : theme.accent }}">5</text>
        <text class="item-name" style="color: {{ testedItems['bs-demo5'] ? theme.textMuted : theme.text }}">条件渲染 无forceUpdate</text>
        <text class="item-status" style="color: {{ testedItems['bs-demo5'] ? theme.accent : theme.textMuted }}">
          {{ testedItems['bs-demo5'] ? '✓' : '›' }}
        </text>
      </div>
    </div>

    <input class="reset-btn" type="button" value="重置标记" onclick="resetAll"
           style="background-color: {{ theme.borderLight }}; color: {{ theme.textSecondary }}" />
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

export default {
  private: {
    iconTheme: "dark",
    testedItems: {
      'bs-demo1': false,
      'bs-demo2': false,
      'bs-demo3': false,
      'bs-demo4': false,
      'bs-demo5': false
    },
    theme: {
      bg: "#1a1a2e",
      card: "#16213e",
      cardLight: "#0f3460",
      accent: "#7ec8e3",
      text: "#ffffff",
      textSecondary: "#888899",
      textMuted: "#555566",
      border: "#0f3460",
      borderLight: "#2a2a5a"
    }
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) { self.theme = t; self.updateIconSrc(themeName) })
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    router.back()
  },

  openDemo(name) {
    this.testedItems[name] = true
    router.push({ uri: "/pages/" + name })
  },

  resetAll() {
    var self = this
    var reset = {
      'bs-demo1': false,
      'bs-demo2': false,
      'bs-demo3': false,
      'bs-demo4': false,
      'bs-demo5': false
    }
    self.testedItems = reset
  }
}
</script>

