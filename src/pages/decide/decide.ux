<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 一体返回胶囊（2026-11-14）：对齐易微课程表设置页 .hdr/.hdr-pill，
         箭头与标题合成一颗按钮、整块可点，取代三段式「30 方块 + flex:1 标题 + 30 占位」。
         命中面积从 30×30 提到整颗胶囊，手环上更稳、更防震、更好点。 -->
    <div class="hdr">
      <div class="hdr-pill" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color: {{ theme.text }}">{{ pageTitle }}</text>
      </div>
    </div>

    <!-- 主屏：一屏只做抽取这件事 -->
    <div class="view" style="display: {{ view === 'main' ? 'flex' : 'none' }}">
      <div class="deck-head" onclick="openDecks" style="background-color: {{ theme.card }}">
        <text class="deck-name" style="color: {{ theme.text }}">{{ deckTitle }}</text>
      </div>

      <!-- 罗盘：盘面文字固定，只换一根指针，点盘面即抽 -->
      <div class="compass-box" onclick="draw" style="display: {{ compassOn ? 'flex' : 'none' }}">
        <div class="dial" style="width: {{ dialSize }}px; height: {{ dialSize }}px; border-radius: {{ dialRadius }}px; background-color: {{ theme.card }}">
          <!-- 8 个常驻标签槽（方位最多 8 向，实际用几个由 buildDial 决定，空槽文字为空即不显示） -->
          <div class="dial-tick" style="left: {{ dial0Left }}px; top: {{ dial0Top }}px; background-color: {{ dial0Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial0Hit ? theme.bg : theme.text }}">{{ dial0Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial1Left }}px; top: {{ dial1Top }}px; background-color: {{ dial1Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial1Hit ? theme.bg : theme.text }}">{{ dial1Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial2Left }}px; top: {{ dial2Top }}px; background-color: {{ dial2Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial2Hit ? theme.bg : theme.text }}">{{ dial2Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial3Left }}px; top: {{ dial3Top }}px; background-color: {{ dial3Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial3Hit ? theme.bg : theme.text }}">{{ dial3Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial4Left }}px; top: {{ dial4Top }}px; background-color: {{ dial4Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial4Hit ? theme.bg : theme.text }}">{{ dial4Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial5Left }}px; top: {{ dial5Top }}px; background-color: {{ dial5Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial5Hit ? theme.bg : theme.text }}">{{ dial5Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial6Left }}px; top: {{ dial6Top }}px; background-color: {{ dial6Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial6Hit ? theme.bg : theme.text }}">{{ dial6Text }}</text>
          </div>
          <div class="dial-tick" style="left: {{ dial7Left }}px; top: {{ dial7Top }}px; background-color: {{ dial7Hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ dial7Hit ? theme.bg : theme.text }}">{{ dial7Text }}</text>
          </div>
          <!-- 指针帧素材是 240×240，盘面胶囊屏只有 160：width:100% 在真机上不生效，
               图按 240 原尺寸铺开 → 圆心被推右 40px，看起来「指针不在中心、转起来乱晃」。
               这里显式绑定 api 尺寸，圆心与盘心严格重合。 -->
          <image class="needle" src="{{ needleSrc }}" style="left: {{ needleOff }}px; top: {{ needleOff }}px; width: {{ needleSize }}px; height: {{ needleSize }}px"></image>
        </div>
        <div class="compass-result">
          <text class="compass-result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>
      </div>

      <div class="stage" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <div class="spin-box" style="display: {{ hasResult ? 'none' : 'flex' }}">
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ prevText }}</text>
          </div>
          <div class="spin-row" style="background-color: {{ theme.cardLight }}">
            <text class="spin-text" style="color: {{ theme.text }}">{{ midText }}</text>
          </div>
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ nextText }}</text>
          </div>
        </div>
        <!-- 过程 / 多结果共用行层（2026-11-14 动画）：
             抽两个：上下两行各自滚候选，先定格第一行、再定格第二行（错峰开奖）。
             抽三个：卷轴接力，一次只有一行在滚，落定一条钉住并上底色，下一行接棒。
             三个 text **全常驻**：不切 display、不用 if 建节点、
             不用 for 数组（真机 JSC for 数组更新不重绘），内容空/非空表达状态。
             节点从首屏一直活到揭晓，绑定依赖永不重建，绕开隐藏子树懒渲染坑。
             行位按结果数分配：1 个用中行，2 个用上+下行，3 个用满三行，整体居中。 -->
        <div class="line-box">
          <!-- 空行高度归零：原先 4 行恒占 30px，单结果/三结果时多出一条空行，
               真机上表现为抽取区「多占了一行」（2026-11-15 Tom 反馈）。 -->
          <text class="line" style="height: {{ line1 ? '30px' : '0' }}; color: {{ lineHot1 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot1 ? theme.cardLight : 'transparent' }}">{{ line1 }}</text>
          <text class="line" style="height: {{ line2 ? '30px' : '0' }}; color: {{ lineHot2 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot2 ? theme.cardLight : 'transparent' }}">{{ line2 }}</text>
          <text class="line" style="height: {{ line3 ? '30px' : '0' }}; color: {{ lineHot3 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot3 ? theme.cardLight : 'transparent' }}">{{ line3 }}</text>
          <text class="line" style="height: {{ line4 ? '30px' : '0' }}; color: {{ lineHot4 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot4 ? theme.cardLight : 'transparent' }}">{{ line4 }}</text>
        </div>

        <!-- 结果节点常驻：不再用 display 三元切显隐。
             真机 JSC 对 display:none 子树不建立绑定，切回 flex 时取到的仍是初始快照，
             表现为「容器出来了、里面一个大空」（2026-11-14 1.0.67 真机复核失败）。
             改为绝对定位覆盖在滚动窗上，未出结果时内容为空、透明无感。 -->
        <div class="result-box">
          <text class="result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>
      </div>

      <div class="pick-row" onclick="changePick" style="display: {{ pickRowOn ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <text class="pick-text" style="color: {{ theme.text }}">{{ pickText }}</text>
      </div>

      <!-- 状态行从 view 末尾上移到按钮上方：原来落在 y≈438–472 的胶囊屏底缘，
           又用 #888899 低对比灰，真机上几乎看不见（2026-11-14 真机反馈）。 -->
      <!-- 多页结果时 statusText 显示页码，点状态行翻页；单页时是普通状态行 -->
      <text class="status-line" onclick="flipPage" style="display: {{ compassOn ? 'none' : 'flex' }}; color: {{ theme.text }}">{{ statusText }}</text>

      <!-- 抽取中按钮变暗 + 文案变「抽取中」：给出「有反应」的即时反馈，
           并由 phase=spinning 在 2 秒内忽略重复点击（防误触）；2 秒硬兜底必解锁。 -->
      <!-- 罗盘页也保留底部按钮（2026-11-15 Tom：表盘页底部空着，用户不知道能点盘面）。
           按钮与盘面点同一入口 draw，状态文案共用 btnText：抽一个 / 抽取中 / 再抽一次。 -->
      <div class="main-btn" onclick="draw" style="background-color: {{ busy ? theme.cardLight : theme.accent }}">
        <text class="main-btn-text" style="color: {{ busy ? theme.textSecondary : theme.bg }}">{{ btnText }}</text>
      </div>

      <div class="sub-row" onclick="openDecks" style="display: {{ compassOn || pickRowOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">换卡组</text>
      </div>
      <div class="sub-row" onclick="openCustom" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">我的卡组</text>
      </div>
    </div>

    <!-- 卡组列表：先选类，再选组。
         真机 1.0.84/1.0.85 两次复核仍空白（标题出来、内容不动不响）→ 定论是
         display:none 子树：真机 JSC 对隐藏子树不建立绑定，切回 flex 时取的是
         首帧快照，行永远画不出来、也点不到（模拟器宽容，故反复漏检）。
         这里改用本文件已验证的「绝对定位覆盖」：永远在布局里，靠 top 移出屏幕。 -->
    <!-- 浮层从 74px 起：避开头部的返回胶囊，否则真机上「卡组」标题被整块盖掉
         （2026-11-15 Tom 反馈：从「二元」开始丢了标题）。 -->
    <div class="view" style="position: absolute; left: 0; top: {{ view === 'decks' ? '74px' : '540px' }}; width: 100%; height: 408px; flex-direction: column; background-color: {{ theme.bg }}">
      <!-- 固定行槽：真机 JSC 对 for 数组的后续赋值不重绘（§7.8），
           数组列表在真机上会整片空白。改为 13 个常驻行，空槽高 0 自然收起。 -->
      <scroll id="catList" class="list-scroll" scroll-y="true" style="position: absolute; left: 0; width: 100%; height: 408px; top: {{ catIndex < 0 ? '0' : '490px' }}">
        <div class="list-row" onclick="pickCatRow(0)"
             style="background-color: {{ theme.card }}; height: {{ cat0 ? '52px' : '0' }}; margin-bottom: {{ cat0 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat0 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(1)"
             style="background-color: {{ theme.card }}; height: {{ cat1 ? '52px' : '0' }}; margin-bottom: {{ cat1 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat1 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(2)"
             style="background-color: {{ theme.card }}; height: {{ cat2 ? '52px' : '0' }}; margin-bottom: {{ cat2 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat2 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(3)"
             style="background-color: {{ theme.card }}; height: {{ cat3 ? '52px' : '0' }}; margin-bottom: {{ cat3 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat3 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(4)"
             style="background-color: {{ theme.card }}; height: {{ cat4 ? '52px' : '0' }}; margin-bottom: {{ cat4 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat4 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(5)"
             style="background-color: {{ theme.card }}; height: {{ cat5 ? '52px' : '0' }}; margin-bottom: {{ cat5 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat5 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(6)"
             style="background-color: {{ theme.card }}; height: {{ cat6 ? '52px' : '0' }}; margin-bottom: {{ cat6 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat6 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(7)"
             style="background-color: {{ theme.card }}; height: {{ cat7 ? '52px' : '0' }}; margin-bottom: {{ cat7 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat7 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(8)"
             style="background-color: {{ theme.card }}; height: {{ cat8 ? '52px' : '0' }}; margin-bottom: {{ cat8 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat8 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(9)"
             style="background-color: {{ theme.card }}; height: {{ cat9 ? '52px' : '0' }}; margin-bottom: {{ cat9 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat9 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(10)"
             style="background-color: {{ theme.card }}; height: {{ cat10 ? '52px' : '0' }}; margin-bottom: {{ cat10 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat10 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(11)"
             style="background-color: {{ theme.card }}; height: {{ cat11 ? '52px' : '0' }}; margin-bottom: {{ cat11 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat11 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(12)"
             style="background-color: {{ theme.card }}; height: {{ cat12 ? '52px' : '0' }}; margin-bottom: {{ cat12 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat12 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(13)"
             style="background-color: {{ theme.card }}; height: {{ cat13 ? '52px' : '0' }}; margin-bottom: {{ cat13 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat13 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(14)"
             style="background-color: {{ theme.card }}; height: {{ cat14 ? '52px' : '0' }}; margin-bottom: {{ cat14 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat14 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(15)"
             style="background-color: {{ theme.card }}; height: {{ cat15 ? '52px' : '0' }}; margin-bottom: {{ cat15 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat15 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(16)"
             style="background-color: {{ theme.card }}; height: {{ cat16 ? '52px' : '0' }}; margin-bottom: {{ cat16 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat16 }}</text>
        </div>
      </scroll>
      <scroll id="deckList" class="list-scroll" scroll-y="true" style="position: absolute; left: 0; width: 100%; height: 408px; top: {{ catIndex < 0 ? '490px' : '0' }}">
        <div class="list-row" onclick="selectDeckRow(0)"
             style="background-color: {{ theme.card }}; height: {{ deck0 ? '52px' : '0' }}; margin-bottom: {{ deck0 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck0 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(1)"
             style="background-color: {{ theme.card }}; height: {{ deck1 ? '52px' : '0' }}; margin-bottom: {{ deck1 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck1 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(2)"
             style="background-color: {{ theme.card }}; height: {{ deck2 ? '52px' : '0' }}; margin-bottom: {{ deck2 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck2 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(3)"
             style="background-color: {{ theme.card }}; height: {{ deck3 ? '52px' : '0' }}; margin-bottom: {{ deck3 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck3 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(4)"
             style="background-color: {{ theme.card }}; height: {{ deck4 ? '52px' : '0' }}; margin-bottom: {{ deck4 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck4 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(5)"
             style="background-color: {{ theme.card }}; height: {{ deck5 ? '52px' : '0' }}; margin-bottom: {{ deck5 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck5 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(6)"
             style="background-color: {{ theme.card }}; height: {{ deck6 ? '52px' : '0' }}; margin-bottom: {{ deck6 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck6 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(7)"
             style="background-color: {{ theme.card }}; height: {{ deck7 ? '52px' : '0' }}; margin-bottom: {{ deck7 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck7 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(8)"
             style="background-color: {{ theme.card }}; height: {{ deck8 ? '52px' : '0' }}; margin-bottom: {{ deck8 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck8 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(9)"
             style="background-color: {{ theme.card }}; height: {{ deck9 ? '52px' : '0' }}; margin-bottom: {{ deck9 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck9 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(10)"
             style="background-color: {{ theme.card }}; height: {{ deck10 ? '52px' : '0' }}; margin-bottom: {{ deck10 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck10 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(11)"
             style="background-color: {{ theme.card }}; height: {{ deck11 ? '52px' : '0' }}; margin-bottom: {{ deck11 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck11 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(12)"
             style="background-color: {{ theme.card }}; height: {{ deck12 ? '52px' : '0' }}; margin-bottom: {{ deck12 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck12 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(13)"
             style="background-color: {{ theme.card }}; height: {{ deck13 ? '52px' : '0' }}; margin-bottom: {{ deck13 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck13 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(14)"
             style="background-color: {{ theme.card }}; height: {{ deck14 ? '52px' : '0' }}; margin-bottom: {{ deck14 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck14 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(15)"
             style="background-color: {{ theme.card }}; height: {{ deck15 ? '52px' : '0' }}; margin-bottom: {{ deck15 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck15 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(16)"
             style="background-color: {{ theme.card }}; height: {{ deck16 ? '52px' : '0' }}; margin-bottom: {{ deck16 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck16 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(17)"
             style="background-color: {{ theme.card }}; height: {{ deck17 ? '52px' : '0' }}; margin-bottom: {{ deck17 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck17 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(18)"
             style="background-color: {{ theme.card }}; height: {{ deck18 ? '52px' : '0' }}; margin-bottom: {{ deck18 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck18 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(19)"
             style="background-color: {{ theme.card }}; height: {{ deck19 ? '52px' : '0' }}; margin-bottom: {{ deck19 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck19 }}</text>
        </div>
      </scroll>
    </div>

    <!-- 分组结果（P2 A1）：常驻浮层，绝对定位靠 top 移出屏幕，不用 display 三元建子树。
         6 组 × (组名 24px + 4 行成员 28px) 全常驻，空槽高度归零自然收起；
         组名与成员靠纵向排版 + 底色卡片区分，不用冒号／斜杠／分隔点（ev-six §9.4）。 -->
    <div class="overlay" style="position: absolute; left: 0; top: {{ view === 'groups' ? '74px' : '540px' }}; width: 100%; height: 408px; flex-direction: column; background-color: {{ theme.bg }}">
      <text class="grp-title" style="color: {{ theme.text }}">{{ grpTitle }}</text>
      <scroll class="grp-scroll" scroll-y="true">
        <div class="grp-card" style="background-color: {{ theme.card }}; height: {{ grp0Name ? grpCardH : '0' }}">
          <text class="grp-name" style="color: {{ theme.textSecondary }}">{{ grp0Name }}</text>
