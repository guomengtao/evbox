        <text class="combo-tip" style="color: {{ theme.textSecondary }}">{{ comboTip }}</text>
        <div class="combo-field" onclick="replaceSlot(0)" style="background-color: {{ theme.cardLight }}; height: {{ cR0Label ? '72px' : '0' }}">
          <text class="combo-field-label" style="color: {{ theme.textSecondary }}">{{ cR0Label }}</text>
          <text class="combo-field-value" style="color: {{ theme.text }}">{{ cR0Value }}</text>
