<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 一体返回胶囊（2026-11-14）：对齐易微课程表设置页 .hdr/.hdr-pill，
         箭头与标题合成一颗按钮、整块可点，取代三段式「30 方块 + flex:1 标题 + 30 占位」。
         命中面积从 30×30 提到整颗胶囊，手环上更稳、更防震、更好点。 -->
    <div class="hdr">
      <div class="hdr-pill" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color: {{ theme.text }}">{{ pageTitle }}</text>
      </div>
    </div>

    <!-- 主屏：一屏只做抽取这件事 -->
    <div class="view" style="display: {{ view === 'main' ? 'flex' : 'none' }}">
      <div class="deck-head" onclick="openDecks" style="background-color: {{ theme.card }}">
        <text class="deck-name" style="color: {{ theme.text }}">{{ deckTitle }}</text>
      </div>

      <!-- 罗盘：盘面文字固定，只换一根指针，点盘面即抽 -->
      <div class="compass-box" onclick="draw" style="display: {{ compassOn ? 'flex' : 'none' }}">
        <div class="dial" style="width: {{ dialSize }}px; height: {{ dialSize }}px; border-radius: {{ dialRadius }}px; background-color: {{ theme.card }}">
          <div class="dial-tick" for="{{ dialLabels }}"
               style="left: {{ $item.left }}px; top: {{ $item.top }}px; background-color: {{ $item.hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ $item.hit ? theme.bg : theme.text }}">{{ $item.text }}</text>
          </div>
          <image class="needle" src="{{ needleSrc }}"></image>
        </div>
        <div class="compass-result">
          <text class="compass-result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>
      </div>

      <div class="stage" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <div class="spin-box" style="display: {{ hasResult ? 'none' : 'flex' }}">
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ prevText }}</text>
          </div>
          <div class="spin-row" style="background-color: {{ theme.cardLight }}">
            <text class="spin-text" style="color: {{ theme.text }}">{{ midText }}</text>
          </div>
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ nextText }}</text>
          </div>
        </div>
        <!-- 过程 / 多结果共用行层（2026-11-14 动画）：
             抽两个：上下两行各自滚候选，先定格第一行、再定格第二行（错峰开奖）。
             抽三个：卷轴接力，一次只有一行在滚，落定一条钉住并上底色，下一行接棒。
             三个 text **全常驻**：不切 display、不用 if 建节点、
             不用 for 数组（真机 JSC for 数组更新不重绘），内容空/非空表达状态。
             节点从首屏一直活到揭晓，绑定依赖永不重建，绕开隐藏子树懒渲染坑。
             行位按结果数分配：1 个用中行，2 个用上+下行，3 个用满三行，整体居中。 -->
        <div class="line-box">
          <!-- 空行高度归零：原先 4 行恒占 30px，单结果/三结果时多出一条空行，
               真机上表现为抽取区「多占了一行」（2026-11-15 Tom 反馈）。 -->
          <text class="line" style="height: {{ line1 ? '30px' : '0' }}; color: {{ lineHot1 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot1 ? theme.cardLight : 'transparent' }}">{{ line1 }}</text>
          <text class="line" style="height: {{ line2 ? '30px' : '0' }}; color: {{ lineHot2 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot2 ? theme.cardLight : 'transparent' }}">{{ line2 }}</text>
          <text class="line" style="height: {{ line3 ? '30px' : '0' }}; color: {{ lineHot3 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot3 ? theme.cardLight : 'transparent' }}">{{ line3 }}</text>
          <text class="line" style="height: {{ line4 ? '30px' : '0' }}; color: {{ lineHot4 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot4 ? theme.cardLight : 'transparent' }}">{{ line4 }}</text>
        </div>

        <!-- 结果节点常驻：不再用 display 三元切显隐。
             真机 JSC 对 display:none 子树不建立绑定，切回 flex 时取到的仍是初始快照，
             表现为「容器出来了、里面一个大空」（2026-11-14 1.0.67 真机复核失败）。
             改为绝对定位覆盖在滚动窗上，未出结果时内容为空、透明无感。 -->
        <div class="result-box">
          <text class="result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>
      </div>

      <div class="pick-row" onclick="changePick" style="display: {{ pickRowOn ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <text class="pick-text" style="color: {{ theme.text }}">{{ pickText }}</text>
      </div>

      <!-- 状态行从 view 末尾上移到按钮上方：原来落在 y≈438–472 的胶囊屏底缘，
           又用 #888899 低对比灰，真机上几乎看不见（2026-11-14 真机反馈）。 -->
      <text class="status-line" style="display: {{ compassOn ? 'none' : 'flex' }}; color: {{ theme.text }}">{{ statusText }}</text>

      <!-- 抽取中按钮变暗 + 文案变「抽取中」：给出「有反应」的即时反馈，
           并由 phase=spinning 在 2 秒内忽略重复点击（防误触）；2 秒硬兜底必解锁。 -->
      <div class="main-btn" onclick="draw" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ busy ? theme.cardLight : theme.accent }}">
        <text class="main-btn-text" style="color: {{ busy ? theme.textSecondary : theme.bg }}">{{ btnText }}</text>
      </div>

      <div class="sub-row" onclick="openDecks" style="display: {{ compassOn || pickRowOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">换卡组</text>
      </div>
      <div class="sub-row" onclick="openCustom" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">我的卡组</text>
      </div>
    </div>

    <!-- 卡组列表：先选类，再选组。
         真机 1.0.84/1.0.85 两次复核仍空白（标题出来、内容不动不响）→ 定论是
         display:none 子树：真机 JSC 对隐藏子树不建立绑定，切回 flex 时取的是
         首帧快照，行永远画不出来、也点不到（模拟器宽容，故反复漏检）。
         这里改用本文件已验证的「绝对定位覆盖」：永远在布局里，靠 top 移出屏幕。 -->
    <!-- 浮层从 74px 起：避开头部的返回胶囊，否则真机上「卡组」标题被整块盖掉
         （2026-11-15 Tom 反馈：从「二元」开始丢了标题）。 -->
    <div class="view" style="position: absolute; left: 0; top: {{ view === 'decks' ? '74px' : '540px' }}; width: 100%; height: 408px; flex-direction: column; background-color: {{ theme.bg }}">
      <!-- 固定行槽：真机 JSC 对 for 数组的后续赋值不重绘（§7.8），
           数组列表在真机上会整片空白。改为 13 个常驻行，空槽高 0 自然收起。 -->
      <scroll class="list-scroll" scroll-y="true" style="position: absolute; left: 0; width: 100%; height: 408px; top: {{ catIndex < 0 ? '0' : '490px' }}">
        <div class="list-row" onclick="pickCatRow(0)"
             style="background-color: {{ theme.card }}; height: {{ cat0 ? '52px' : '0' }}; margin-bottom: {{ cat0 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat0 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(1)"
             style="background-color: {{ theme.card }}; height: {{ cat1 ? '52px' : '0' }}; margin-bottom: {{ cat1 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat1 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(2)"
             style="background-color: {{ theme.card }}; height: {{ cat2 ? '52px' : '0' }}; margin-bottom: {{ cat2 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat2 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(3)"
