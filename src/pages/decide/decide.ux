          <text class="list-text" style="color: {{ theme.text }}">{{ cat3 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(4)"
             style="background-color: {{ theme.card }}; height: {{ cat4 ? '52px' : '0' }}; margin-bottom: {{ cat4 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat4 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(5)"
             style="background-color: {{ theme.card }}; height: {{ cat5 ? '52px' : '0' }}; margin-bottom: {{ cat5 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ cat5 }}</text>
        </div>
        <div class="list-row" onclick="pickCatRow(6)"
