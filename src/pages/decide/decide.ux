<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <!-- 一体返回胶囊（2026-11-14）：对齐易微课程表设置页 .hdr/.hdr-pill，
         箭头与标题合成一颗按钮、整块可点，取代三段式「30 方块 + flex:1 标题 + 30 占位」。
         命中面积从 30×30 提到整颗胶囊，手环上更稳、更防震、更好点。 -->
    <div class="hdr">
      <div class="hdr-pill" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="hdr-pill-ic" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
        <text class="hdr-pill-t" style="color: {{ theme.text }}">{{ pageTitle }}</text>
      </div>
    </div>

    <!-- 主屏：一屏只做抽取这件事 -->
    <div class="view" style="display: {{ view === 'main' ? 'flex' : 'none' }}">
      <div class="deck-head" onclick="openDecks" style="background-color: {{ theme.card }}">
        <text class="deck-name" style="color: {{ theme.text }}">{{ deckTitle }}</text>
      </div>

      <!-- 罗盘：盘面文字固定，只换一根指针，点盘面即抽 -->
      <div class="compass-box" onclick="draw" style="display: {{ compassOn ? 'flex' : 'none' }}">
        <div class="dial" style="width: {{ dialSize }}px; height: {{ dialSize }}px; border-radius: {{ dialRadius }}px; background-color: {{ theme.card }}">
          <div class="dial-tick" for="{{ dialLabels }}"
               style="left: {{ $item.left }}px; top: {{ $item.top }}px; background-color: {{ $item.hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ $item.hit ? theme.bg : theme.text }}">{{ $item.text }}</text>
          </div>
          <image class="needle" src="{{ needleSrc }}"></image>
        </div>
        <div class="compass-result">
          <text class="compass-result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>
      </div>

      <div class="stage" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <div class="spin-box" style="display: {{ hasResult ? 'none' : 'flex' }}">
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ prevText }}</text>
          </div>
          <div class="spin-row" style="background-color: {{ theme.cardLight }}">
            <text class="spin-text" style="color: {{ theme.text }}">{{ midText }}</text>
          </div>
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ nextText }}</text>
          </div>
        </div>
        <!-- 结果节点常驻：不再用 display 三元切显隐。
             真机 JSC 对 display:none 子树不建立绑定，切回 flex 时取到的仍是初始快照，
             表现为「容器出来了、里面一个大空」（2026-11-14 1.0.67 真机复核失败）。
             改为绝对定位覆盖在滚动窗上，未出结果时内容为空、透明无感。 -->
        <div class="result-box">
          <text class="result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>

        <!-- 过程 / 多结果共用行层（2026-11-14 动画）：
             抽两个：上下两行各自滚候选，先定格第一行、再定格第二行（错峰开奖）。
             抽三个：卷轴接力，一次只有一行在滚，落定一条钉住并上底色，下一行接棒。
             三个 text **全常驻**：不切 display、不用 if 建节点、
             不用 for 数组（真机 JSC for 数组更新不重绘），内容空/非空表达状态。
             节点从首屏一直活到揭晓，绑定依赖永不重建，绕开隐藏子树懒渲染坑。
             行位按结果数分配：1 个用中行，2 个用上+下行，3 个用满三行，整体居中。 -->
        <div class="line-box">
          <text class="line" style="color: {{ lineHot1 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot1 ? theme.cardLight : 'transparent' }}">{{ line1 }}</text>
          <text class="line" style="color: {{ lineHot2 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot2 ? theme.cardLight : 'transparent' }}">{{ line2 }}</text>
          <text class="line" style="color: {{ lineHot3 ? theme.accent : theme.textSecondary }}; background-color: {{ lineHot3 ? theme.cardLight : 'transparent' }}">{{ line3 }}</text>
        </div>
      </div>

      <div class="pick-row" onclick="changePick" style="display: {{ pickRowOn ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <text class="pick-text" style="color: {{ theme.text }}">{{ pickText }}</text>
      </div>

      <!-- 状态行从 view 末尾上移到按钮上方：原来落在 y≈438–472 的胶囊屏底缘，
           又用 #888899 低对比灰，真机上几乎看不见（2026-11-14 真机反馈）。 -->
      <text class="status-line" style="display: {{ compassOn ? 'none' : 'flex' }}; color: {{ theme.text }}">{{ statusText }}</text>

      <!-- 抽取中按钮变暗 + 文案变「抽取中」：给出「有反应」的即时反馈，
           并由 phase=spinning 在 2 秒内忽略重复点击（防误触）；2 秒硬兜底必解锁。 -->
      <div class="main-btn" onclick="draw" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ busy ? theme.cardLight : theme.accent }}">
        <text class="main-btn-text" style="color: {{ busy ? theme.textSecondary : theme.bg }}">{{ btnText }}</text>
      </div>

      <div class="sub-row" onclick="openDecks" style="display: {{ compassOn || pickRowOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">换卡组</text>
      </div>
      <div class="sub-row" onclick="openCustom" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">我的卡组</text>
      </div>
    </div>

    <!-- 卡组列表：先选类，再选组 -->
    <div class="view" style="display: {{ view === 'decks' ? 'flex' : 'none' }}">
      <scroll class="list-scroll" scroll-y="true" style="display: {{ catIndex < 0 ? 'flex' : 'none' }}">
        <div class="list-row" for="{{ catList }}" onclick="pickCat($item.idx)"
             style="background-color: {{ theme.card }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
      </scroll>
      <scroll class="list-scroll" scroll-y="true" style="display: {{ catIndex < 0 ? 'none' : 'flex' }}">
        <div class="list-row" for="{{ deckList }}" onclick="selectDeck($item.deckIndex)"
             style="background-color: {{ theme.card }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ $item.title }}</text>
        </div>
      </scroll>
    </div>

    <!-- 自定义卡组：逐项添加，保存即抽 -->
    <div class="view" style="display: {{ view === 'custom' ? 'flex' : 'none' }}">
      <text class="edit-tip" style="color: {{ theme.textSecondary }}">已加选项</text>
      <scroll class="item-scroll" scroll-y="true">
        <div class="item-row" for="{{ customItems }}" style="background-color: {{ theme.card }}">
          <text class="item-text" style="color: {{ theme.text }}">{{ $item }}</text>
        </div>
      </scroll>

      <div class="main-btn" onclick="addItem" style="background-color: {{ theme.accent }}">
        <text class="main-btn-text" style="color: {{ theme.bg }}">加一项</text>
      </div>
      <div class="main-btn" onclick="saveCustom" style="background-color: {{ theme.cardLight }}">
        <text class="main-btn-text" style="color: {{ theme.text }}">保存并抽</text>
      </div>
      <div class="sub-row" onclick="clearCustom" style="background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">清空重来</text>
      </div>

      <text class="status-line" style="color: {{ theme.textSecondary }}">{{ statusText }}</text>
    </div>

    <!-- 组合抽取：逐槽串行，最后出汇总卡 -->
    <div class="view" style="display: {{ view === 'combo' ? 'flex' : 'none' }}">
      <div class="combo-stage" style="display: {{ hasResult ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="combo-slot-label" style="color: {{ theme.textSecondary }}">{{ slotLabel }}</text>
        <div class="spin-row">
          <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ slotPrevText }}</text>
        </div>
        <div class="spin-row" style="background-color: {{ theme.cardLight }}">
          <text class="spin-text" style="color: {{ theme.text }}">{{ slotMidText }}</text>
        </div>
        <div class="spin-row">
          <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ slotNextText }}</text>
        </div>
      </div>

      <div class="combo-card" style="background-color: {{ theme.card }}">
        <text class="combo-card-title" style="color: {{ theme.text }}">{{ comboTitle }}</text>
        <div class="combo-field" for="{{ comboResults }}" style="background-color: {{ theme.cardLight }}">
          <text class="combo-field-label" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
          <text class="combo-field-value" style="color: {{ theme.text }}">{{ $item.value }}</text>
        </div>
      </div>

      <div class="main-btn" onclick="drawCombo" style="background-color: {{ busy ? theme.cardLight : theme.accent }}">
        <text class="main-btn-text" style="color: {{ busy ? theme.textSecondary : theme.bg }}">{{ btnText }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var preset = require("../../data/decks/preset-decks.json")
var food = require("../../data/decks/preset-food.json")

var CUSTOM_DECK_KEY = "decide_custom_deck"
var DRAFT_KEY = "decide_draft_items"
var ADD_RESULT_KEY = "decide_add_item"
var MAX_ITEMS = 30
var MAX_P = 6
// 三行 24px 结果 102px 不超胶囊屏舞台 126px，四个及以上留 P2 拆页
var MAX_PICK = 3
var FRAMES = 24
var FRAME_STEP = 15
var PICK_LABEL = ["抽一个", "抽两个", "抽三个"]
// 动画定时器句柄放在模块作用域：private 里的值会被框架做响应式包装，
// 对 setTimeout 返回的句柄赋值/读取可能抛异常，导致动画永远停在首帧。
// JSC 实测（2026-11-14）：抽取按钮停在「抽取中」不进 done 即由此引起。
var spinTimer = null
// Vela 模拟器 JSC 实测：动画定时器回调链内调用 @system.vibrator 会让 vapp 退出，
// 真机复核通过后再置 true（方案 §4.2 的咔哒手感属 P3 增强，不阻塞抽取）
var VIBRATE_ENABLED = false
// 旧「逐帧 setTimeout 链」开关，1.0.72 起由 onReady 常驻心跳接管，恒 false。
// 保留 tick / scheduleTick / finishDraw 等实现仅供真机对照，不要重新打开：
// 它们在触摸回调里起链、且揭晓依赖末次回调，真机上会停在「正在抽取」。
var ANIM_ASYNC = false
// Vela JSC 下动画帧必须持续改一个已渲染的顶层文本才会重绘并推进定时器链；
// 用状态行的 loading 省略号承载，最长 5.5P 满足 ev-six 一行 ≤6P
var SPIN_TIPS = ["正在抽取", "正在抽取。", "正在抽取。。", "正在抽取。。。"]
function spinTip(step) {
  return SPIN_TIPS[step % 4]
}

// ===== 抽取过程动画（2026-11-14 / 1.0.72）=====
// 真机 JSC 两条硬约束（docs/pages/core/decide.md §7.8）：
//  ① 一次触摸回调内跨方法写 data，只有最后一个方法的赋值批次进渲染
//     → 起帧帧、揭晓帧都必须是「同一个方法内的连续赋值块」，不调用任何会写 this 的方法；
//  ② 触摸回调里安排的 setTimeout 可能不派发，而 onReady 里安排的链可以
//     → 定时链在 onReady 起常驻心跳，点击只改状态字段，不在回调里起定时器。
// 心跳按「绝对时间」推帧：丢帧能自动追上，不靠帧计数累加到终点。
// 揭晓幂等；点击本身是第二条兜底通道（>= HARD_LOCK_MS 强制揭晓），
// 所以即便整条心跳链死掉，用户也绝不会永久卡在「抽取中」。
var BEAT_MS = 70
// 轮播间隔 = 心跳间隔：每推一帧必然换一个候选（若大于心跳，会出现「整帧没变」的顿感）
var ROLL_MS = 70
var REVEAL_MS = 1600
var HARD_LOCK_MS = 2000
// 三连抽（2026-11-14 第二组动画）：卷轴接力，三条落定的绝对时刻。
// 末条 1300ms 落定、1600ms 正式揭晓，留 300ms 让「三条都已定」被看清，不再干等 460ms。
var LOCK3 = [420, 860, 1300]
// 落定前多少毫秒开始减速：候选切换变慢，视觉上「沉」一下再停，不是硬切
var ROLL_SLOW = 180
var beatTimer = null
var lastBeatAt = 0
var spinStart = 0
var pending = null
var pageAlive = true
var BTN_SPIN = ["抽取中", "抽取中。", "抽取中。。", "抽取中。。。"]

// 结果数 → 行位：1 个用中行、2 个用上+下行、3 个铺满，
// 三行块重心恒在舞台中心，且不依赖任何条件渲染节点。
function rowSlots(count) {
  if (count === 1) { return [1] }
  if (count === 2) { return [0, 2] }
  return [0, 1, 2]
}

// 候选轮播取下标：乘子取质数 7919，与任何少于它的项数互质，
// 保证相邻帧必然换一个候选（乘子若有公因子，n=5 时 step*5%5 恒为 0，行会「假滚」不动）。
function rollIdx(step, k, n) {
  var v = (step * 7919 + k * 13 + 3) % n
  return v < 0 ? v + n : v
}

// 纯函数：算出某一时刻的过程帧，不写 this，可在触摸回调里安全调用。
//
// 抽两个（第一组）：并行双签 —— 上下两行**同时**滚候选，约 533ms 上行定格、
//   1066ms 下行定格，两处同时在动，错峰开奖。
// 抽三个（本组）：卷轴接力 —— **一次只有一行在滚**，落定一条就钉住切高亮，
//   下一行接棒起滚；三条依次 380 / 760 / 1140ms 落定，落定前 180ms 减速。
//   与双签的差别正是「过程里视线只被拉一处」，三行逐条填满，读起来像名单揭晓。
// 抽一个：单签，中行一直滚到 800ms 定格。
function frameAt(el, count, lines, items) {
  var step = Math.floor(el / ROLL_MS)
  var n = items.length
  var l = ["", "", ""]
  var h = [false, false, false]

  if (count >= 3) {
    for (var k = 0; k < 3; k++) {
      var lockAt = LOCK3[k]
      var startAt = k === 0 ? 0 : LOCK3[k - 1]
      if (el >= lockAt) {
        h[k] = true
        l[k] = lines[k] || ""
      } else if (el >= startAt) {
        // 减速停：进入落定前 180ms，候选索引推进变慢（心跳帧率不变，切换频率变慢）
        var s = (lockAt - el < ROLL_SLOW) ? Math.floor(step / 3) : step
        h[k] = false
        l[k] = items[rollIdx(s, k, n)]
      }
      // 还没轮到该行：留空，不显示任何候选（这就是「接力」的可见证据）
    }
    return { l1: l[0], l2: l[1], l3: l[2], h1: h[0], h2: h[1], h3: h[2], step: step }
  }

  var slots = rowSlots(count)
  for (var j = 0; j < slots.length; j++) {
    var r = slots[j]
    var at = Math.floor(REVEAL_MS * (j + 1) / (count + 1))
    h[r] = el >= at
    l[r] = h[r] ? lines[j] : items[rollIdx(step, j, n)]
  }
  return { l1: l[0], l2: l[1], l3: l[2], h1: h[0], h2: h[1], h3: h[2], step: step }
}

function needlePath(frame) {
  var f = frame % FRAMES
  var s = f < 10 ? "0" + f : "" + f
  return "/common/icons/compass/needle_" + s + ".png"
}
// 罗盘上限由 ev-six 24px 下限与标签留白共同决定，圆屏 8 胶囊屏 4
var COMPASS_LIMIT_CIRCLE = 8
var COMPASS_LIMIT_PILL = 4

// 分类屏显短名：原名五到六字超过 168px 容器，按 ev-six 删字不缩字号
var CAT_SHORT = ["二元", "方位", "学科", "数字", "果蔬", "餐饮", "日常", "娱乐", "社交", "运动", "心情", "模板"]

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    view: "main",
    pageTitle: "抉择",
    phase: "idle",
    hasResult: false,
    animKind: "wheel",
    currentDeck: null,
    customDeck: null,
    deckTitle: "要不要",
    items: ["要", "不要"],
    windowItems: [],
    // 滚动项用顶层字段绑定：JSC 下 for 数组更新不触发重绘，
    // 页面静止会让 setTimeout 链停摆（2026-11-14 胶囊屏实测）
    prevText: "",
    midText: "要",
    nextText: "不要",
    flipOn: false,
    resultText: "",
    resultIndex: 0,
    spinIndex: 0,
    spinStep: 0,
    totalSteps: 20,
    btnText: "抽一个",
    statusText: "点下面抽取",
    catIndex: -1,
    catList: [],
    deckList: [],
    customItems: [],
    compassOn: false,
    screenShape: "",
    dialSize: 160,
    dialRadius: 80,
    dialLabels: [],
    dialAngles: [],
    needleFrame: 0,
    needleSrc: "/common/icons/compass/needle_00.png",
    targetFrame: 0,
    pickCount: 1,
    pickText: "抽一个",
    pickRowOn: false,
    resultIndices: [],
    resultLines: [],
    multiOn: false,
    // 动画过程态：busy 驱动按钮忙碌视觉，line1~3 承载候选/定格文字
    busy: false,
    line1: "",
    line2: "",
    line3: "",
    lineHot1: false,
    lineHot2: false,
    lineHot3: false,
    foodMode: false,
    comboTitle: "午饭搭配",
    comboSlots: [],
    comboPicks: [],
    comboResults: [],
    slotIndex: 0,
    slotLabel: "",
    slotItems: [],
    slotWindow: [],
    slotPrevText: "",
    slotMidText: "",
    slotNextText: "",
    slotSpinIndex: 0,
    slotStep: 0,
    slotTotal: 12
  },

  onInit() {
    pageAlive = true
    this.applyTheme()
    this.buildCatList()
    this.setDeck(preset.decks[0])
    this.readShape()
    this.loadDraft()
    this.loadCustomDeck()
  },

  // 定时链必须在 onReady 起：真机 JSC 里触摸回调安排的 setTimeout 可能不派发，
  // 而生命周期回调里安排的链可以。链自续，idle 时不写任何字段。
  onReady() {
    this.startBeat()
  },

  startBeat() {
    var self = this
    // 起链即打时间戳：避免 onShow 紧接着又补一条链
    lastBeatAt = Date.now()
    var loop = function () {
      if (!pageAlive) {
        return
      }
      lastBeatAt = Date.now()
      try {
        self.beat()
      } catch (e) {}
      // idle 降频到 250ms，spinning 才用 70ms，避免手环上空转费电
      try {
        beatTimer = setTimeout(loop, self.phase === "spinning" ? BEAT_MS : 250)
      } catch (e) {
        beatTimer = null
      }
    }
    try {
      beatTimer = setTimeout(loop, BEAT_MS)
    } catch (e) {
      beatTimer = null
    }
  },

  // 链若死掉，点击/回到页面时补起一条；多条链并存无害（beat 按绝对时间、reveal 幂等）
  kickBeat() {
    if (Date.now() - lastBeatAt > 500) {
      this.startBeat()
    }
  },

  // 独立看门狗：第二条自动解锁通道。即使整条心跳链都死了，
  // 只要这次触摸回调安排的定时器能派发，2.06s 也会强制揭晓。
  // 第三条通道是用户自己再点一次（>= HARD_LOCK_MS 立即出结果），100% 可靠。
  armWatchdog() {
    var self = this
    try {
      setTimeout(function () {
        if (pageAlive && self.phase === "spinning" && Date.now() - spinStart >= HARD_LOCK_MS) {
          if (self.view === "combo") {
            self.finishComboNow()
          } else {
            self.reveal()
          }
        }
      }, HARD_LOCK_MS + 60)
    } catch (e) {}
  },

  beat() {
    if (this.phase !== "spinning") {
      return
    }
    var el = Date.now() - spinStart
    if (el >= REVEAL_MS) {
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.reveal()
      }
      return
    }
    if (this.view === "combo") {
      // 组合抽取共享按钮锁与 loading；槽级逐帧动画仍属 P2
      var step = Math.floor(el / 200)
      this.btnText = BTN_SPIN[step % 4]
      this.statusText = SPIN_TIPS[step % 4]
      return
    }
    this.renderSpinFrame(el)
  },

  readShape() {
    var self = this
    try {
      require("@system.device").getInfo({
        success: function (data) {
          self.screenShape = data.screenShape || ""
          self.resolveAnim()
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  onShow() {
    this.applyTheme()
    this.checkInputResult()
    // 页面切回来时若已过硬兜底时长，直接揭晓，不把用户留在「抽取中」
    if (this.phase === "spinning" && Date.now() - spinStart >= HARD_LOCK_MS) {
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.reveal()
      }
    }
    this.kickBeat()
  },

  onHide() {
    // 中断动画不改变结果：结果在点击时已先定，直接揭晓
    if (this.phase === "spinning") {
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.reveal()
      }
    }
  },

  onDestroy() {
    this.stopSpin()
    pageAlive = false
    if (beatTimer) {
      try {
        clearTimeout(beatTimer)
      } catch (e) {}
      beatTimer = null
    }
  },

  applyTheme() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
    })
  },

  buildCatList() {
    var out = []
    for (var i = 0; i < preset.categories.length; i++) {
      out.push({ idx: i, name: CAT_SHORT[i] || preset.categories[i] })
    }
    if (this.customDeck) {
      out.push({ idx: -2, name: "我的" })
    }
    this.catList = out
  },

  setDeck(deck) {
    if (!deck || !deck.items || deck.items.length < 2) {
      return
    }
    this.stopSpin()
    this.currentDeck = deck
    this.deckTitle = deck.title
    this.items = deck.items.slice(0)
    this.pickCount = 1
    this.phase = "idle"
    this.hasResult = false
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.busy = false
    this.line1 = ""
    this.line2 = ""
    this.line3 = ""
    this.lineHot1 = false
    this.lineHot2 = false
    this.lineHot3 = false
    this.resultIndices = []
    this.resultIndex = 0
    this.spinIndex = 0
    this.btnText = "抽一个"
    pending = null
    spinStart = 0
    this.resolveAnim()
    this.buildWindow()
  },

  // auto 策略：抽取规则优先，再判语义与项数上限；不满足一律回退 wheel
  resolveAnim() {
    var limit = (this.screenShape === "circle") ? COMPASS_LIMIT_CIRCLE : COMPASS_LIMIT_PILL
    var want = this.currentDeck && this.currentDeck.anim === "compass" && this.pickCount === 1
    var ok = want && this.items.length >= 2 && this.items.length <= limit
    if (ok) {
      for (var i = 0; i < this.items.length; i++) {
        if (this.posOf(this.items[i]) > 2) {
          ok = false
          break
        }
      }
    }
    this.compassOn = ok
    if (ok) {
      this.animKind = "compass"
      this.dialSize = (this.screenShape === "circle") ? 240 : 160
      this.dialRadius = this.dialSize / 2
      this.buildDial()
    } else {
      var flip = this.currentDeck && this.currentDeck.anim === "flip" && this.items.length === 2 && this.pickCount === 1
      this.animKind = flip ? "flip" : "wheel"
    }
    this.pickRowOn = !ok && this.items.length >= 3
    this.pickText = PICK_LABEL[this.pickCount - 1] || "抽一个"
    this.statusText = ok ? "点盘面抽取" : "点下面抽取"
  },

  // 刻度角度量化到 15 度帧，保证指针必然精确指向某个标签中心
  buildDial() {
    var n = this.items.length
    var cx = this.dialSize / 2
    var r = cx - 30
    var labels = []
    var angles = []
    for (var i = 0; i < n; i++) {
      var deg = (Math.round((i * 360 / n) / FRAME_STEP) * FRAME_STEP) % 360
      var rad = deg * Math.PI / 180
      angles.push(deg / FRAME_STEP)
      labels.push({
        text: this.items[i],
        left: Math.round(cx + r * Math.sin(rad) - 24),
        top: Math.round(cx - r * Math.cos(rad) - 17),
        hit: false
      })
    }
    this.dialAngles = angles
    this.dialLabels = labels
    this.updateNeedle(0, -1)
  },

  // 指针不用 transform rotate，全库无该能力用例，改用预渲染帧图换 src
  updateNeedle(frame, hitIndex) {
    this.needleFrame = frame
    var s = frame < 10 ? "0" + frame : "" + frame
    this.needleSrc = "/common/icons/compass/needle_" + s + ".png"
    var out = []
    for (var i = 0; i < this.dialLabels.length; i++) {
      var hit = hitIndex >= 0 ? (i === hitIndex) : (this.dialAngles[i] === frame)
      out.push({
        text: this.dialLabels[i].text,
        left: this.dialLabels[i].left,
        top: this.dialLabels[i].top,
        hit: hit
      })
    }
    this.dialLabels = out
  },

  // 单次内强制不重复，replace 固定 false
  pickIndices() {
    var pool = []
    for (var i = 0; i < this.items.length; i++) {
      pool.push(i)
    }
    for (var j = pool.length - 1; j > 0; j--) {
      var t = Math.floor(Math.random() * (j + 1))
      var tmp = pool[j]
      pool[j] = pool[t]
      pool[t] = tmp
    }
    return pool.slice(0, Math.min(this.pickCount, pool.length))
  },

  changePick() {
    if (this.phase === "spinning") {
      return
    }
    var max = Math.min(MAX_PICK, this.items.length - 1)
    this.pickCount = this.pickCount >= max ? 1 : this.pickCount + 1
    this.phase = "idle"
    this.hasResult = false
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.busy = false
    this.line1 = ""
    this.line2 = ""
    this.line3 = ""
    this.lineHot1 = false
    this.lineHot2 = false
    this.lineHot3 = false
    this.btnText = PICK_LABEL[this.pickCount - 1] || "抽一个"
    pending = null
    spinStart = 0
    this.resolveAnim()
    this.buildWindow()
  },

  draw() {
    if (this.phase === "spinning") {
      // 防误触：2 秒内的重复点击一律忽略（按钮同时变暗并显示「抽取中」，用户能看出有反应）。
      // 硬兜底：超过 2 秒，无论心跳链是否还活着，这次点击立即出结果并解锁按钮。
      if (Date.now() - spinStart >= HARD_LOCK_MS) {
        this.reveal()
      }
      return
    }
    if (!this.items || this.items.length < 2) {
      this.statusText = "至少两项"
      return
    }
    this.startSpin()
  },

  // 起帧：结果先定后演。整方法是**一个连续赋值块**，不调用任何会写 this 的方法
  // （真机 JSC 一次触摸回调内跨方法写 data 只提交最后一批，见 §7.8）。
  startSpin() {
    var idxs = this.pickIndices()
    var count = idxs.length
    var lines = []
    for (var i = 0; i < count; i++) {
      lines.push(this.items[idxs[i]])
    }
    pending = { idxs: idxs, lines: lines, text: count === 1 ? lines[0] : "", count: count }
    spinStart = Date.now()
    var f = frameAt(0, count, lines, this.items)
    // 两条异步保险放在赋值块之前（只碰模块级变量，不写 this）
    this.kickBeat()
    this.armWatchdog()
    // ↓ 起帧帧：单方法连续赋值，每个字段只写一次；作为最后一批必进渲染
    this.resultIndices = idxs
    this.resultIndex = idxs[0]
    this.spinIndex = idxs[0]
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.hasResult = false
    this.line1 = f.l1
    this.line2 = f.l2
    this.line3 = f.l3
    this.lineHot1 = f.h1
    this.lineHot2 = f.h2
    this.lineHot3 = f.h3
    this.busy = true
    this.phase = "spinning"
    this.btnText = BTN_SPIN[0]
    this.statusText = SPIN_TIPS[0]
    this.prevText = ""
    this.midText = ""
    this.nextText = ""
  },

  // 心跳帧：同样单方法连续赋值。抽两个时两行先后定格，定格行切 accent 高亮。
  renderSpinFrame(el) {
    if (!pending) {
      return
    }
    var f = frameAt(el, pending.count, pending.lines, this.items)
    this.line1 = f.l1
    this.line2 = f.l2
    this.line3 = f.l3
    this.lineHot1 = f.h1
    this.lineHot2 = f.h2
    this.lineHot3 = f.h3
    this.btnText = BTN_SPIN[f.step % 4]
    this.statusText = SPIN_TIPS[f.step % 4]
    if (this.compassOn) {
      this.needleSrc = needlePath(f.step)
    }
  },

  // 揭晓：幂等 + 单方法连续赋值。心跳到点、2 秒硬兜底点击、页面切走都走这里。
  // 单结果走 44px 大字（resultText），多结果走常驻三行（line1~3）。
  reveal() {
    if (this.phase !== "spinning") {
      return
    }
    var p = pending
    if (!p) {
      this.busy = false
      this.phase = "done"
      this.btnText = "再抽一次"
      this.statusText = "已出结果"
      return
    }
    // 多结果落位与过程帧一致（1 个走 44px 大字，2 个上+下，3 个铺满）
    var rl = ["", "", ""]
    if (p.count === 2) {
      rl[0] = p.lines[0] || ""
      rl[2] = p.lines[1] || ""
    } else if (p.count >= 3) {
      rl[0] = p.lines[0] || ""
      rl[1] = p.lines[1] || ""
      rl[2] = p.lines[2] || ""
    }
    // ↓ 揭晓帧：单方法连续赋值，不调 updateNeedle / buildWindow 等写 this 的方法
    this.needleSrc = this.compassOn ? needlePath(this.dialAngles[p.idxs[0]] || 0) : this.needleSrc
    this.line1 = rl[0]
    this.line2 = rl[1]
    this.line3 = rl[2]
    this.lineHot1 = true
    this.lineHot2 = true
    this.lineHot3 = true
    this.resultText = p.text
    this.resultLines = p.count > 1 ? p.lines.slice(0) : []
    this.resultIndices = p.idxs
    this.resultIndex = p.idxs[0]
    this.spinIndex = p.idxs[0]
    this.multiOn = p.count > 1
    this.hasResult = true
    this.busy = false
    this.phase = "done"
    this.btnText = "再抽一次"
    this.statusText = "已出结果"
    pending = null
    spinStart = 0
  },

  // 【1.0.72 起不再是 draw() 的主路径，保留作「同步揭晓」对照实现】
  // 一次点击即出结果。真机 JSC 实测（2026-11-14，1.0.67 复核失败）：
  // 一次触摸回调内跨方法写 data，只有最后一个方法（commitReveal）的赋值批次进渲染，
  // 结果内容整批丢失 → 容器显示、里面「一个大空」。
  // 因此本方法不调用任何会写 this 的方法，揭晓帧全部在**同一个方法的连续赋值块**里提交。
  drawNow() {
    this.stopSpin()
    var idxs = this.pickIndices()
    var text = ""
    var lines = []
    var multi = false
    if (this.compassOn) {
      this.targetFrame = this.dialAngles[idxs[0]]
      // 指针帧只是装饰，放在揭晓块之前；即使这一批被合并丢弃也不影响结果文字
      this.updateNeedle(this.targetFrame, idxs[0])
      text = this.items[idxs[0]]
    } else if (idxs.length > 1) {
      for (var i = 0; i < idxs.length; i++) {
        lines.push(this.items[idxs[i]])
      }
      multi = true
    } else {
      text = this.items[idxs[0]]
    }
    // ↓ 揭晓帧：不再跨方法、不再调用 commitReveal() / buildWindow()
    this.resultIndices = idxs
    this.resultIndex = idxs[0]
    this.spinIndex = idxs[0]
    this.resultText = text
    this.resultLines = lines
    this.multiOn = multi
    this.hasResult = true
    this.phase = "done"
    this.btnText = "再抽一次"
    this.statusText = "已出结果"
  },

  tick() {
    var self = this
    var n = this.items.length
    this.spinStep = this.spinStep + 1
    this.statusText = spinTip(this.spinStep)
    // 末次回调不派发：揭晓提前到最后一个可靠帧内同步完成
    if (this.spinStep >= this.totalSteps - 1) {
      this.finishDraw()
      return
    }
    this.spinIndex = (this.spinIndex + 1) % n
    this.buildWindow()
    var t = this.spinStep / this.totalSteps
    var delay = 40 + Math.floor(190 * t * t * t)
    this.scheduleTick(function () {
      self.tick()
    }, delay)
  },

  tickCompass() {
    var self = this
    this.spinStep = this.spinStep + 1
    this.statusText = spinTip(this.spinStep)
    // 末次回调不派发：揭晓提前到最后一个可靠帧内同步完成
    if (this.spinStep >= this.totalSteps - 1) {
      this.finishDraw()
      return
    }
    this.updateNeedle((this.needleFrame + 1) % FRAMES, -1)
    var t = this.spinStep / this.totalSteps
    var delay = 35 + Math.floor(190 * t * t * t)
    this.scheduleTick(function () {
      self.tickCompass()
    }, delay)
  },

  // 定时器不可用时直接揭晓：结果在 draw 阶段已确定，跳过动画不改变结果
  scheduleTick(fn, delay) {
    try {
      spinTimer = setTimeout(fn, delay)
      if (!spinTimer) {
        throw new Error("timer unavailable")
      }
    } catch (e) {
      spinTimer = null
      this.abortAnim()
    }
  },

  abortAnim() {
    if (this.view === "combo") {
      this.finishComboNow()
    } else {
      this.finishDraw()
    }
  },

  finishDraw() {
    this.stopSpin()
    this.spinIndex = this.resultIndex
    if (this.compassOn) {
      this.updateNeedle(this.targetFrame, this.resultIndex)
      this.resultText = this.items[this.resultIndex]
    } else if (this.resultIndices.length > 1) {
      var lines = []
      for (var i = 0; i < this.resultIndices.length; i++) {
        lines.push(this.items[this.resultIndices[i]])
      }
      this.resultLines = lines
      this.multiOn = true
      this.resultText = ""
    } else {
      this.resultLines = []
      this.multiOn = false
      this.resultText = this.items[this.resultIndex]
    }
    this.buildWindow()
    this.vibrate()
    this.commitReveal()
  },

  // 揭晓态必须在最后一个可靠动画帧内同步提交。
  // Vela JSC 实测（2026-11-14，xiaomi_band 胶囊屏）：单条 setTimeout 链
  // 的末次回调不派发（探针稳定停在 totalSteps-1），额外再安排一个揭晓定时器
  // 会把 phase / btnText / statusText 整帧丢掉，画面停在「正在抽取」。
  commitReveal(btn, status) {
    spinTimer = null
    this.hasResult = true
    this.phase = "done"
    this.btnText = btn || "再抽一次"
    this.statusText = status || "已出结果"
  },

  buildWindow() {
    if (this.compassOn) {
      return
    }
    var n = this.items.length
    var mid = ((this.spinIndex % n) + n) % n
    this.flipOn = this.animKind === "flip"
    this.prevText = this.flipOn ? "" : this.items[((mid - 1) % n + n) % n]
    this.midText = this.items[mid]
    this.nextText = this.flipOn ? "" : this.items[((mid + 1) % n + n) % n]
  },

  stopSpin() {
    if (spinTimer) {
      try {
        clearTimeout(spinTimer)
      } catch (e) {}
      spinTimer = null
    }
  },

  vibrate() {
    if (!VIBRATE_ENABLED) {
      return
    }
    try {
      var vib = require("@system.vibrator")
      if (vib && typeof vib.vibrate === "function") {
        vib.vibrate({ mode: "short" })
      }
    } catch (e) {}
  },

  openDecks() {
    this.stopSpin()
    this.view = "decks"
    this.pageTitle = "卡组"
    this.catIndex = -1
    this.buildCatList()
  },

  openCustom() {
    this.stopSpin()
    this.view = "custom"
    this.pageTitle = "自定"
    this.statusText = "点加一项"
  },

  pickCat(idx) {
    if (idx === -2) {
      if (!this.customDeck) {
        return
      }
      this.catIndex = -2
      this.deckList = [{ idx: 0, title: "我的卡组", deckIndex: -1 }]
      return
    }
    this.catIndex = idx
    this.foodMode = false
    var cat = preset.categories[idx]
    var out = []
    for (var i = 0; i < preset.decks.length; i++) {
      // F01 是空占位卡组，运行时由餐饮数据接管，不显示为死项
      if (preset.decks[i].cat === cat && preset.decks[i].items && preset.decks[i].items.length >= 2) {
        out.push({ idx: out.length, title: preset.decks[i].title, deckIndex: i })
      }
    }
    // 餐饮类追加两个视图入口，不是新卡组，预设仍是 88 组
    if (cat === "餐饮") {
      out.push({ idx: out.length, title: "随便吃一道", deckIndex: -3 })
      out.push({ idx: out.length, title: "搭配抽", deckIndex: -4 })
    }
    this.deckList = out
  },

  selectDeck(deckIndex) {
    if (deckIndex === -3) {
      this.openFoodCats()
      return
    }
    if (deckIndex === -4) {
      this.startCombo()
      return
    }
    // -10 - i 编码餐饮 L1 大类索引
    if (deckIndex <= -10) {
      var ci = -10 - deckIndex
      var fc = food.categories[ci]
      if (!fc) {
        return
      }
      var names = []
      for (var q = 0; q < fc.items.length; q++) {
        names.push(fc.items[q].name)
      }
      this.setDeck({ id: "FOOD" + ci, title: fc.short, cat: "餐饮", items: names, anim: "wheel" })
      this.foodMode = false
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    if (deckIndex < 0) {
      if (!this.customDeck) {
        return
      }
      this.setDeck(this.customDeck)
    } else {
      this.setDeck(preset.decks[deckIndex])
    }
    this.view = "main"
    this.pageTitle = "抉择"
  },

  // OR：12 类选 1 类，再在该类里 wheel 抽 1 项
  openFoodCats() {
    this.stopSpin()
    this.foodMode = true
    this.catIndex = 5
    var out = []
    for (var i = 0; i < food.categories.length; i++) {
      out.push({ idx: i, title: food.categories[i].short, deckIndex: -10 - i })
    }
    this.deckList = out
    this.view = "decks"
    this.pageTitle = "吃什么"
  },

  // 槽位只从已有数据读取，不新增任何餐饮条目
  resolveSlot(slot) {
    var ref = slot.ref || ""
    if (ref.indexOf("deck:food/") === 0) {
      var cname = ref.slice(10)
      var rows = []
      for (var i = 0; i < food.categories.length; i++) {
        if (food.categories[i].name === cname) {
          rows = food.categories[i].items
        }
      }
      var f = slot.filter || {}
      var out = []
      for (var j = 0; j < rows.length; j++) {
        var r = rows[j]
        if ((f["口味"] && r["口味"] !== f["口味"]) ||
            (f["荤素"] && r["荤素"] !== f["荤素"]) ||
            (f["冷热"] && r["冷热"] !== f["冷热"]) ||
            (f["场景"] && r["场景"] !== f["场景"]) ||
            (f["sub"] && r["sub"] !== f["sub"])) {
          continue
        }
        out.push(r.name)
      }
      return out
    }
    if (ref.indexOf("deck:preset/") === 0) {
      var key = ref.slice(12)
      for (var m = 0; m < preset.decks.length; m++) {
        if (preset.decks[m].id === key || preset.decks[m].title === key) {
          return preset.decks[m].items.slice(0)
        }
      }
      return []
    }
    return (slot.items || []).slice(0)
  },

  // AND：多槽各抽 1 项拼成一个元组，逐槽串行揭晓
  startCombo() {
    this.stopSpin()
    var c = food.combos[0]
    var slots = []
    for (var i = 0; i < c.slots.length; i++) {
      slots.push({ label: c.slots[i].label, items: this.resolveSlot(c.slots[i]) })
    }
    this.comboTitle = c.title
    this.comboSlots = slots
    this.compassOn = false
    this.view = "combo"
    this.pageTitle = "搭配"
    this.foodMode = false
    this.drawCombo()
  },

  drawCombo() {
    if (this.phase === "spinning") {
      // 同 draw：2 秒内防误触，超过 2 秒这次点击强制揭晓，绝不永久锁死
      if (Date.now() - spinStart >= HARD_LOCK_MS) {
        this.finishComboNow()
      }
      return
    }
    var picks = []
    for (var i = 0; i < this.comboSlots.length; i++) {
      var its = this.comboSlots[i].items
      picks.push(its.length ? its[Math.floor(Math.random() * its.length)] : "暂无")
    }
    spinStart = Date.now()
    pending = null
    this.kickBeat()
    this.armWatchdog()
    // ↓ 起帧帧：单方法连续赋值。组合结果在点击时已定，过程共享按钮锁与 loading
    this.comboPicks = picks
    this.slotIndex = 0
    this.comboResults = []
    this.hasResult = false
    this.busy = true
    this.phase = "spinning"
    this.btnText = BTN_SPIN[0]
    this.statusText = SPIN_TIPS[0]
  },

  runSlot() {
    var slot = this.comboSlots[this.slotIndex]
    if (!slot || !slot.items.length) {
      this.finishSlot()
      return
    }
    this.slotItems = slot.items.slice(0)
    this.slotLabel = slot.label
    this.slotSpinIndex = 0
    this.slotStep = 0
    this.slotTotal = 10 + Math.floor(Math.random() * 5)
    this.buildSlotWindow()
    this.tickSlot()
  },

  buildSlotWindow() {
    var n = this.slotItems.length
    var mid = ((this.slotSpinIndex % n) + n) % n
    this.slotPrevText = this.slotItems[((mid - 1) % n + n) % n]
    this.slotMidText = this.slotItems[mid]
    this.slotNextText = this.slotItems[((mid + 1) % n + n) % n]
  },

  tickSlot() {
    var self = this
    this.slotStep = this.slotStep + 1
    this.statusText = spinTip(this.slotStep)
    // 同主抽取：末次回调不派发，槽位揭晓提前一帧同步完成
    if (this.slotStep >= this.slotTotal - 1) {
      this.finishSlot()
      return
    }
    this.slotSpinIndex = (this.slotSpinIndex + 1) % this.slotItems.length
    this.buildSlotWindow()
    var t = this.slotStep / this.slotTotal
    var delay = 45 + Math.floor(150 * t * t * t)
    this.scheduleTick(function () {
      self.tickSlot()
    }, delay)
  },

  finishSlot() {
    this.stopSpin()
    var slot = this.comboSlots[this.slotIndex]
    var out = this.comboResults.slice(0)
    out.push({ label: slot ? slot.label : "", value: this.comboPicks[this.slotIndex] || "暂无" })
    this.comboResults = out
    this.slotIndex = this.slotIndex + 1
    if (this.slotIndex < this.comboSlots.length) {
      this.runSlot()
      return
    }
    this.vibrate()
    this.commitReveal("整套重抽", "已出结果")
  },

  finishComboNow() {
    this.stopSpin()
    var out = []
    for (var i = 0; i < this.comboSlots.length; i++) {
      out.push({ label: this.comboSlots[i].label, value: this.comboPicks[i] || "暂无" })
    }
    // 同 reveal：组合结果必须与揭晓态在同一方法的连续赋值块里提交
    this.comboResults = out
    this.hasResult = true
    this.busy = false
    this.phase = "done"
    this.btnText = "整套重抽"
    this.statusText = "已出结果"
    pending = null
    spinStart = 0
  },

  addItem() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "加一项", fail: function () {} })
    storage.set({ key: "chinese_input_placeholder", value: "唱歌 不唱歌", fail: function () {} })
    storage.set({ key: "chinese_input_value", value: "", fail: function () {} })
    storage.set({ key: "chinese_input_maxlen", value: "24", fail: function () {} })
    storage.set({
      key: "chinese_input_return_key",
      value: ADD_RESULT_KEY,
      success: function () {
        router.push({ uri: "/pages/chinese-input" })
      },
      fail: function () {}
    })
  },

  checkInputResult() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: ADD_RESULT_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        storage.delete({ key: ADD_RESULT_KEY, fail: function () {} })
        var parsed = self.parseText(data)
        if (!parsed.length) {
          self.statusText = "选项为空"
          return
        }
        var items = self.customItems.slice(0)
        for (var i = 0; i < parsed.length; i++) {
          if (items.indexOf(parsed[i]) < 0 && items.length < MAX_ITEMS) {
            items.push(parsed[i])
          }
        }
        self.customItems = items
        self.statusText = "已加好"
        self.saveDraft()
      },
      fail: function () {}
    })
  },

  parseText(raw) {
    var parts = String(raw || "").split(/[\s,，、;；]+/)
    var out = []
    for (var i = 0; i < parts.length; i++) {
      var s = parts[i]
      if (!s || this.posOf(s) > MAX_P) {
        continue
      }
      if (out.indexOf(s) < 0) {
        out.push(s)
      }
      if (out.length >= MAX_ITEMS) {
        break
      }
    }
    return out
  },

  posOf(s) {
    var p = 0
    for (var i = 0; i < s.length; i++) {
      var c = s.charAt(i)
      if (/[\u4e00-\u9fa5]/.test(c)) {
        p = p + 1
      } else if (/[0-9A-Za-z]/.test(c)) {
        p = p + 0.55
      } else {
        p = p + 0.5
      }
    }
    return p
  },

  saveCustom() {
    if (this.customItems.length < 2) {
      this.statusText = "至少两项"
      return
    }
    var deck = {
      id: "CUSTOM",
      title: "我的卡组",
      cat: "我的",
      items: this.customItems.slice(0),
      anim: this.customItems.length === 2 ? "flip" : "wheel"
    }
    this.customDeck = deck
    var storage = require("@system.storage")
    storage.set({ key: CUSTOM_DECK_KEY, value: JSON.stringify(deck), fail: function () {} })
    this.setDeck(deck)
    this.view = "main"
    this.pageTitle = "抉择"
    this.buildCatList()
    this.draw()
  },

  clearCustom() {
    this.customItems = []
    this.saveDraft()
    this.statusText = "已清空"
  },

  saveDraft() {
    var storage = require("@system.storage")
    storage.set({ key: DRAFT_KEY, value: JSON.stringify(this.customItems), fail: function () {} })
  },

  loadDraft() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: DRAFT_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var arr = JSON.parse(data)
          if (arr && arr.length) {
            self.customItems = arr.slice(0, MAX_ITEMS)
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  loadCustomDeck() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: CUSTOM_DECK_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var deck = JSON.parse(data)
          if (deck && deck.items && deck.items.length >= 2) {
            self.customDeck = deck
            self.buildCatList()
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  goBack() {
    if (this.view === "combo") {
      this.stopSpin()
      this.phase = "idle"
      this.hasResult = false
      this.busy = false
      this.line1 = ""
      this.line2 = ""
      this.line3 = ""
      this.btnText = "抽一个"
      pending = null
      spinStart = 0
      this.view = "decks"
      this.pageTitle = "卡组"
      this.pickCat(5)
      return
    }
    if (this.view === "decks") {
      if (this.foodMode) {
        this.foodMode = false
        this.pickCat(5)
        return
      }
      if (this.catIndex !== -1) {
        this.catIndex = -1
        return
      }
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    if (this.view === "custom") {
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    this.stopSpin()
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 32px 12px 16px 12px;
}

/* 一体返回胶囊：与易微课程表设置页 common/header.css 的 .hdr 段同源。
   居中在 .hdr 上做，整颗胶囊都是点击区（30×30 → 约 106×40），
   flex-shrink:0 防止页头被压成 0 高导致返回键消失（课程表历史坑）。 */
.hdr {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.hdr-pill {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 40px;
  padding: 0 14px;
  border-radius: 20px;
  flex-shrink: 0;
}

.hdr-pill-ic {
  width: 20px;
  height: 20px;
  margin-right: 4px;
  object-fit: contain;
}

.hdr-pill-t {
  font-size: 28px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.view {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.deck-head {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.deck-name {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

/* 罗盘：盘面文字固定水平排布，只有指针帧在动 */
.compass-box {
  flex-direction: column;
  width: 100%;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.dial {
  position: relative;
  border-width: 2px;
  border-color: #444444;
  justify-content: center;
  align-items: center;
}

.dial-tick {
  position: absolute;
  width: 48px;
  height: 34px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.dial-tick-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.needle {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.compass-result {
  width: 100%;
  height: 60px;
  justify-content: center;
  align-items: center;
}

.compass-result-text {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
  text-align: center;
  lines: 2;
}

/* 旧 .multi-result / .multi-line（for 数组渲染）已删：
   真机 JSC 下 for 数组更新不重绘，多结果改由常驻 .line 三行承载。 */

/* 组合卡：字段标签 24 字段值 28 纵向排版，不用分隔符 */
.combo-stage {
  flex-direction: column;
  width: 100%;
  height: 180px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.combo-slot-label {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.combo-card {
  flex-direction: column;
  width: 100%;
  border-radius: 14px;
  padding: 8px 8px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.combo-card-title {
  width: 100%;
  font-size: 30px;
  font-weight: bold;
  line-height: 40px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.combo-field {
  flex-direction: column;
  width: 100%;
  height: 72px;
  border-radius: 8px;
  padding: 0 8px;
  justify-content: center;
  margin-bottom: 4px;
}

.combo-field-label {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  lines: 1;
}

.combo-field-value {
  width: 100%;
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

.pick-row {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.pick-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.stage {
  position: relative;
  flex-direction: column;
  width: 100%;
  height: 138px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.spin-box {
  flex-direction: column;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.spin-row {
  width: 100%;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
}

.spin-text {
  font-size: 28px;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

/* 常驻覆盖层：不参与 display 切换，永远参与首次渲染，保证 {{ resultText }} 的绑定依赖存在 */
.result-box {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 138px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 过程行层：与 result-box 同级绝对覆盖，两者互不占布局高度。
   单行结果用 44px 大字（result-box），多行结果与抽取过程用 28px 三行（本层）。
   28px × 6P × 0.958 ≈ 161px < 168px 内容宽，菜名不截断；
   3 行 × 34px = 102px，胶囊屏舞台 126px 仍放得下。 */
.line-box {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 行高 30 + 上下各 2 间距 = 34，三行总高仍 102px，块重心不随内容变化而跳动。
   落定行由模板挂 theme.cardLight 底色（未定行 transparent），
   于是「逐条落定」在视觉上就是逐条出现的结果条，滚动中永远只是灰字。 */
.line {
  width: 100%;
  height: 30px;
  margin: 2px 0;
  flex-shrink: 0;
  border-radius: 8px;
  font-size: 28px;
  line-height: 30px;
  text-align: center;
  lines: 1;
}

.result-text {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
  text-align: center;
  lines: 2;
}

.main-btn {
  width: 100%;
  height: 56px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.main-btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

.sub-row {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.sub-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.status-line {
  width: 100%;
  height: 34px;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.list-scroll {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.list-row {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  padding: 0 8px;
  justify-content: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.list-text {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

.edit-tip {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 8px;
}

.item-scroll {
  flex-direction: column;
  width: 100%;
  flex: 1;
  min-height: 100px;
  margin-bottom: 10px;
}

.item-row {
  width: 100%;
  height: 44px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.item-text {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

/* 大屏放大一体返回胶囊，与易微课程表设置页保持一致 */
@media (shape: rect), (shape: circle) {
  .hdr-pill {
    height: 48px;
    padding: 0 18px;
    border-radius: 24px;
  }
  .hdr-pill-ic {
    width: 24px;
    height: 24px;
    margin-right: 6px;
  }
  .hdr-pill-t {
    font-size: 34px;
    line-height: 42px;
  }
}

@media (shape: circle) {
  .page {
    padding: 24px 20px 16px 20px;
  }
  .stage {
    height: 150px;
  }
  .compass-box {
    margin-bottom: 0;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 24px 12px 12px 12px;
  }
  .stage {
    height: 126px;
  }
}
</style>
