</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var preset = require("../../data/decks/preset-decks.json")
var food = require("../../data/decks/preset-food.json")

var crypto = require("../../lib/crypto.js")

// ===== P2 抽取引擎（2026-11-15 · evtask-D-evevbox-261115-a7z2hd）=====
// drawRule 完整字段对象：全部字段可选，缺省 = P0/P1 旧行为，88 组老卡组零配置向后兼容。
// 与 mode（数据源二级抽取）、groupMode（抽出的人怎么组队）严格区分，见方案 §3.7.4。
var DEFAULT_RULE = {
  resultMode: "single", pickCount: 1, replace: true,
  groupSize: 2, groupMode: "partial", groupLabels: [], slots: []
}
var CN_NUM = ["一", "二", "三", "四", "五", "六"]

function normalizeRule(deck) {
  var d = deck || {}
  var raw = d.drawRule || {}
  var pick = (typeof raw.pickCount === "number" && raw.pickCount > 0) ? Math.floor(raw.pickCount) : 1
  var mode = raw.resultMode || (pick > 1 ? "multi" : DEFAULT_RULE.resultMode)
  var size = (typeof raw.groupSize === "number" && raw.groupSize > 0) ? Math.floor(raw.groupSize) : 2
  var labels = []
  if (raw.groupLabels && raw.groupLabels.length) {
    for (var i = 0; i < raw.groupLabels.length; i++) labels.push(String(raw.groupLabels[i]))
  }
  var slots = []
  if (raw.slots && raw.slots.length) {
    for (var j = 0; j < raw.slots.length; j++) slots.push(raw.slots[j])
  }
  return {
    resultMode: mode,
    pickCount: pick,
    replace: raw.replace !== false,
    groupSize: size,
    groupMode: raw.groupMode === "full" ? "full" : DEFAULT_RULE.groupMode,
    groupLabels: labels,
    slots: slots
  }
}

// 全覆盖分组：洗牌后按 groupSize 顺序切片，每个成员恰好出现一次、组内不重复。
// 余数单独记为 odd（结果页提示「有N人落单」），不丢弃也不重复；
// 最多 6 组、每组最多 4 行，受 ev-six 一屏文字预算约束（§9.3）。
function partitionGroups(items, size, labels, shuffled) {
  var pool = (shuffled || items || []).slice(0)
  var groups = []
  var used = 0
  var odd = 0
  while (pool.length > 0 && groups.length < 6) {
    var take = Math.min(size, pool.length)
    var members = pool.splice(0, take)
    var label = labels[groups.length] || ("第" + (CN_NUM[groups.length] || (groups.length + 1)) + "组")
    groups.push({ label: label, members: members })
    used = used + take
    // 方案 §3.7.3：人数不能被组大小整除时，最后一组为余数并提示落单，
    // 余数成员仍完整出现在结果里（全覆盖），不丢弃、不重复。
    if (take < size) { odd = take }
  }
  return { groups: groups, used: used, odd: odd }
}

var CUSTOM_DECK_KEY = "decide_custom_deck"
var DRAFT_KEY = "decide_draft_items"
var ADD_RESULT_KEY = "decide_add_item"
var MAX_ITEMS = 30
var MAX_P = 6
// 三行 24px 结果 102px 不超胶囊屏舞台 126px，四个及以上留 P2 拆页
var MAX_PICK = 8
var FRAMES = 24
var FRAME_STEP = 15
var PICK_LABEL = ["抽一个", "抽两个", "抽三个", "抽四个", "抽五个", "抽六个", "抽七个", "抽八个"]
// 动画定时器句柄放在模块作用域：private 里的值会被框架做响应式包装，
// 对 setTimeout 返回的句柄赋值/读取可能抛异常，导致动画永远停在首帧。
// JSC 实测（2026-11-14）：抽取按钮停在「抽取中」不进 done 即由此引起。
var spinTimer = null
// Vela 模拟器 JSC 实测：动画定时器回调链内调用 @system.vibrator 会让 vapp 退出，
// 真机复核通过后再置 true（方案 §4.2 的咔哒手感属 P3 增强，不阻塞抽取）
var VIBRATE_ENABLED = true
// 旧「逐帧 setTimeout 链」开关，1.0.72 起由 onReady 常驻心跳接管，恒 false。
// 保留 tick / scheduleTick / finishDraw 等实现仅供真机对照，不要重新打开：
// 它们在触摸回调里起链、且揭晓依赖末次回调，真机上会停在「正在抽取」。
var ANIM_ASYNC = false
// Vela JSC 下动画帧必须持续改一个已渲染的顶层文本才会重绘并推进定时器链；
// 用状态行的 loading 省略号承载，最长 5.5P 满足 ev-six 一行 ≤6P
var SPIN_TIPS = ["正在抽取", "正在抽取。", "正在抽取。。", "正在抽取。。。"]
function spinTip(step) {
  return SPIN_TIPS[step % 4]
}

// ===== 抽取过程动画（2026-11-14 / 1.0.72）=====
// 真机 JSC 两条硬约束（docs/pages/core/decide.md §7.8）：
//  ① 一次触摸回调内跨方法写 data，只有最后一个方法的赋值批次进渲染
//     → 起帧帧、揭晓帧都必须是「同一个方法内的连续赋值块」，不调用任何会写 this 的方法；
//  ② 触摸回调里安排的 setTimeout 可能不派发，而 onReady 里安排的链可以
//     → 定时链在 onReady 起常驻心跳，点击只改状态字段，不在回调里起定时器。
// 心跳按「绝对时间」推帧：丢帧能自动追上，不靠帧计数累加到终点。
// 揭晓幂等；点击本身是第二条兜底通道（>= HARD_LOCK_MS 强制揭晓），
// 所以即便整条心跳链死掉，用户也绝不会永久卡在「抽取中」。
var BEAT_MS = 70
// 轮播间隔 = 心跳间隔：每推一帧必然换一个候选（若大于心跳，会出现「整帧没变」的顿感）
var ROLL_MS = 70
var REVEAL_MS = 1600
var HARD_LOCK_MS = 2000
// 三连抽（2026-11-14 第二组动画）：卷轴接力，三条落定的绝对时刻。
// 末条 1300ms 落定、1600ms 正式揭晓，留 300ms 让「三条都已定」被看清，不再干等 460ms。
var LOCK3 = [420, 860, 1300]
// 四连抽（2026-11-14 第三组动画）：0-800ms 只在中行集中快滚，800ms 四行同时落内容，
// 再按 LOCK4 逐行「点亮」（灰字 -> accent + 底条），像四张牌同时翻出、再逐张盖章。
// 与双签（两行同时滚）、接力（一次一行逐条出内容）都不同：内容一次给全，只逐行点亮。
// 多选一（2026-11-15 第五组动画）：滚筒窗。三行显示相邻候选，整窗滚动后渐慢，
// WHEEL_T 后收敛成只剩中行结果（上下清空），再由揭晓切 44px 大字。
// 与「单签」的区别：单签只有一行在换字，滚筒窗是整窗位移，能看到「上一项/下一项」在动。
var WHEEL_T = 1150
var WHEEL_CHG = [0, 70, 140, 210, 280, 350, 420, 490, 560, 700, 840, 1050]
var GATHER4 = 800
var LOCK4 = [900, 1000, 1100, 1200]
// 落定前多少毫秒开始减速：候选切换变慢，视觉上「沉」一下再停，不是硬切
var ROLL_SLOW = 180
var beatTimer = null
var lastBeatAt = 0
var spinStart = 0
var pending = null
var pageAlive = true
// 抽取期按钮只有一个状态：整段不变，不跟动画帧跳（2026-11-15 Tom 反馈：一起跳太乱）
var BTN_BUSY = "抽取中"

// ===== 入口与外围 P2/P3（2026-11-15 · C 组）=====
var HISTORY_KEY = "decide_history"
var SIMPLE_KEY = "decide_simple_anim"
var RECENT_KEY = "decide_recent"
var FAV_KEY = "decide_favorites"
var ENTRY_KEY = "decide_entry_params"
var IMPORT_RESULT_KEY = "decide_import_text"
var EXPORT_RESULT_KEY = "decide_export_text"
var SEARCH_RESULT_KEY = "decide_search_text"
var HISTORY_MAX = 20
var HISTORY_VIEW = 8
var ENTRY_TTL = 30000

// URI 参数解析：同时供「框架 query」与「storage 回传」两条通道使用。
// 全库无 this.$page.query / router.getState 用例，故主通道走 chinese-input 同款
// storage 回传协议（真机已验证），框架 query 只作兜底尝试。
function parseQuery(q) {
  var out = {}
  var s = String(q || "").replace(/^\?/, "")
  if (!s) { return out }
  var parts = s.split("&")
  for (var i = 0; i < parts.length; i++) {
    var kv = parts[i].split("=")
    if (!kv[0]) { continue }
    var v = kv[1] || ""
    try { v = decodeURIComponent(v) } catch (e) {}
    out[kv[0]] = v
  }
  return out
}

// 历史 v2 兼容：新记录 results: []，旧记录按 result 单值读取（方案 §3.7.8）
function historyLine(rec) {
  var r = rec || {}
  var rs = r.results || (r.result ? [r.result] : [])
  var deck = String(r.deck || "卡组").slice(0, 3)
  var val = String(rs[0] || "").slice(0, 2)
  return deck + " " + val
}

// 结果数 → 行位：1 个用中行、2 个用上+下行、3 个铺满，
// 三行块重心恒在舞台中心，且不依赖任何条件渲染节点。
function rowSlots(count) {
  if (count === 1) { return [1] }
  if (count === 2) { return [0, 2] }
  return [0, 1, 2]
}

// 候选轮播取下标：乘子取质数 7919，与任何少于它的项数互质，
// 保证相邻帧必然换一个候选（乘子若有公因子，n=5 时 step*5%5 恒为 0，行会「假滚」不动）。
function rollIdx(step, k, n) {
  var v = (step * 7919 + k * 13 + 3) % n
  return v < 0 ? v + n : v
}

// 纯函数：算出某一时刻的过程帧，不写 this，可在触摸回调里安全调用。
//
// 抽两个（第一组）：并行双签 —— 上下两行**同时**滚候选，约 533ms 上行定格、
//   1066ms 下行定格，两处同时在动，错峰开奖。
// 抽三个（本组）：卷轴接力 —— **一次只有一行在滚**，落定一条就钉住切高亮，
//   下一行接棒起滚；三条依次 380 / 760 / 1140ms 落定，落定前 180ms 减速。
//   与双签的差别正是「过程里视线只被拉一处」，三行逐条填满，读起来像名单揭晓。
// 抽一个：单签，中行一直滚到 800ms 定格。
function frameAt(el, count, lines, items) {
  var step = Math.floor(el / ROLL_MS)
  var n = items.length
  var l = ["", "", "", ""]
  var h = [false, false, false, false]

  // 多选一（项数 >= 5）：滚筒窗
  // 以中行为「窗心」，上下两行是窗口里相邻的候选，整窗按 ease-out 位移：
  // 起步每帧换一项，越接近停止位移越小，读起来是「滚轮慢慢咬合到位」。
  // WHEEL_T 后收敛：只留中行结果，上下清空——「窗」收成「一条」。
  if (count === 1 && n >= 5) {
    if (el >= WHEEL_T) {
      return { l1: "", l2: lines[0] || "", l3: "", l4: "", h1: false, h2: true, h3: false, h4: false, step: step }
    }
    var wi = items.indexOf(lines[0])
    if (wi < 0) {
      wi = 0
    }
    // 换字节奏表：前 8 跳每 70ms（跟着心跳走，最快），之后 140 / 140 / 210 逐步拉长，
    // 最后一跳落在 1050ms，离收敛只隔 100ms——是「咬合到位」而不是「提前冻住」。
    // 反向算：还剩几次没换，就把窗口往回退这么多项，末跳必落在 wi。
    // 不用位移取整（末段增量 <1 会整段静止），也不用来不及刹住的纯 ease-out（末跳离终点太远）。
    var jumped = 0
    for (var ci = 0; ci < WHEEL_CHG.length; ci++) {
      if (el >= WHEEL_CHG[ci]) {
        jumped = ci + 1
      }
    }
    var wi2 = ((wi - (WHEEL_CHG.length - jumped)) % n + n) % n
    return {
      l1: items[(wi2 - 1 + n) % n],
      l2: items[wi2],
      l3: items[(wi2 + 1) % n],
      l4: "",
      h1: false, h2: true, h3: false, h4: false,
      step: step
    }
  }

  // 四连抽：集中滚动 -> 四行同时落内容 -> 逐行点亮
  if (count >= 4) {
    if (el < GATHER4) {
      var sp = Math.floor(el / 50)
      l[1] = items[rollIdx(sp, 0, n)]
      return { l1: "", l2: l[1], l3: "", l4: "", h1: false, h2: false, h3: false, h4: false, step: sp }
    }
    for (var k4 = 0; k4 < 4; k4++) {
      l[k4] = lines[k4] || ""
      h[k4] = el >= LOCK4[k4]
    }
    return { l1: l[0], l2: l[1], l3: l[2], l4: l[3], h1: h[0], h2: h[1], h3: h[2], h4: h[3], step: step }
  }

  // 三连抽：卷轴接力（一次只有一行在滚，逐条落定）
  if (count >= 3) {
    for (var k = 0; k < 3; k++) {
      var lockAt = LOCK3[k]
      var startAt = k === 0 ? 0 : LOCK3[k - 1]
      if (el >= lockAt) {
        h[k] = true
        l[k] = lines[k] || ""
      } else if (el >= startAt) {
        var sd = (lockAt - el < ROLL_SLOW) ? Math.floor(step / 3) : step
        h[k] = false
        l[k] = items[rollIdx(sd, k, n)]
      }
    }
    return { l1: l[0], l2: l[1], l3: l[2], l4: "", h1: h[0], h2: h[1], h3: h[2], h4: false, step: step }
  }

  // 抽两个：并行双签；抽一个：单签
  var slots = rowSlots(count)
  for (var j = 0; j < slots.length; j++) {
    var r = slots[j]
    var at = Math.floor(REVEAL_MS * (j + 1) / (count + 1))
    h[r] = el >= at
    l[r] = h[r] ? lines[j] : items[rollIdx(step, j, n)]
  }
  return { l1: l[0], l2: l[1], l3: l[2], l4: "", h1: h[0], h2: h[1], h3: h[2], h4: false, step: step }
}

// 方位词 → 真实方位角（0=正上/前，顺时针）。非方位词返回 -1。
// 用途：卡片文案常写成「前后左右」这种口语句序，直接按索引均分会把左右画反。
function dirAngleOf(text) {
  var t = (text || "").replace(/\s/g, "")
  var map = {
    "前": 0, "上": 0, "北": 0, "前面": 0, "上边": 0, "北边": 0,
    "右上": 45, "前右": 45, "东北": 45,
    "右": 90, "东": 90, "右面": 90, "右边": 90, "东边": 90,
    "右下": 135, "后右": 135, "东南": 135,
    "后": 180, "下": 180, "南": 180, "后面": 180, "下边": 180, "南边": 180,
    "左下": 225, "后左": 225, "西南": 225,
    "左": 270, "西": 270, "左面": 270, "左边": 270, "西边": 270,
    "左上": 315, "前左": 315, "西北": 315
  }
  return map.hasOwnProperty(t) ? map[t] : -1
}

function needlePath(frame) {
  var f = frame % FRAMES
  var s = f < 10 ? "0" + f : "" + f
  return "/common/icons/compass/needle_" + s + ".png"
}
// 罗盘上限由 ev-six 24px 下限与标签留白共同决定，圆屏 8 胶囊屏 4
var COMPASS_LIMIT_CIRCLE = 8
var COMPASS_LIMIT_PILL = 4

// 点击回查表放模块级：真机 JSC 下 this.<数组> 的赋值不可靠（同一方法里只提交最后一批，
// 数组常常写不进去），表现为「行显示正常但点了没反应」——2026-11-16 模拟器实测：
// cat0..cat16 字符串槽全部正确渲染，而 this.catRows[i] 读到 undefined，pickCatRow 直接 return。
// 模块级 var 不经数据层代理，读写都可靠。
var CAT_ROWS = []
var DECK_ROWS = []

// 分类屏显短名：原名五到六字超过 168px 容器，按 ev-six 删字不缩字号
var CAT_SHORT = ["二元", "方位", "学科", "数字", "果蔬", "餐饮", "日常", "娱乐", "社交", "运动", "心情", "模板"]

// ===== 组合抽取 P2（2026-11-15 · B 组）=====
var SLOT_KEY = "decide_custom_slots"
var MAX_SLOTS = 6
var FILTER_KEYS = ["口味", "荤素", "冷热", "场景"]
// 每档首项为空串 = 不筛；取值与 preset-food.json 的 filters 定义逐项对齐
var FILTER_VALUES = [
  ["", "辣", "不辣"],
  ["", "荤", "素"],
  ["", "热食", "冷食"],
  ["", "在家", "外卖", "下馆子"]
]
// 用户抽前筛选放模块级变量：不进 private，避免对象属性赋值在 JSC 下不触发通知；
// 屏显只靠 f0Text..f3Text 四个顶层字段，二者在同一个方法的连续赋值块里一起写。
var userFilter = {}

function filterLabel(i, v) {
  return FILTER_KEYS[i] + " " + (v || "都行")
}

function filterEcho() {
  var parts = []
  for (var i = 0; i < FILTER_KEYS.length && parts.length < 2; i++) {
    if (userFilter[FILTER_KEYS[i]]) parts.push(userFilter[FILTER_KEYS[i]])
  }
  return parts.length ? parts.join(" ") : "未筛选"
}

// 「换一道」纯函数：只从目标槽的候选里抽一个，且尽量避开当前值。
// 其余槽的值完全不参与计算，因此 1000 次抽样可断言「只改目标槽」。
function repickSlot(items, cur) {
  var pool = []
  for (var k = 0; k < items.length; k++) {
    if (items.length === 1 || items[k] !== cur) pool.push(items[k])
  }
  return pool.length ? pool[crypto.randomInt(pool.length)] : cur
}

// 槽位解析纯函数：只读已有 300 条与 88 组，把「槽自带 filter」与「用户抽前筛选」
// 取交集（都满足才入选），不排序不打分（方案 §3.8.7），不新增任何数据条目。
function resolveSlotPure(slot) {
  var ref = slot.ref || ""
  if (ref.indexOf("deck:food/") === 0) {
    var cname = ref.slice(10)
    var rows = []
    for (var i = 0; i < food.categories.length; i++) {
      if (food.categories[i].name === cname) rows = food.categories[i].items
    }
    var f = slot.filter || {}
    var out = []
    for (var j = 0; j < rows.length; j++) {
      var r = rows[j]
      if ((f["口味"] && r["口味"] !== f["口味"]) ||
          (userFilter["口味"] && r["口味"] !== userFilter["口味"]) ||
          (f["荤素"] && r["荤素"] !== f["荤素"]) ||
          (userFilter["荤素"] && r["荤素"] !== userFilter["荤素"]) ||
          (f["冷热"] && r["冷热"] !== f["冷热"]) ||
          (userFilter["冷热"] && r["冷热"] !== userFilter["冷热"]) ||
          (f["场景"] && r["场景"] !== f["场景"]) ||
          (userFilter["场景"] && r["场景"] !== userFilter["场景"]) ||
          (f["sub"] && r["sub"] !== f["sub"])) {
        continue
      }
      out.push(r.name)
    }
    return out
  }
  if (ref.indexOf("deck:preset/") === 0) {
    var key = ref.slice(12)
    for (var m = 0; m < preset.decks.length; m++) {
      if (preset.decks[m].id === key || preset.decks[m].title === key) {
        return preset.decks[m].items.slice(0)
      }
    }
    return []
  }
  return (slot.items || []).slice(0)
}

function buildComboSlots(raw) {
  var slots = []
  for (var i = 0; i < raw.length && i < MAX_SLOTS; i++) {
    slots.push({
      label: raw[i].label,
      ref: raw[i].ref,
      filter: raw[i].filter,
      items: resolveSlotPure(raw[i])
    })
  }
  return slots
}

// ref → 屏显短名（≤3 字），避免长类目名把一行顶过 6P
function refShort(ref) {
  var r = String(ref || "")
  if (r.indexOf("deck:food/") === 0) {
    var n = r.slice(10)
    for (var i = 0; i < food.categories.length; i++) {
      if (food.categories[i].name === n) return (food.categories[i].short || n).slice(0, 3)
    }
    return n.slice(0, 3)
  }
  if (r.indexOf("deck:preset/") === 0) {
    var k = r.slice(12)
    for (var j = 0; j < preset.decks.length; j++) {
      if (preset.decks[j].id === k) return preset.decks[j].title.slice(0, 3)
    }
    return k.slice(0, 3)
  }
  return "自定"
}

function slotRowTexts(list) {
  var out = []
  for (var i = 0; i < MAX_SLOTS; i++) {
    var s = list[i]
    // ev-six 一行 ≤6P：标签截 2 字 + 空格 0.3P + 引用短名 ≤3 字 = 最多 5.3P
    var lab = s ? String(s.label || "").slice(0, 2) : ""
    out.push(s ? (lab + " " + refShort(s.ref)) : "")
  }
  return out
}

function comboRawSlots(custom, active) {
  return (active && custom && custom.length) ? custom : food.combos[0].slots
}

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    view: "main",
    pageTitle: "抉择",
    phase: "idle",
    hasResult: false,
    animKind: "wheel",
    currentDeck: null,
    customDeck: null,
    deckTitle: "要不要",
    items: ["要", "不要"],
    windowItems: [],
    // 滚动项用顶层字段绑定：JSC 下 for 数组更新不触发重绘，
    // 页面静止会让 setTimeout 链停摆（2026-11-14 胶囊屏实测）
    prevText: "",
    midText: "要",
    nextText: "不要",
    flipOn: false,
    resultText: "",
    resultIndex: 0,
    spinIndex: 0,
    spinStep: 0,
    totalSteps: 20,
    btnText: "抽一个",
    statusText: "点下面抽取",
    catIndex: -1,
    catRows: [],
    deckRows: [],
    cat0: "",
    cat1: "",
    cat2: "",
    cat3: "",
    cat4: "",
    cat5: "",
    cat6: "",
    cat7: "",
    cat8: "",
    cat9: "",
    cat10: "",
    cat11: "",
    cat12: "",
    deck0: "",
    deck1: "",
    deck2: "",
    deck3: "",
    deck4: "",
    deck5: "",
    deck6: "",
    deck7: "",
    deck8: "",
    deck9: "",
    deck10: "",
    deck11: "",
    deck12: "",
    deck13: "",
    deck14: "",
    deck15: "",
    deck16: "",
    deck17: "",
    deck18: "",
    deck19: "",
    customItems: [],
    compassOn: false,
    screenShape: "",
    dialSize: 160,
    dialRadius: 80,
    dialLabels: [],
    dialAngles: [],
    // 罗盘标签改 8 个常驻槽位（2026-11-15）：for="{{ dialLabels }}" 在真机 JSC 上
    // 首帧后重赋值不重绘 → 指针转了、高亮纹丝不动。槽位常驻、内容空/非空表达状态，
    // 与卡组行同一个套路。dialAngles 仍是纯 JS 数组（不进 data，供帧计算用）。
    dial0Text: "", dial0Left: 0, dial0Top: 0, dial0Hit: false,
    dial1Text: "", dial1Left: 0, dial1Top: 0, dial1Hit: false,
    dial2Text: "", dial2Left: 0, dial2Top: 0, dial2Hit: false,
    dial3Text: "", dial3Left: 0, dial3Top: 0, dial3Hit: false,
    dial4Text: "", dial4Left: 0, dial4Top: 0, dial4Hit: false,
    dial5Text: "", dial5Left: 0, dial5Top: 0, dial5Hit: false,
    dial6Text: "", dial6Left: 0, dial6Top: 0, dial6Hit: false,
    dial7Text: "", dial7Left: 0, dial7Top: 0, dial7Hit: false,
    needleSize: 131,
    needleOff: 15,
    needleFrame: 0,
    needleSrc: "/common/icons/compass/needle_00.png",
    targetFrame: 0,
    pickCount: 1,
    pickText: "抽一个",
    pickRowOn: false,
    resultIndices: [],
    resultLines: [],
    multiOn: false,
    // 动画过程态：busy 驱动按钮忙碌视觉，line1~3 承载候选/定格文字
    busy: false,
    line1: "",
    line2: "",
    line3: "",
    line4: "",
    lineHot1: false,
    lineHot2: false,
    lineHot3: false,
    lineHot4: false,
    foodMode: false,
    comboTitle: "午饭搭配",
    comboSlots: [],
    comboPicks: [],
    comboResults: [],
    slotIndex: 0,
    slotLabel: "",
    slotItems: [],
    slotWindow: [],
    slotPrevText: "",
    slotMidText: "",
    slotNextText: "",
    slotSpinIndex: 0,
    slotStep: 0,
    slotTotal: 12,
    rule: normalizeRule(null),
    partitionOn: false,
    grpTitle: "分好组了",
    grpOddText: "",
    grpCardH: "102px",
    grp0Name: "",
    grp0A: "",
    grp0B: "",
    grp0C: "",
    grp0D: "",
    grp1Name: "",
    grp1A: "",
    grp1B: "",
    grp1C: "",
    grp1D: "",
    grp2Name: "",
    grp2A: "",
    grp2B: "",
    grp2C: "",
    grp2D: "",
    grp3Name: "",
    grp3A: "",
    grp3B: "",
    grp3C: "",
    grp3D: "",
    grp4Name: "",
    grp4A: "",
    grp4B: "",
    grp4C: "",
    grp4D: "",
    grp5Name: "",
    grp5A: "",
    grp5B: "",
    grp5C: "",
    grp5D: "",
    cR0Label: "",
    cR0Value: "",
    cR1Label: "",
    cR1Value: "",
    cR2Label: "",
    cR2Value: "",
    cR3Label: "",
    cR3Value: "",
    cR4Label: "",
    cR4Value: "",
    cR5Label: "",
    cR5Value: "",
    comboTip: "点卡片换一道",
    f0Text: "口味 都行",
    f1Text: "荤素 都行",
    f2Text: "冷热 都行",
    f3Text: "场景 都行",
    filterEchoText: "未筛选",
    sl0: "",
    sl1: "",
    sl2: "",
    sl3: "",
    sl4: "",
    sl5: "",
    customSlots: [],
    hasCustomSlots: false,
    addSlotMode: false,
    cat13: "",
    cat14: "",
    cat15: "",
    cat16: "",
    h0: "",
    h1: "",
    h2: "",
    h3: "",
    h4: "",
    h5: "",
    h6: "",
    h7: "",
    simpleAnim: false,
    simpleText: "简化动画 关",
    favText: "收藏本组",
    favIds: [],
    recentIds: [],
    searchKey: "",
    pageIndex: 0,
    pageCount: 1,
  },

  onInit() {
    pageAlive = true
    this.applyTheme()
    this.buildCatList()
    this.setDeck(preset.decks[0])
    this.readShape()
    this.loadDraft()
    this.loadCustomDeck()
    this.loadSlots()
    this.loadSimple()
    this.loadFav()
  },

  // 定时链必须在 onReady 起：真机 JSC 里触摸回调安排的 setTimeout 可能不派发，
  // 而生命周期回调里安排的链可以。链自续，idle 时不写任何字段。
  onReady() {
    this.startBeat()
  },

  startBeat() {
    var self = this
    // 起链即打时间戳：避免 onShow 紧接着又补一条链
    lastBeatAt = Date.now()
    var loop = function () {
      if (!pageAlive) {
        return
      }
      lastBeatAt = Date.now()
      try {
        self.beat()
      } catch (e) {}
      // idle 降频到 250ms，spinning 才用 70ms，避免手环上空转费电
      try {
        beatTimer = setTimeout(loop, self.phase === "spinning" ? BEAT_MS : 250)
      } catch (e) {
        beatTimer = null
      }
    }
    try {
      beatTimer = setTimeout(loop, BEAT_MS)
    } catch (e) {
      beatTimer = null
    }
  },

  // 链若死掉，点击/回到页面时补起一条；多条链并存无害（beat 按绝对时间、reveal 幂等）
  kickBeat() {
    if (Date.now() - lastBeatAt > 500) {
      this.startBeat()
    }
  },

  // 独立看门狗：第二条自动解锁通道。即使整条心跳链都死了，
  // 只要这次触摸回调安排的定时器能派发，2.06s 也会强制揭晓。
  // 第三条通道是用户自己再点一次（>= HARD_LOCK_MS 立即出结果），100% 可靠。
  armWatchdog() {
    var self = this
    try {
      setTimeout(function () {
        if (pageAlive && self.phase === "spinning" && Date.now() - spinStart >= HARD_LOCK_MS) {
          if (self.view === "combo") {
            self.finishComboNow()
          } else {
            self.reveal()
          }
        }
      }, HARD_LOCK_MS + 60)
    } catch (e) {}
  },

  beat() {
    if (this.phase !== "spinning") {
      return
    }
    var el = Date.now() - spinStart
    // C11 简化动画：结果与完整动画共用 pickIndices()（同种子可复现），
    // 只把揭晓时刻提前到 0ms，指针/滚动瞬时归位，不另写一套抽取逻辑。
    var revealAt = this.simpleAnim ? 0 : REVEAL_MS
    if (el >= revealAt) {
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.reveal()
      }
      return
    }
    if (this.view === "combo") {
      // 组合抽取共享按钮锁与 loading；槽级逐帧动画仍属 P2
      // 与抉择页同一条纪律：按钮整段静止，dots 只在状态行、400ms 一档
      this.statusText = SPIN_TIPS[Math.floor(el / 400) % 4]
      return
    }
    this.renderSpinFrame(el)
  },

  readShape() {
    var self = this
    try {
      require("@system.device").getInfo({
        success: function (data) {
          self.screenShape = data.screenShape || ""
          self.resolveAnim()
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  onShow() {
    this.applyTheme()
    this.checkInputResult()
    this.applyEntry()
    // 页面切回来时若已过硬兜底时长，直接揭晓，不把用户留在「抽取中」
    if (this.phase === "spinning" && Date.now() - spinStart >= HARD_LOCK_MS) {
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.reveal()
      }
    }
    this.kickBeat()
  },

  // 系统返回（侧滑/返回键）默认直接 pop 页面 → 一路弹回 Ev工具箱首页。
  // 真机反馈（2026-11-15 Tom）：在卡组页返回应回「抉择」第一页，而不是退出工具。
  // 这里拦下系统返回，交给页面内的 goBack 分层处理；最外层才真正 pop。
  onBackPress() {
    if (this.view === "main") {
      return false
    }
    this.goBack()
    return true
  },

  onHide() {
    // 中断动画不改变结果：结果在点击时已先定，直接揭晓
    if (this.phase === "spinning") {
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.reveal()
      }
    }
  },

  onDestroy() {
    this.stopSpin()
    pageAlive = false
    if (beatTimer) {
      try {
        clearTimeout(beatTimer)
      } catch (e) {}
      beatTimer = null
    }
  },

  applyTheme() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
    })
  },

  buildCatList() {
    var out = []
    // C13：最近使用 / 收藏 / 搜索 / 更多 四个虚拟分类置顶，12 个真实分类顺延，
    // 两级列表本身就是「分类折叠」（点类才展开该类卡组）。
    out.push({ idx: -7, name: "最近" })
    out.push({ idx: -8, name: "收藏" })
    for (var i = 0; i < preset.categories.length; i++) {
      out.push({ idx: i, name: CAT_SHORT[i] || preset.categories[i] })
    }
    if (this.customDeck) {
      out.push({ idx: -2, name: "我的" })
    }
    out.push({ idx: -9, name: "搜索" })
    out.push({ idx: -11, name: "更多" })
    // 固定行槽：for 数组在真机不重绘（§7.8），逐个写进 cat0..cat16
    CAT_ROWS = out
    this.cat0 = (out[0] && out[0].name) || ""
    this.cat1 = (out[1] && out[1].name) || ""
    this.cat2 = (out[2] && out[2].name) || ""
    this.cat3 = (out[3] && out[3].name) || ""
    this.cat4 = (out[4] && out[4].name) || ""
    this.cat5 = (out[5] && out[5].name) || ""
    this.cat6 = (out[6] && out[6].name) || ""
    this.cat7 = (out[7] && out[7].name) || ""
    this.cat8 = (out[8] && out[8].name) || ""
    this.cat9 = (out[9] && out[9].name) || ""
    this.cat10 = (out[10] && out[10].name) || ""
    this.cat11 = (out[11] && out[11].name) || ""
    this.cat12 = (out[12] && out[12].name) || ""
    this.cat13 = (out[13] && out[13].name) || ""
    this.cat14 = (out[14] && out[14].name) || ""
    this.cat15 = (out[15] && out[15].name) || ""
    this.cat16 = (out[16] && out[16].name) || ""
    this.resetListScroll("catList")
  },

  setDeck(deck) {
    if (!deck || !deck.items || deck.items.length < 2) {
      return
    }
    this.stopSpin()
    this.currentDeck = deck
    this.rule = normalizeRule(deck)
    this.partitionOn = this.rule.resultMode === "partition" && deck.items.length >= 2
    this.deckTitle = deck.title
    this.items = deck.items.slice(0)
    this.pickCount = this.partitionOn ? Math.min(this.rule.groupSize, deck.items.length) : this.rule.pickCount
    this.grpOddText = ""
    this.noteRecent(deck)
    this.phase = "idle"
    this.hasResult = false
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.busy = false
    this.line1 = ""
    this.line2 = ""
    this.line3 = ""
    this.line4 = ""
    this.lineHot1 = false
    this.lineHot2 = false
    this.lineHot3 = false
    this.lineHot4 = false
    this.resultIndices = []
    this.resultIndex = 0
    this.spinIndex = 0
    this.btnText = "抽一个"
    pending = null
    spinStart = 0
    this.resolveAnim()
    this.buildWindow()
  },

  // auto 策略：抽取规则优先，再判语义与项数上限；不满足一律回退 wheel
  resolveAnim() {
    var limit = (this.screenShape === "circle") ? COMPASS_LIMIT_CIRCLE : COMPASS_LIMIT_PILL
    var want = this.currentDeck && this.currentDeck.anim === "compass" && this.pickCount === 1
    var ok = want && this.items.length >= 2 && this.items.length <= limit
    if (ok) {
      for (var i = 0; i < this.items.length; i++) {
        if (this.posOf(this.items[i]) > 2) {
          ok = false
          break
        }
      }
    }
    this.compassOn = ok
    if (ok) {
      this.animKind = "compass"
      this.dialSize = (this.screenShape === "circle") ? 240 : 160
      this.dialRadius = this.dialSize / 2
      this.buildDial()
    } else {
      var flip = this.currentDeck && this.currentDeck.anim === "flip" && this.items.length === 2 && this.pickCount === 1
      this.animKind = flip ? "flip" : "wheel"
    }
    this.pickRowOn = !ok && !this.partitionOn && this.items.length >= 3
    this.pickText = PICK_LABEL[this.pickCount - 1] || "抽一个"
    this.statusText = ok ? "点盘面抽取" : (this.partitionOn ? "点下面分组" : "点下面抽取")
  },

  // 刻度角度量化到 15 度帧，保证指针必然精确指向某个标签中心
  buildDial() {
    var n = this.items.length
    var cx = this.dialSize / 2
    var r = cx - 30
    var labels = []
    var angles = []
    // 方位词优先按真实方位摆位（2026-11-15 Tom：罗盘镜像了、「右」跑到左边）。
    // 卡组文案顺序是「前后左右」这种口语句序，直接按索引均分会让左右互换；
    // 所以先查方位表，全部命中且角度不冲突才按语义摆，否则退回按序均分。
    var dirs = []
    var ok = n > 0
    for (var d = 0; d < n; d++) {
      var da = dirAngleOf(this.items[d])
      if (da < 0) { ok = false; break }
      dirs.push(da)
    }
    if (ok) {
      for (var u = 0; u < n; u++) {
        for (var v = u + 1; v < n; v++) {
          if (dirs[u] === dirs[v]) { ok = false }
        }
      }
    }
    for (var i = 0; i < n; i++) {
      var deg = ok ? dirs[i] : (Math.round((i * 360 / n) / FRAME_STEP) * FRAME_STEP) % 360
      var rad = deg * Math.PI / 180
      angles.push(deg / FRAME_STEP)
      labels.push({
        text: this.items[i],
        left: Math.round(cx + r * Math.sin(rad) - 24),
        top: Math.round(cx - r * Math.cos(rad) - 17),
        hit: false
      })
    }
    this.dialAngles = angles
    this.dialLabels = labels
    // 指针盒按 0.82 盘径：素材针长 84px(240 基准)，原尺寸针尖 56px 会压住标签(r=50)，
    // 收到 46px 左右，正好落在标签环内侧、不压字。
    this.needleSize = Math.round(this.dialSize * 0.82)
    this.needleOff = Math.round((this.dialSize - this.needleSize) / 2)
    this.updateNeedle(0, -1)
  },

  // 指针不用 transform rotate，全库无该能力用例，改用预渲染帧图换 src。
  // 标签写进 8 个常驻槽：**必须显式逐字段赋值**——this["dial0Hit"] 这类动态键赋值
  // 不触发数据层通知（首帧能显示是因为走的是全量渲染），真机上就会「指针转了、高亮不动」。
  updateNeedle(frame, hitIndex) {
    this.needleFrame = frame
    var s = frame < 10 ? "0" + frame : "" + frame
    this.needleSrc = "/common/icons/compass/needle_" + s + ".png"
    var n = this.dialLabels.length
    var ang = this.dialAngles
    var l0 = n > 0 ? this.dialLabels[0] : null
    var l1 = n > 1 ? this.dialLabels[1] : null
    var l2 = n > 2 ? this.dialLabels[2] : null
    var l3 = n > 3 ? this.dialLabels[3] : null
    var l4 = n > 4 ? this.dialLabels[4] : null
    var l5 = n > 5 ? this.dialLabels[5] : null
    var l6 = n > 6 ? this.dialLabels[6] : null
    var l7 = n > 7 ? this.dialLabels[7] : null
    // hit 判定：显式命中优先；否则取「与当前指针角度最近的那个标签」——
    // 只判相等的话，指针走在两个标签之间时没有命中项，上一次的高亮会一直挂着，
    // 看起来还是「不跟针」（2026-11-15 模拟器中间帧实测）。
    var best = -1
    if (hitIndex < 0 && n > 0) {
      var bestD = 999
      for (var bi = 0; bi < n; bi++) {
        var diff = Math.abs(((ang[bi] - frame + 36) % 24) - 12)
        if (diff < bestD) { bestD = diff; best = bi }
      }
    }
    var h0 = n > 0 && (hitIndex >= 0 ? hitIndex === 0 : best === 0)
    var h1 = n > 1 && (hitIndex >= 0 ? hitIndex === 1 : best === 1)
    var h2 = n > 2 && (hitIndex >= 0 ? hitIndex === 2 : best === 2)
    var h3 = n > 3 && (hitIndex >= 0 ? hitIndex === 3 : best === 3)
    var h4 = n > 4 && (hitIndex >= 0 ? hitIndex === 4 : best === 4)
    var h5 = n > 5 && (hitIndex >= 0 ? hitIndex === 5 : best === 5)
    var h6 = n > 6 && (hitIndex >= 0 ? hitIndex === 6 : best === 6)
    var h7 = n > 7 && (hitIndex >= 0 ? hitIndex === 7 : best === 7)
    this.dial0Text = l0 ? l0.text : ""
    this.dial0Left = l0 ? l0.left : 0
    this.dial0Top = l0 ? l0.top : 0
    this.dial0Hit = h0
    this.dial1Text = l1 ? l1.text : ""
    this.dial1Left = l1 ? l1.left : 0
    this.dial1Top = l1 ? l1.top : 0
    this.dial1Hit = h1
    this.dial2Text = l2 ? l2.text : ""
    this.dial2Left = l2 ? l2.left : 0
    this.dial2Top = l2 ? l2.top : 0
    this.dial2Hit = h2
    this.dial3Text = l3 ? l3.text : ""
    this.dial3Left = l3 ? l3.left : 0
    this.dial3Top = l3 ? l3.top : 0
    this.dial3Hit = h3
    this.dial4Text = l4 ? l4.text : ""
    this.dial4Left = l4 ? l4.left : 0
    this.dial4Top = l4 ? l4.top : 0
    this.dial4Hit = h4
    this.dial5Text = l5 ? l5.text : ""
    this.dial5Left = l5 ? l5.left : 0
    this.dial5Top = l5 ? l5.top : 0
    this.dial5Hit = h5
    this.dial6Text = l6 ? l6.text : ""
    this.dial6Left = l6 ? l6.left : 0
    this.dial6Top = l6 ? l6.top : 0
    this.dial6Hit = h6
    this.dial7Text = l7 ? l7.text : ""
    this.dial7Left = l7 ? l7.left : 0
    this.dial7Top = l7 ? l7.top : 0
    this.dial7Hit = h7
  },

  // 单次内强制不重复，replace 固定 false
  // 随机源统一走 src/lib/crypto.js（宿主熵优先、xorshift 混合熵、Math.random 末级兜底）。
  // 单次内强制不重复沿用 P1 正确性前提：洗牌取前 k 个，drawRule.replace 只作字段解析，
  // 跨轮次 allowRepeat 属 P3，未实现前不改变「抽 k 个必然不同」的行为。
  pickIndices() {
    var pool = []
    for (var i = 0; i < this.items.length; i++) {
      pool.push(i)
    }
    var sh = crypto.shuffle(pool)
    return sh.slice(0, Math.min(this.pickCount, sh.length))
  },

  changePick() {
    if (this.phase === "spinning") {
      return
    }
    var max = Math.min(MAX_PICK, this.items.length - 1)
    this.pickCount = this.pickCount >= max ? 1 : this.pickCount + 1
    this.phase = "idle"
    this.hasResult = false
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.busy = false
    this.line1 = ""
    this.line2 = ""
    this.line3 = ""
    this.line4 = ""
    this.lineHot1 = false
    this.lineHot2 = false
    this.lineHot3 = false
    this.lineHot4 = false
    this.btnText = PICK_LABEL[this.pickCount - 1] || "抽一个"
    pending = null
    spinStart = 0
    this.resolveAnim()
    this.buildWindow()
  },

  draw() {
    if (this.phase === "spinning") {
      // 防误触：2 秒内的重复点击一律忽略（按钮同时变暗并显示「抽取中」，用户能看出有反应）。
      // 硬兜底：超过 2 秒，无论心跳链是否还活着，这次点击立即出结果并解锁按钮。
      if (Date.now() - spinStart >= HARD_LOCK_MS) {
        this.reveal()
      }
      return
    }
    if (!this.items || this.items.length < 2) {
      this.statusText = "至少两项"
      return
    }
    this.startSpin()
  },

  // 起帧：结果先定后演。整方法是**一个连续赋值块**，不调用任何会写 this 的方法
  // （真机 JSC 一次触摸回调内跨方法写 data 只提交最后一批，见 §7.8）。
  startSpin() {
    var idxs = this.pickIndices()
    var count = idxs.length
    var lines = []
    for (var i = 0; i < count; i++) {
      lines.push(this.items[idxs[i]])
    }
    var groups = null
    if (this.partitionOn) {
      // 结果先定后演：分组在起帧一次性抽定，动画过程只演不重抽
      groups = partitionGroups(this.items, this.rule.groupSize, this.rule.groupLabels, crypto.shuffle(this.items.slice(0)))
    }
    pending = { idxs: idxs, lines: lines, text: count === 1 ? lines[0] : "", count: count, groups: groups }
    spinStart = Date.now()
    var f = this.simpleAnim ? null : frameAt(0, count, lines, this.items)
    // 两条异步保险放在赋值块之前（只碰模块级变量，不写 this）
    this.kickBeat()
    this.armWatchdog()
    // ↓ 起帧帧：单方法连续赋值，每个字段只写一次；作为最后一批必进渲染
    this.resultIndices = idxs
    this.resultIndex = idxs[0]
    this.spinIndex = idxs[0]
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.hasResult = false
    this.line1 = f ? f.l1 : ""
    this.line2 = f ? f.l2 : ""
    this.line3 = f ? f.l3 : ""
    this.line4 = f ? f.l4 : ""
    this.lineHot1 = f ? f.h1 : false
    this.lineHot2 = f ? f.h2 : false
    this.lineHot3 = f ? f.h3 : false
    this.lineHot4 = f ? f.h4 : false
    this.busy = true
    this.phase = "spinning"
    this.btnText = BTN_BUSY
    this.statusText = SPIN_TIPS[0]
    this.prevText = ""
    this.midText = ""
    this.nextText = ""
    this.vibrate("short")
  },

  // 心跳帧：同样单方法连续赋值。抽两个时两行先后定格，定格行切 accent 高亮。
  renderSpinFrame(el) {
    if (!pending || this.simpleAnim) {
      return
    }
    var f = frameAt(el, pending.count, pending.lines, this.items)
    this.line1 = f.l1
    this.line2 = f.l2
    this.line3 = f.l3
    this.line4 = f.l4
    this.lineHot1 = f.h1
    this.lineHot2 = f.h2
    this.lineHot3 = f.h3
    this.lineHot4 = f.h4
    // 按钮**不跟着动画跳**：整段抽取期固定「抽取中」，只在按下和揭晓两处换一次状态。
    // loading 点只走到状态行，且用 400ms 独立节奏——不跟 70ms 的动画帧同频。
    this.statusText = SPIN_TIPS[Math.floor(el / 400) % 4]
    if (this.compassOn) {
      this.needleSrc = needlePath(f.step)
    }
  },

  // 揭晓：幂等 + 单方法连续赋值。心跳到点、2 秒硬兜底点击、页面切走都走这里。
  // 单结果走 44px 大字（resultText），多结果走常驻三行（line1~3）。
  reveal() {
    if (this.phase !== "spinning") {
      return
    }
    var p = pending
    if (!p) {
      this.busy = false
      this.phase = "done"
      this.btnText = "再抽一次"
      this.statusText = "已出结果"
      return
    }
    // 分组结果：先算成局部数组，再在下面同一个连续赋值块里一次性写入，
    // 不调用任何会写 this 的方法（真机 JSC 跨方法批次丢失，§7.8）。
    var g = p.groups
    var gn = ["", "", "", "", "", ""]
    var gm = []
    var oddText = ""
    var keepView = this.view
    for (var gi = 0; gi < 6; gi++) { gm.push(["", "", "", ""]) }
    if (g) {
      for (var gj = 0; gj < g.groups.length && gj < 6; gj++) {
        gn[gj] = g.groups[gj].label
        for (var gk = 0; gk < g.groups[gj].members.length && gk < 4; gk++) {
          gm[gj][gk] = g.groups[gj].members[gk]
        }
      }
      if (g.odd > 0) { oddText = "有" + g.odd + "人落单" }
    }
    // 一屏预算：组数 × (组名34 + 成员30×n + padding8) + 页头48 + 提示34 + 按钮66 + 返回48
    // 4 人分 2 对 → 2×102 + 196 = 400px < 408px 浮层，一屏放得下；更大名单走 scroll。
    var firstLen = (g && g.groups.length) ? g.groups[0].members.length : 2
    var cardH = (34 + Math.min(4, firstLen) * 30 + 8) + "px"
    // 多结果落位与过程帧一致（1 个走 44px 大字，2 个上+下，3 个铺满）
    // C14 拆页：k>=5 时按每页 4 行切片，状态行显示页码，点状态行翻页
    var rl = ["", "", "", ""]
    var allLines = p.lines.slice(0)
    var pageCount = 1
    var pageIndex = 0
    if (p.count === 2) {
      rl[0] = allLines[0] || ""
      rl[2] = allLines[1] || ""
    } else if (p.count >= 3) {
      for (var pi = 0; pi < 4; pi++) { rl[pi] = allLines[pi] || "" }
      pageCount = Math.max(1, Math.ceil(allLines.length / 4))
    }
    var pageText = pageCount > 1 ? ("第" + (pageIndex + 1) + "页 共" + pageCount + "页") : ""
    // ↓ 揭晓帧：单方法连续赋值，不调 updateNeedle / buildWindow 等写 this 的方法
    this.needleSrc = this.compassOn ? needlePath(this.dialAngles[p.idxs[0]] || 0) : this.needleSrc
    // 高亮必须跟着落点走：本方法刻意不调 updateNeedle，所以 hit 槽位在这里显式一并写，
    // 否则真机上「指针停在右、字还亮着前」（2026-11-15 模拟器复现）。
    var hi = p.idxs[0]
    var dn = this.items.length
    this.dial0Hit = dn > 0 && hi === 0
    this.dial1Hit = dn > 1 && hi === 1
    this.dial2Hit = dn > 2 && hi === 2
    this.dial3Hit = dn > 3 && hi === 3
    this.dial4Hit = dn > 4 && hi === 4
    this.dial5Hit = dn > 5 && hi === 5
    this.dial6Hit = dn > 6 && hi === 6
    this.dial7Hit = dn > 7 && hi === 7
    this.line1 = rl[0]
    this.line2 = rl[1]
    this.line3 = rl[2]
    this.line4 = rl[3]
    // 只有真有内容的行才点亮：空行点亮会留下一条 cardLight 底条，
    // 而 line-box 在 DOM 里排在 result-box 之后 → 空底条直接盖住 44px 结果大字
    // （2026-11-15 真机/模拟器复现：「结果被一些线覆盖」的真因）。
    this.lineHot1 = !!rl[0]
    this.lineHot2 = !!rl[1]
    this.lineHot3 = !!rl[2]
    this.lineHot4 = !!rl[3]
    this.resultText = p.text
    this.resultLines = p.count > 1 ? p.lines.slice(0) : []
    this.resultIndices = p.idxs
    this.resultIndex = p.idxs[0]
    this.spinIndex = p.idxs[0]
    this.multiOn = p.count > 1
    this.grpTitle = g ? "分好组了" : this.grpTitle
    this.grpOddText = oddText
    this.grpCardH = cardH
    this.grp0Name = gn[0]
    this.grp0A = gm[0][0]
    this.grp0B = gm[0][1]
    this.grp0C = gm[0][2]
    this.grp0D = gm[0][3]
    this.grp1Name = gn[1]
    this.grp1A = gm[1][0]
    this.grp1B = gm[1][1]
    this.grp1C = gm[1][2]
    this.grp1D = gm[1][3]
    this.grp2Name = gn[2]
    this.grp2A = gm[2][0]
    this.grp2B = gm[2][1]
    this.grp2C = gm[2][2]
    this.grp2D = gm[2][3]
    this.grp3Name = gn[3]
    this.grp3A = gm[3][0]
    this.grp3B = gm[3][1]
    this.grp3C = gm[3][2]
    this.grp3D = gm[3][3]
    this.grp4Name = gn[4]
    this.grp4A = gm[4][0]
    this.grp4B = gm[4][1]
    this.grp4C = gm[4][2]
    this.grp4D = gm[4][3]
    this.grp5Name = gn[5]
    this.grp5A = gm[5][0]
    this.grp5B = gm[5][1]
    this.grp5C = gm[5][2]
    this.grp5D = gm[5][3]
    this.hasResult = true
    this.busy = false
    this.phase = "done"
    this.btnText = "再抽一次"
    this.statusText = g ? "已分好组" : (pageText || "已出结果")
    this.view = g ? "groups" : keepView
    this.resultLines = allLines
    this.pageIndex = pageIndex
    this.pageCount = pageCount
    pending = null
    spinStart = 0
    this.vibrate("long")
    this.pushHistory(g ? "partition" : "single")
  },

  // 【1.0.72 起不再是 draw() 的主路径，保留作「同步揭晓」对照实现】
  // 一次点击即出结果。真机 JSC 实测（2026-11-14，1.0.67 复核失败）：
  // 一次触摸回调内跨方法写 data，只有最后一个方法（commitReveal）的赋值批次进渲染，
  // 结果内容整批丢失 → 容器显示、里面「一个大空」。
  // 因此本方法不调用任何会写 this 的方法，揭晓帧全部在**同一个方法的连续赋值块**里提交。
  drawNow() {
    this.stopSpin()
    var idxs = this.pickIndices()
    var text = ""
    var lines = []
    var multi = false
    if (this.compassOn) {
      this.targetFrame = this.dialAngles[idxs[0]]
      // 指针帧只是装饰，放在揭晓块之前；即使这一批被合并丢弃也不影响结果文字
      this.updateNeedle(this.targetFrame, idxs[0])
      text = this.items[idxs[0]]
    } else if (idxs.length > 1) {
      for (var i = 0; i < idxs.length; i++) {
        lines.push(this.items[idxs[i]])
      }
      multi = true
    } else {
      text = this.items[idxs[0]]
    }
    // ↓ 揭晓帧：不再跨方法、不再调用 commitReveal() / buildWindow()
    this.resultIndices = idxs
    this.resultIndex = idxs[0]
    this.spinIndex = idxs[0]
    this.resultText = text
    this.resultLines = lines
    this.multiOn = multi
    this.hasResult = true
    this.phase = "done"
    this.btnText = "再抽一次"
    this.statusText = "已出结果"
  },

  tick() {
    var self = this
    var n = this.items.length
    this.spinStep = this.spinStep + 1
    this.statusText = spinTip(this.spinStep)
    // 末次回调不派发：揭晓提前到最后一个可靠帧内同步完成
    if (this.spinStep >= this.totalSteps - 1) {
      this.finishDraw()
      return
    }
    this.spinIndex = (this.spinIndex + 1) % n
    this.buildWindow()
    var t = this.spinStep / this.totalSteps
    var delay = 40 + Math.floor(190 * t * t * t)
    this.scheduleTick(function () {
      self.tick()
    }, delay)
  },

  tickCompass() {
    var self = this
    this.spinStep = this.spinStep + 1
    this.statusText = spinTip(this.spinStep)
    // 末次回调不派发：揭晓提前到最后一个可靠帧内同步完成
    if (this.spinStep >= this.totalSteps - 1) {
      this.finishDraw()
      return
    }
    this.updateNeedle((this.needleFrame + 1) % FRAMES, -1)
    var t = this.spinStep / this.totalSteps
    var delay = 35 + Math.floor(190 * t * t * t)
    this.scheduleTick(function () {
      self.tickCompass()
    }, delay)
  },

  // 定时器不可用时直接揭晓：结果在 draw 阶段已确定，跳过动画不改变结果
  scheduleTick(fn, delay) {
    try {
      spinTimer = setTimeout(fn, delay)
      if (!spinTimer) {
        throw new Error("timer unavailable")
      }
    } catch (e) {
      spinTimer = null
      this.abortAnim()
    }
  },

  abortAnim() {
    if (this.view === "combo") {
      this.finishComboNow()
    } else {
      this.finishDraw()
    }
  },

  finishDraw() {
    this.stopSpin()
    this.spinIndex = this.resultIndex
    if (this.compassOn) {
      this.updateNeedle(this.targetFrame, this.resultIndex)
      this.resultText = this.items[this.resultIndex]
    } else if (this.resultIndices.length > 1) {
      var lines = []
      for (var i = 0; i < this.resultIndices.length; i++) {
        lines.push(this.items[this.resultIndices[i]])
      }
      this.resultLines = lines
      this.multiOn = true
      this.resultText = ""
    } else {
      this.resultLines = []
      this.multiOn = false
      this.resultText = this.items[this.resultIndex]
    }
    this.buildWindow()
    this.vibrate()
    this.commitReveal()
  },

  // 揭晓态必须在最后一个可靠动画帧内同步提交。
  // Vela JSC 实测（2026-11-14，xiaomi_band 胶囊屏）：单条 setTimeout 链
  // 的末次回调不派发（探针稳定停在 totalSteps-1），额外再安排一个揭晓定时器
  // 会把 phase / btnText / statusText 整帧丢掉，画面停在「正在抽取」。
  commitReveal(btn, status) {
    spinTimer = null
    this.hasResult = true
    this.phase = "done"
    this.btnText = btn || "再抽一次"
    this.statusText = status || "已出结果"
  },

  buildWindow() {
    if (this.compassOn) {
      return
    }
    var n = this.items.length
    var mid = ((this.spinIndex % n) + n) % n
    this.flipOn = this.animKind === "flip"
    this.prevText = this.flipOn ? "" : this.items[((mid - 1) % n + n) % n]
    this.midText = this.items[mid]
    this.nextText = this.flipOn ? "" : this.items[((mid + 1) % n + n) % n]
  },

  stopSpin() {
    if (spinTimer) {
      try {
        clearTimeout(spinTimer)
      } catch (e) {}
      spinTimer = null
    }
  },

  // 震动只做两个时刻的短促提醒：按下按钮（short）、揭晓结果（long）。
  // 全程 try/catch + typeof 守卫：native 模块缺席或抛错绝不能让页面白屏。
  // 只能在赋值块之后调用——先让这一帧数据进渲染，再去做可能抛错的原生调用。
  vibrate(mode) {
    if (!VIBRATE_ENABLED) {
      return
    }
    try {
      var vib = require("@system.vibrator")
      if (vib && typeof vib.vibrate === "function") {
        vib.vibrate({ mode: mode || "short" })
      }
    } catch (e) {}
  },

  openDecks() {
    this.stopSpin()
    this.view = "decks"
    this.pageTitle = "卡组"
    this.catIndex = -1
    this.buildCatList()
  },

  openCustom() {
    this.stopSpin()
    this.view = "custom"
    this.pageTitle = "自定"
    this.statusText = "点加一项"
  },

  // 卡组列表同样走固定行槽：数组只做点击回查，显示靠 deck0..deck19
  applyDeckRows(out) {
    DECK_ROWS = out
    this.deck0 = (out[0] && out[0].title) || ""
    this.deck1 = (out[1] && out[1].title) || ""
    this.deck2 = (out[2] && out[2].title) || ""
    this.deck3 = (out[3] && out[3].title) || ""
    this.deck4 = (out[4] && out[4].title) || ""
    this.deck5 = (out[5] && out[5].title) || ""
    this.deck6 = (out[6] && out[6].title) || ""
    this.deck7 = (out[7] && out[7].title) || ""
    this.deck8 = (out[8] && out[8].title) || ""
    this.deck9 = (out[9] && out[9].title) || ""
    this.deck10 = (out[10] && out[10].title) || ""
    this.deck11 = (out[11] && out[11].title) || ""
    this.deck12 = (out[12] && out[12].title) || ""
    this.deck13 = (out[13] && out[13].title) || ""
    this.deck14 = (out[14] && out[14].title) || ""
    this.deck15 = (out[15] && out[15].title) || ""
    this.deck16 = (out[16] && out[16].title) || ""
    this.deck17 = (out[17] && out[17].title) || ""
    this.deck18 = (out[18] && out[18].title) || ""
    this.deck19 = (out[19] && out[19].title) || ""
    // 列表内容一换就回顶部（2026-11-15 Tom）：点列表靠下的条目时其实已切换，
    // 但滚动位置还停在下半屏，看着像「没反应」。放在这个唯一出口里，一次覆盖全部入口。
    this.resetListScroll("deckList")
  },

  // 滚动复位：属性 scroll-top 不可靠（改了同值不触发），走 $element + scrollTo，
  // 与易微课程表 pages/index/modules/gesture.js 同一写法；再补一次异步兜底，
  // 防「数据刚换、节点还没排版」时 scrollTo 被后续布局覆盖。
  resetListScroll(id) {
    var self = this
    var fire = function () {
      try {
        var el = self.$element(id)
        if (el && el.scrollTo) {
          el.scrollTo({ top: 0 })
        }
      } catch (e) {}
    }
    fire()
    setTimeout(function () {
      fire()
    }, 24)
  },

  pickCat(idx) {
    if (idx === -7) {
      this.openIdList(RECENT_KEY, "最近")
      return
    }
    if (idx === -8) {
      this.openIdList(FAV_KEY, "收藏")
      return
    }
    if (idx === -9) {
      this.openSearch()
      return
    }
    if (idx === -11) {
      this.openMore()
      return
    }
    if (idx === -2) {
      if (!this.customDeck) {
        return
      }
      this.catIndex = -2
      this.applyDeckRows([{ idx: 0, title: "我的卡组", deckIndex: -1 }])
      return
    }
    this.catIndex = idx
    this.foodMode = false
    var cat = preset.categories[idx]
    var out = []
    for (var i = 0; i < preset.decks.length; i++) {
      // F01 是空占位卡组，运行时由餐饮数据接管，不显示为死项
      if (preset.decks[i].cat === cat && preset.decks[i].items && preset.decks[i].items.length >= 2) {
        out.push({ idx: out.length, title: preset.decks[i].title, deckIndex: i })
      }
    }
    // 餐饮类追加两个视图入口，不是新卡组，预设仍是 88 组
    if (cat === "餐饮") {
      out.push({ idx: out.length, title: "随便吃一道", deckIndex: -3 })
      out.push({ idx: out.length, title: "搭配抽", deckIndex: -4 })
      out.push({ idx: out.length, title: "搭配筛选", deckIndex: -6 })
      out.push({ idx: out.length, title: "自定义槽", deckIndex: -5 })
    }
    this.applyDeckRows(out)
  },

  // 固定行槽的点击入口：空槽直接返回（行高 0，理论上点不到，防御一下）
  pickCatRow(i) {
    var r = CAT_ROWS[i]
    if (!r) {
      return
    }
    this.pickCat(r.idx)
  },

  selectDeckRow(i) {
    var r = DECK_ROWS[i]
    if (!r) {
      return
    }
    if (this.addSlotMode) {
      this.addSlotFromChoice(i)
      return
    }
    this.selectDeck(r.deckIndex)
  },

  selectDeck(deckIndex) {
    if (deckIndex === -3) {
      this.openFoodCats()
      return
    }
    if (deckIndex === -4) {
      this.startCombo()
      return
    }
    if (deckIndex === -5) {
      this.openSlots()
      return
    }
    if (deckIndex === -6) {
      this.openFilters()
      return
    }
    // -10 - i 编码餐饮 L1 大类索引
    if (deckIndex <= -10) {
      var ci = -10 - deckIndex
      var fc = food.categories[ci]
      if (!fc) {
        return
      }
      var names = []
      for (var q = 0; q < fc.items.length; q++) {
        names.push(fc.items[q].name)
      }
      this.setDeck({ id: "FOOD" + ci, title: fc.short, cat: "餐饮", items: names, anim: "wheel" })
      this.foodMode = false
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    if (deckIndex < 0) {
      if (!this.customDeck) {
        return
      }
      this.setDeck(this.customDeck)
    } else {
      this.setDeck(preset.decks[deckIndex])
    }
    this.view = "main"
    this.pageTitle = "抉择"
  },

  // OR：12 类选 1 类，再在该类里 wheel 抽 1 项
  openFoodCats() {
    this.stopSpin()
    this.foodMode = true
    this.catIndex = 5
    var out = []
    for (var i = 0; i < food.categories.length; i++) {
      out.push({ idx: i, title: food.categories[i].short, deckIndex: -10 - i })
    }
    this.applyDeckRows(out)
    this.view = "decks"
    this.pageTitle = "吃什么"
  },

  // 槽位只从已有数据读取，不新增任何餐饮条目；合并用户抽前筛选见 resolveSlotPure
  resolveSlot(slot) {
    return resolveSlotPure(slot)
  },

  // AND：多槽各抽 1 项拼成一个元组，逐槽串行揭晓
  startCombo() {
    this.stopSpin()
    var raw = comboRawSlots(this.customSlots, this.hasCustomSlots)
    var slots = buildComboSlots(raw)
    this.comboTitle = this.hasCustomSlots ? "我的搭配" : food.combos[0].title
    this.comboSlots = slots
    this.compassOn = false
    this.view = "combo"
    this.pageTitle = "搭配"
    this.foodMode = false
    this.drawCombo()
  },

  drawCombo() {
    if (this.phase === "spinning") {
      // 同 draw：2 秒内防误触，超过 2 秒这次点击强制揭晓，绝不永久锁死
      if (Date.now() - spinStart >= HARD_LOCK_MS) {
        this.finishComboNow()
      }
      return
    }
    var picks = []
    for (var i = 0; i < this.comboSlots.length; i++) {
      var its = this.comboSlots[i].items
      picks.push(its.length ? its[crypto.randomInt(its.length)] : "暂无")
    }
    spinStart = Date.now()
    pending = null
    this.kickBeat()
    this.armWatchdog()
    // ↓ 起帧帧：单方法连续赋值。组合结果在点击时已定，过程共享按钮锁与 loading
    this.comboPicks = picks
    this.slotIndex = 0
    this.comboResults = []
    this.hasResult = false
    this.busy = true
    this.phase = "spinning"
    this.btnText = BTN_BUSY
    this.statusText = SPIN_TIPS[0]
    this.vibrate("short")
  },

  runSlot() {
    var slot = this.comboSlots[this.slotIndex]
    if (!slot || !slot.items.length) {
      this.finishSlot()
      return
    }
    this.slotItems = slot.items.slice(0)
    this.slotLabel = slot.label
    this.slotSpinIndex = 0
    this.slotStep = 0
    this.slotTotal = 10 + crypto.randomInt(5)
    this.buildSlotWindow()
    this.tickSlot()
  },

  buildSlotWindow() {
    var n = this.slotItems.length
    var mid = ((this.slotSpinIndex % n) + n) % n
    this.slotPrevText = this.slotItems[((mid - 1) % n + n) % n]
    this.slotMidText = this.slotItems[mid]
    this.slotNextText = this.slotItems[((mid + 1) % n + n) % n]
  },

  tickSlot() {
    var self = this
    this.slotStep = this.slotStep + 1
    this.statusText = spinTip(this.slotStep)
    // 同主抽取：末次回调不派发，槽位揭晓提前一帧同步完成
    if (this.slotStep >= this.slotTotal - 1) {
      this.finishSlot()
      return
    }
    this.slotSpinIndex = (this.slotSpinIndex + 1) % this.slotItems.length
    this.buildSlotWindow()
    var t = this.slotStep / this.slotTotal
    var delay = 45 + Math.floor(150 * t * t * t)
    this.scheduleTick(function () {
      self.tickSlot()
    }, delay)
  },

  finishSlot() {
    this.stopSpin()
    var slot = this.comboSlots[this.slotIndex]
    var out = this.comboResults.slice(0)
    out.push({ label: slot ? slot.label : "", value: this.comboPicks[this.slotIndex] || "暂无" })
    this.comboResults = out
    this.slotIndex = this.slotIndex + 1
    if (this.slotIndex < this.comboSlots.length) {
      this.runSlot()
      return
    }
    this.vibrate()
    this.commitReveal("整套重抽", "已出结果")
  },

  finishComboNow() {
    this.stopSpin()
    var out = []
    for (var i = 0; i < this.comboSlots.length; i++) {
      out.push({ label: this.comboSlots[i].label, value: this.comboPicks[i] || "暂无" })
    }
    // 同 reveal：组合结果必须与揭晓态在同一方法的连续赋值块里提交。
    // 6 个常驻槽全写一遍（空槽写空串），不调用任何会写 this 的方法。
    this.comboResults = out
    this.cR0Label = out[0] ? out[0].label : ""
    this.cR0Value = out[0] ? out[0].value : ""
    this.cR1Label = out[1] ? out[1].label : ""
    this.cR1Value = out[1] ? out[1].value : ""
    this.cR2Label = out[2] ? out[2].label : ""
    this.cR2Value = out[2] ? out[2].value : ""
    this.cR3Label = out[3] ? out[3].label : ""
    this.cR3Value = out[3] ? out[3].value : ""
    this.cR4Label = out[4] ? out[4].label : ""
    this.cR4Value = out[4] ? out[4].value : ""
    this.cR5Label = out[5] ? out[5].label : ""
    this.cR5Value = out[5] ? out[5].value : ""
    this.comboTip = "点卡片换一道"
    this.hasResult = true
    this.busy = false
    this.phase = "done"
    this.btnText = "整套重抽"
    this.statusText = "已出结果"
    pending = null
    spinStart = 0
    this.vibrate("long")
    this.pushHistory("combo")
  },

  addItem() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "加一项", fail: function () {} })
    storage.set({ key: "chinese_input_placeholder", value: "唱歌 不唱歌", fail: function () {} })
    storage.set({ key: "chinese_input_value", value: "", fail: function () {} })
    storage.set({ key: "chinese_input_maxlen", value: "24", fail: function () {} })
    storage.set({
      key: "chinese_input_return_key",
      value: ADD_RESULT_KEY,
      success: function () {
        router.push({ uri: "/pages/chinese-input" })
      },
      fail: function () {}
    })
  },

  // C12：复用 chinese-input 页的 storage 回传协议，不新增任何文本输入框。
  // 四个 return_key 分派：加一项 / 导入 / 导出确认 / 搜索关键词。
  checkInputResult() {
    var self = this
    var storage = require("@system.storage")
    var keys = [ADD_RESULT_KEY, IMPORT_RESULT_KEY, EXPORT_RESULT_KEY, SEARCH_RESULT_KEY]
    for (var i = 0; i < keys.length; i++) {
      this.readInputKey(storage, keys[i], self)
    }
  },

  readInputKey(storage, key, self) {
    storage.get({
      key: key,
      success: function (data) {
        if (!data) {
          return
        }
        storage.delete({ key: key, fail: function () {} })
        self.handleInputText(key, data)
      },
      fail: function () {}
    })
  },

  handleInputText(key, data) {
    var storage = require("@system.storage")
    if (key === SEARCH_RESULT_KEY) {
      this.searchKey = String(data || "").slice(0, 12)
      var out = []
      for (var i = 0; i < preset.decks.length && out.length < 20; i++) {
        var d = preset.decks[i]
        if (!d.items || d.items.length < 2) {
          continue
        }
        if (this.searchKey && (d.title.indexOf(this.searchKey) >= 0 || String(d.desc || "").indexOf(this.searchKey) >= 0)) {
          out.push({ idx: out.length, title: d.title, deckIndex: i })
        }
      }
      this.catIndex = -9
      this.view = "decks"
      this.pageTitle = "搜索"
      this.statusText = out.length ? ("找到" + out.length + "组") : "没有匹配"
      this.applyDeckRows(out)
      return
    }
    var parsed = this.parseText(data)
    if (!parsed.length) {
      this.statusText = "选项为空"
      return
    }
    var items = this.customItems.slice(0)
    for (var j = 0; j < parsed.length; j++) {
      if (items.indexOf(parsed[j]) < 0 && items.length < MAX_ITEMS) {
        items.push(parsed[j])
      }
    }
    this.customItems = items
    this.statusText = key === ADD_RESULT_KEY ? "已加好" : "已导入"
    this.saveDraft()
    if (key !== ADD_RESULT_KEY && items.length >= 2) {
      // 导入 / 导出确认：直接落成「我的卡组」并回主屏，不自动抽（避开 onShow 同步抽取坑）
      var deck = {
        id: "CUSTOM",
        title: "我的卡组",
        cat: "我的",
        items: items.slice(0),
        anim: items.length === 2 ? "flip" : "wheel"
      }
      this.customDeck = deck
      storage.set({ key: CUSTOM_DECK_KEY, value: JSON.stringify(deck), fail: function () {} })
      this.setDeck(deck)
      this.view = "main"
      this.pageTitle = "抉择"
      this.buildCatList()
    }
  },

  parseText(raw) {
    var parts = String(raw || "").split(/[\s,，、;；]+/)
    var out = []
    for (var i = 0; i < parts.length; i++) {
      var s = parts[i]
      if (!s || this.posOf(s) > MAX_P) {
        continue
      }
      if (out.indexOf(s) < 0) {
        out.push(s)
      }
      if (out.length >= MAX_ITEMS) {
        break
      }
    }
    return out
  },

  posOf(s) {
    var p = 0
    for (var i = 0; i < s.length; i++) {
      var c = s.charAt(i)
      if (/[\u4e00-\u9fa5]/.test(c)) {
        p = p + 1
      } else if (/[0-9A-Za-z]/.test(c)) {
        p = p + 0.55
      } else {
        p = p + 0.5
      }
    }
    return p
  },

  saveCustom() {
    if (this.customItems.length < 2) {
      this.statusText = "至少两项"
      return
    }
    var deck = {
      id: "CUSTOM",
      title: "我的卡组",
      cat: "我的",
      items: this.customItems.slice(0),
      anim: this.customItems.length === 2 ? "flip" : "wheel"
    }
    this.customDeck = deck
    var storage = require("@system.storage")
    storage.set({ key: CUSTOM_DECK_KEY, value: JSON.stringify(deck), fail: function () {} })
    this.setDeck(deck)
    this.view = "main"
    this.pageTitle = "抉择"
    this.buildCatList()
    this.draw()
  },

  clearCustom() {
    this.customItems = []
    this.saveDraft()
    this.statusText = "已清空"
  },

  saveDraft() {
    var storage = require("@system.storage")
    storage.set({ key: DRAFT_KEY, value: JSON.stringify(this.customItems), fail: function () {} })
  },

  loadDraft() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: DRAFT_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var arr = JSON.parse(data)
          if (arr && arr.length) {
            self.customItems = arr.slice(0, MAX_ITEMS)
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  loadCustomDeck() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: CUSTOM_DECK_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var deck = JSON.parse(data)
          if (deck && deck.items && deck.items.length >= 2) {
            self.customDeck = deck
            self.buildCatList()
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  // ===== C8 钉首页参数入口 =====
  // 框架 query 全库无用例，只作兜底探测；主通道是 tools.ux 写 decide_entry_params，
  // 与 chinese-input 回传同一套 storage 协议，真机可靠。ts 超时 30s 防陈旧参数误入。
  readEntryQuery() {
    var q = ""
    try {
      var pg = this.$page
      if (pg && typeof pg.query === "string") { q = pg.query }
      if (!q && router && typeof router.getState === "function") {
        var st = router.getState()
        if (st && typeof st.query === "string") { q = st.query }
      }
    } catch (e) {}
    return q
  },

  applyEntry() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: ENTRY_KEY,
      success: function (data) {
        var raw = data || self.readEntryQuery()
        if (!raw) {
          return
        }
        if (data) { storage.delete({ key: ENTRY_KEY, fail: function () {} }) }
        var q = parseQuery(raw)
        if (q.ts && Date.now() - Number(q.ts) > ENTRY_TTL) {
          return
        }
        self.applyEntryQuery(q)
      },
      fail: function () {
        var raw2 = self.readEntryQuery()
        if (raw2) { self.applyEntryQuery(parseQuery(raw2)) }
      }
    })
  },

  applyEntryQuery(q) {
    if (q.mode === "combo") {
      this.enterComboFromEntry()
      return
    }
    if (q.deck === "food") {
      this.openFoodCats()
      return
    }
    if (q.deck) {
      for (var i = 0; i < preset.decks.length; i++) {
        if (preset.decks[i].id === q.deck || preset.decks[i].title === q.deck) {
          this.setDeck(preset.decks[i])
          this.view = "main"
          this.pageTitle = "抉择"
          if (q.pick) {
            var n = parseInt(q.pick, 10)
            if (n >= 1 && n <= MAX_PICK) { this.pickCount = n; this.resolveAnim() }
          }
          return
        }
      }
    }
    if (q.pick) {
      var k = parseInt(q.pick, 10)
      if (k >= 1 && k <= MAX_PICK) { this.pickCount = k; this.resolveAnim() }
    }
  },

  // 参数入口只切视图不自动抽：避开 §7.6「onShow 里同步 draw 会把应用搞崩」
  enterComboFromEntry() {
    this.stopSpin()
    var slots = buildComboSlots(comboRawSlots(this.customSlots, this.hasCustomSlots))
    this.comboTitle = this.hasCustomSlots ? "我的搭配" : food.combos[0].title
    this.comboSlots = slots
    this.compassOn = false
    this.view = "combo"
    this.pageTitle = "搭配"
    this.foodMode = false
    this.hasResult = false
    this.busy = false
    this.phase = "idle"
    this.btnText = "整套重抽"
    this.statusText = "点下面抽取"
    this.comboTip = "点卡片换一道"
  },

  // ===== C10 历史记录 =====
  pushHistory(mode) {
    var storage = require("@system.storage")
    var results = []
    if (mode === "combo") {
      for (var i = 0; i < this.comboSlots.length; i++) {
        results.push(this.comboPicks[i] || "")
      }
    } else {
      for (var j = 0; j < this.resultLines.length; j++) {
        results.push(this.resultLines[j])
      }
      if (!results.length && this.resultText) { results.push(this.resultText) }
    }
    if (!results.length) { return }
    var rec = { results: results, deck: this.deckTitle, mode: mode, time: Date.now() }
    storage.get({
      key: HISTORY_KEY,
      success: function (data) {
        var arr = []
        try { arr = data ? JSON.parse(data) : [] } catch (e) { arr = [] }
        if (!arr || !arr.length) { arr = [] }
        arr.unshift(rec)
        if (arr.length > HISTORY_MAX) { arr = arr.slice(0, HISTORY_MAX) }
        storage.set({ key: HISTORY_KEY, value: JSON.stringify(arr), fail: function () {} })
      },
      fail: function () {}
    })
  },

  openHistory() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: HISTORY_KEY,
      success: function (data) {
        var arr = []
        try { arr = data ? JSON.parse(data) : [] } catch (e) { arr = [] }
        if (!arr || !arr.length) { arr = [] }
        var t = ["", "", "", "", "", "", "", ""]
        for (var i = 0; i < t.length && i < arr.length; i++) {
          t[i] = historyLine(arr[i])
        }
        self.h0 = t[0]
        self.h1 = t[1]
        self.h2 = t[2]
        self.h3 = t[3]
        self.h4 = t[4]
        self.h5 = t[5]
        self.h6 = t[6]
        self.h7 = t[7]
        self.view = "history"
        self.pageTitle = "历史"
        self.statusText = arr.length ? ("最近" + Math.min(arr.length, HISTORY_VIEW) + "次") : "暂无记录"
      },
      fail: function () {}
    })
  },

  clearHistory() {
    var storage = require("@system.storage")
    storage.delete({ key: HISTORY_KEY, fail: function () {} })
    this.h0 = ""
    this.h1 = ""
    this.h2 = ""
    this.h3 = ""
    this.h4 = ""
    this.h5 = ""
    this.h6 = ""
    this.h7 = ""
    this.statusText = "已清空"
  },

  closeHistory() {
    this.view = "more"
    this.pageTitle = "更多"
  },

  // ===== C11 简化动画开关 =====
  toggleSimple() {
    var next = !this.simpleAnim
    var storage = require("@system.storage")
    storage.set({ key: SIMPLE_KEY, value: next ? "1" : "0", fail: function () {} })
    this.simpleAnim = next
    this.simpleText = "简化动画 " + (next ? "开" : "关")
    this.statusText = next ? "已开简化" : "已关简化"
  },

  loadSimple() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: SIMPLE_KEY,
      success: function (data) {
        self.simpleAnim = data === "1"
        self.simpleText = "简化动画 " + (self.simpleAnim ? "开" : "关")
      },
      fail: function () {}
    })
  },

  // ===== C12 文本串导入导出（复用 chinese-input 回传协议） =====
  writeInputParams(title, value, placeholder, retKey) {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: title, fail: function () {} })
    storage.set({ key: "chinese_input_placeholder", value: placeholder, fail: function () {} })
    storage.set({ key: "chinese_input_value", value: value, fail: function () {} })
    storage.set({ key: "chinese_input_maxlen", value: "240", fail: function () {} })
    storage.set({
      key: "chinese_input_return_key",
      value: retKey,
      success: function () { router.push({ uri: "/pages/chinese-input" }) },
      fail: function () {}
    })
  },

  exportDeck() {
    var text = (this.items || []).join(" ")
    this.writeInputParams("导出卡组", text, "可复制可修改", EXPORT_RESULT_KEY)
  },

  importDeck() {
    this.writeInputParams("导入卡组", "", "唱歌 不唱歌", IMPORT_RESULT_KEY)
  },

  openSearch() {
    this.writeInputParams("搜索卡组", "", "输入卡组名", SEARCH_RESULT_KEY)
  },

  // ===== C13 最近使用 / 收藏 =====
  noteRecent(deck) {
    var id = deck && (deck.id || deck.title)
    if (!id) { return }
    var storage = require("@system.storage")
    storage.get({
      key: RECENT_KEY,
      success: function (data) {
        var arr = []
        try { arr = data ? JSON.parse(data) : [] } catch (e) { arr = [] }
        if (!arr || !arr.length) { arr = [] }
        var out = [id]
        for (var i = 0; i < arr.length && out.length < 8; i++) {
          if (arr[i] !== id) { out.push(arr[i]) }
        }
        storage.set({ key: RECENT_KEY, value: JSON.stringify(out), fail: function () {} })
      },
      fail: function () {}
    })
  },

  loadFav() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: FAV_KEY,
      success: function (data) {
        try {
          var arr = data ? JSON.parse(data) : []
          self.favIds = (arr && arr.length) ? arr.slice(0, 20) : []
        } catch (e) { self.favIds = [] }
      },
      fail: function () {}
    })
  },

  openIdList(key, title) {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: key,
      success: function (data) {
        var arr = []
        try { arr = data ? JSON.parse(data) : [] } catch (e) { arr = [] }
        if (!arr || !arr.length) { arr = [] }
        var out = []
        for (var i = 0; i < arr.length && out.length < 20; i++) {
          for (var j = 0; j < preset.decks.length; j++) {
            if ((preset.decks[j].id === arr[i] || preset.decks[j].title === arr[i]) &&
                preset.decks[j].items && preset.decks[j].items.length >= 2) {
              out.push({ idx: out.length, title: preset.decks[j].title, deckIndex: j })
              break
            }
          }
        }
        self.catIndex = key === RECENT_KEY ? -7 : -8
        self.view = "decks"
        self.pageTitle = title
        self.statusText = out.length ? ("共" + out.length + "组") : "暂无卡组"
        self.applyDeckRows(out)
      },
      fail: function () {}
    })
  },

  toggleFav() {
    var id = this.currentDeck && (this.currentDeck.id || this.currentDeck.title)
    if (!id) { return }
    var list = (this.favIds || []).slice(0)
    var at = list.indexOf(id)
    var added = at < 0
    if (added) { list.unshift(id) } else { list.splice(at, 1) }
    if (list.length > 20) { list = list.slice(0, 20) }
    var storage = require("@system.storage")
    storage.set({ key: FAV_KEY, value: JSON.stringify(list), fail: function () {} })
    this.favIds = list
    this.favText = added ? "取消收藏" : "收藏本组"
    this.statusText = added ? "已收藏" : "已取消"
  },

  openMore() {
    this.stopSpin()
    var id = this.currentDeck && (this.currentDeck.id || this.currentDeck.title)
    this.simpleText = "简化动画 " + (this.simpleAnim ? "开" : "关")
    this.favText = (id && (this.favIds || []).indexOf(id) >= 0) ? "取消收藏" : "收藏本组"
    this.view = "more"
    this.pageTitle = "更多"
  },

  closeMore() {
    this.view = "decks"
    this.pageTitle = "卡组"
    this.catIndex = -1
    this.buildCatList()
  },

  // ===== C14 多人结果拆页（k>=5，每页 4 行） =====
  flipPage() {
    if (this.pageCount <= 1 || this.phase !== "done") { return }
    var next = (this.pageIndex + 1) % this.pageCount
    var base = next * 4
    var l = ["", "", "", ""]
    for (var i = 0; i < 4; i++) {
      l[i] = this.resultLines[base + i] || ""
    }
    this.pageIndex = next
    this.line1 = l[0]
    this.line2 = l[1]
    this.line3 = l[2]
    this.line4 = l[3]
    this.lineHot1 = !!l[0]
    this.lineHot2 = !!l[1]
    this.lineHot3 = !!l[2]
    this.lineHot4 = !!l[3]
    this.statusText = "第" + (next + 1) + "页 共" + this.pageCount + "页"
  },

  // B4「换一道」：只改目标槽的 value，其余 5 槽连同 label 一律原样回写。
  // 单方法连续赋值块，不调用任何会写 this 的方法（真机 JSC §7.8）。
  replaceSlot(i) {
    if (this.view !== "combo" || !this.hasResult) {
      return
    }
    if (i < 0 || i >= this.comboSlots.length) {
      return
    }
    var its = this.comboSlots[i].items
    if (!its || !its.length) {
      return
    }
    var next = repickSlot(its, this.comboPicks[i])
    this.comboPicks[i] = next
    this.cR0Value = i === 0 ? next : this.cR0Value
    this.cR1Value = i === 1 ? next : this.cR1Value
    this.cR2Value = i === 2 ? next : this.cR2Value
    this.cR3Value = i === 3 ? next : this.cR3Value
    this.cR4Value = i === 4 ? next : this.cR4Value
    this.cR5Value = i === 5 ? next : this.cR5Value
    this.statusText = "换了一道"
    this.pushHistory("combo")
  },

  // B5 抽前筛选：四行各自循环取值，屏显字段与 userFilter 在同一方法里一起写
  openFilters() {
    this.stopSpin()
    this.comboSlots = buildComboSlots(comboRawSlots(this.customSlots, this.hasCustomSlots))
    this.f0Text = filterLabel(0, userFilter["口味"])
    this.f1Text = filterLabel(1, userFilter["荤素"])
    this.f2Text = filterLabel(2, userFilter["冷热"])
    this.f3Text = filterLabel(3, userFilter["场景"])
    this.filterEchoText = filterEcho()
    this.view = "filters"
    this.pageTitle = "筛选"
  },

  cycleFilter(i) {
    var vals = FILTER_VALUES[i]
    if (!vals) {
      return
    }
    var cur = userFilter[FILTER_KEYS[i]] || ""
    var at = vals.indexOf(cur)
    userFilter[FILTER_KEYS[i]] = vals[(at + 1) % vals.length]
    this.f0Text = filterLabel(0, userFilter["口味"])
    this.f1Text = filterLabel(1, userFilter["荤素"])
    this.f2Text = filterLabel(2, userFilter["冷热"])
    this.f3Text = filterLabel(3, userFilter["场景"])
    this.filterEchoText = filterEcho()
  },

  finishFilters() {
    this.comboSlots = buildComboSlots(comboRawSlots(this.customSlots, this.hasCustomSlots))
    this.comboTitle = this.hasCustomSlots ? "我的搭配" : food.combos[0].title
    this.view = "combo"
    this.pageTitle = "搭配"
    this.drawCombo()
  },

  closeFilters() {
    this.comboSlots = buildComboSlots(comboRawSlots(this.customSlots, this.hasCustomSlots))
    this.view = "combo"
    this.pageTitle = "搭配"
    this.btnText = "整套重抽"
    this.statusText = "点下面抽取"
    this.comboTip = "点卡片换一道"
  },

  // B6 自定义槽位：增删即时写 storage，绑定已有餐饮类目 / 预设卡组
  openSlots() {
    this.stopSpin()
    var t = slotRowTexts(this.customSlots || [])
    this.sl0 = t[0]
    this.sl1 = t[1]
    this.sl2 = t[2]
    this.sl3 = t[3]
    this.sl4 = t[4]
    this.sl5 = t[5]
    this.addSlotMode = false
    this.view = "slots"
    this.pageTitle = "槽位"
    this.statusText = "点行删除"
  },

  delSlot(i) {
    var list = (this.customSlots || []).slice(0)
    if (i < 0 || i >= list.length || list.length <= 1) {
      return
    }
    list.splice(i, 1)
    var t = slotRowTexts(list)
    this.customSlots = list
    this.sl0 = t[0]
    this.sl1 = t[1]
    this.sl2 = t[2]
    this.sl3 = t[3]
    this.sl4 = t[4]
    this.sl5 = t[5]
    this.statusText = "已删一槽"
    this.saveSlots()
  },

  openAddSlot() {
    var out = []
    for (var i = 0; i < food.categories.length && out.length < 16; i++) {
      out.push({
        idx: out.length,
        title: food.categories[i].short,
        deckIndex: -20 - i,
        addRef: "deck:food/" + food.categories[i].name
      })
    }
    var ids = ["E02", "E01", "F02", "D01"]
    for (var j = 0; j < ids.length && out.length < 20; j++) {
      for (var k = 0; k < preset.decks.length; k++) {
        if (preset.decks[k].id === ids[j]) {
          out.push({
            idx: out.length,
            title: preset.decks[k].title,
            deckIndex: -30 - j,
            addRef: "deck:preset/" + ids[j]
          })
          break
        }
      }
    }
    this.addSlotMode = true
    this.catIndex = 5
    this.view = "decks"
    this.pageTitle = "加一槽"
    this.applyDeckRows(out)
  },

  addSlotFromChoice(i) {
    var r = DECK_ROWS[i]
    if (!r || !r.addRef) {
      return
    }
    var list = (this.customSlots || []).slice(0)
    if (list.length >= MAX_SLOTS) {
      this.statusText = "最多六槽"
      return
    }
    if (!this.hasCustomSlots) {
      var base = food.combos[0].slots
      for (var b = 0; b < base.length && list.length < MAX_SLOTS - 1; b++) {
        list.push({ label: base[b].label, ref: base[b].ref, filter: base[b].filter })
      }
    }
    list.push({ label: refShort(r.addRef), ref: r.addRef, filter: {} })
    var t = slotRowTexts(list)
    this.customSlots = list
    this.hasCustomSlots = true
    this.sl0 = t[0]
    this.sl1 = t[1]
    this.sl2 = t[2]
    this.sl3 = t[3]
    this.sl4 = t[4]
    this.sl5 = t[5]
    this.addSlotMode = false
    this.view = "slots"
    this.pageTitle = "槽位"
    this.statusText = "已加一槽"
    this.saveSlots()
  },

  useDefaultSlots() {
    var t = slotRowTexts([])
    this.customSlots = []
    this.hasCustomSlots = false
    this.sl0 = t[0]
    this.sl1 = t[1]
    this.sl2 = t[2]
    this.sl3 = t[3]
    this.sl4 = t[4]
    this.sl5 = t[5]
    this.statusText = "用回默认"
    this.saveSlots()
  },

  closeSlots() {
    this.addSlotMode = false
    this.view = "decks"
    this.pageTitle = "卡组"
    this.catIndex = 5
    this.pickCat(5)
  },

  saveSlots() {
    var storage = require("@system.storage")
    storage.set({
      key: SLOT_KEY,
      value: JSON.stringify({ list: this.customSlots, active: this.hasCustomSlots }),
      fail: function () {}
    })
  },

  loadSlots() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: SLOT_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var o = JSON.parse(data)
          if (o && o.active && o.list && o.list.length) {
            var t = slotRowTexts(o.list)
            self.customSlots = o.list.slice(0, MAX_SLOTS)
            self.hasCustomSlots = true
            self.sl0 = t[0]
            self.sl1 = t[1]
            self.sl2 = t[2]
            self.sl3 = t[3]
            self.sl4 = t[4]
            self.sl5 = t[5]
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  // 分组结果页：回主屏重抽（动画仍可见），结果语义与主屏完全一致
  drawPartitionAgain() {
    this.view = "main"
    this.pageTitle = "抉择"
    this.phase = "idle"
    this.hasResult = false
    this.busy = false
    this.btnText = PICK_LABEL[0]
    this.statusText = "点下面分组"
    pending = null
    spinStart = 0
    this.draw()
  },

  closeGroups() {
    this.view = "main"
    this.pageTitle = "抉择"
    this.phase = "idle"
    this.hasResult = false
    this.busy = false
    this.btnText = PICK_LABEL[0]
    this.statusText = "点下面抽取"
    pending = null
    spinStart = 0
  },

  goBack() {
    if (this.view === "history") {
      this.view = "more"
      this.pageTitle = "更多"
      return
    }
    if (this.view === "more") {
      this.closeMore()
      return
    }
    if (this.view === "filters") {
      this.closeFilters()
      return
    }
    if (this.view === "slots") {
      this.closeSlots()
      return
    }
    if (this.view === "groups") {
      this.closeGroups()
      return
    }
    if (this.view === "combo") {
      this.stopSpin()
      this.phase = "idle"
      this.hasResult = false
      this.busy = false
      this.line1 = ""
      this.line2 = ""
      this.line3 = ""
      this.line4 = ""
      this.btnText = "抽一个"
      pending = null
      spinStart = 0
      this.view = "decks"
      this.pageTitle = "卡组"
      this.pickCat(5)
      return
    }
    if (this.view === "decks") {
      if (this.foodMode) {
        this.foodMode = false
        this.pickCat(5)
        return
      }
      if (this.catIndex !== -1) {
        this.catIndex = -1
        return
      }
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    if (this.view === "custom") {
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    this.stopSpin()
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  /* 卡组浮层用绝对定位挂在本层，必须有定位上下文 */
  position: relative;
  padding: 32px 12px 16px 12px;
}

/* 一体返回胶囊：与易微课程表设置页 common/header.css 的 .hdr 段同源。
   居中在 .hdr 上做，整颗胶囊都是点击区（30×30 → 约 106×40），
   flex-shrink:0 防止页头被压成 0 高导致返回键消失（课程表历史坑）。 */
.hdr {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.hdr-pill {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 40px;
  padding: 0 14px;
  border-radius: 20px;
  flex-shrink: 0;
}

.hdr-pill-ic {
  width: 20px;
  height: 20px;
  margin-right: 4px;
  object-fit: contain;
}

.hdr-pill-t {
  font-size: 28px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.view {
  flex-direction: column;
  width: 100%;
  flex: 1;
  /* 同上：首帧 display:none 的子树，切 flex 时 flex:1 拿不到父高度 → 给死高度兜底 */
  height: 408px;
}

.deck-head {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.deck-name {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

/* 罗盘：盘面文字固定水平排布，只有指针帧在动 */
.compass-box {
  flex-direction: column;
  width: 100%;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.dial {
  position: relative;
  border-width: 2px;
  border-color: #444444;
  justify-content: center;
  align-items: center;
}

.dial-tick {
  position: absolute;
  width: 48px;
  height: 34px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.dial-tick-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.needle {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.compass-result {
  width: 100%;
  height: 60px;
  justify-content: center;
  align-items: center;
}

.compass-result-text {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
  text-align: center;
  lines: 2;
}

/* 旧 .multi-result / .multi-line（for 数组渲染）已删：
   真机 JSC 下 for 数组更新不重绘，多结果改由常驻 .line 三行承载。 */

/* 组合卡：字段标签 24 字段值 28 纵向排版，不用分隔符 */
.combo-stage {
  flex-direction: column;
  width: 100%;
  height: 180px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.combo-slot-label {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.combo-card {
  flex-direction: column;
  width: 100%;
  border-radius: 14px;
  padding: 8px 8px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.combo-tip {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
  margin-bottom: 4px;
}

.combo-card-title {
  width: 100%;
  font-size: 30px;
  font-weight: bold;
  line-height: 40px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.combo-field {
  flex-direction: column;
  width: 100%;
  height: 72px;
  border-radius: 8px;
  padding: 0 8px;
  justify-content: center;
  margin-bottom: 4px;
}

.combo-field-label {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  lines: 1;
}

.combo-field-value {
  width: 100%;
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

.pick-row {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.pick-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.stage {
  position: relative;
  flex-direction: column;
  width: 100%;
  height: 138px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.spin-box {
  flex-direction: column;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.spin-row {
  width: 100%;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
}

.spin-text {
  font-size: 28px;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

/* 常驻覆盖层：不参与 display 切换，永远参与首次渲染，保证 {{ resultText }} 的绑定依赖存在 */
.result-box {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 138px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 过程行层：与 result-box 同级绝对覆盖，两者互不占布局高度。
   单行结果用 44px 大字（result-box），多行结果与抽取过程用 28px 三行（本层）。
   28px × 6P × 0.958 ≈ 161px < 168px 内容宽，菜名不截断；
   3 行 × 34px = 102px，胶囊屏舞台 126px 仍放得下。 */
.line-box {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 行高 30 + 上下各 2 间距 = 34，三行总高仍 102px，块重心不随内容变化而跳动。
   落定行由模板挂 theme.cardLight 底色（未定行 transparent），
   于是「逐条落定」在视觉上就是逐条出现的结果条，滚动中永远只是灰字。 */
.line {
  width: 100%;
  height: 30px;
  margin: 0;
  flex-shrink: 0;
  border-radius: 8px;
  font-size: 28px;
  line-height: 30px;
  text-align: center;
  lines: 1;
}

.result-text {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
  text-align: center;
  lines: 2;
}

.main-btn {
  width: 100%;
  height: 56px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.main-btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

.sub-row {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.sub-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.status-line {
  width: 100%;
  height: 34px;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

/* 真机 1.0.84 复核失败（2026-11-15，Tom 反馈「标题出来了、下面一片空、点不动」）：
   本子树首帧是 display:none，切到 flex 时滚窗拿不到父级 flex 高度，
   <scroll> 视口量成 0 → 行都在、但看不见也点不到（模拟器宽容，故漏检）。
   这里改显式像素高度，不再依赖任何父级 flex 链。屏 490，顶部返回胶囊占 ~74。 */
.list-scroll {
  flex-direction: column;
  width: 100%;
  height: 408px;
}

.list-row {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  padding: 0 8px;
  justify-content: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.list-text {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

.edit-tip {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 8px;
}

.item-scroll {
  flex-direction: column;
  width: 100%;
  flex: 1;
  min-height: 100px;
  margin-bottom: 10px;
}

.item-row {
  width: 100%;
  height: 44px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.item-text {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

/* 大屏放大一体返回胶囊，与易微课程表设置页保持一致 */
@media (shape: rect), (shape: circle) {
  .hdr-pill {
    height: 48px;
    padding: 0 18px;
    border-radius: 24px;
  }
  .hdr-pill-ic {
    width: 24px;
    height: 24px;
    margin-right: 6px;
  }
  .hdr-pill-t {
    font-size: 30px;
    line-height: 40px;
  }
}

@media (shape: circle) {
  .page {
    padding: 24px 20px 16px 20px;
  }
  .stage {
    height: 150px;
  }
  .compass-box {
    margin-bottom: 0;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 24px 12px 12px 12px;
  }
  .stage {
    height: 126px;
  }
}

/* 分组结果卡（P2 A1）：常驻浮层，空槽高度归零，不切 display / 不用 if / 不用 for 数组 */
.overlay {
  flex-direction: column;
  width: 100%;
  height: 408px;
}

.grp-title {
  width: 100%;
  font-size: 30px;
  line-height: 40px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.grp-scroll {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.grp-card {
  flex-direction: column;
  width: 100%;
  border-radius: 12px;
  padding: 4px 8px;
  justify-content: center;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.grp-name {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.grp-member {
  width: 100%;
  font-size: 28px;
  line-height: 30px;
  text-align: center;
  lines: 1;
}

.grp-odd {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}
</style>
