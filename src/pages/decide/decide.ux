          <text class="list-text" style="color: {{ theme.text }}">{{ deck9 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(10)"
             style="background-color: {{ theme.card }}; height: {{ deck10 ? '52px' : '0' }}; margin-bottom: {{ deck10 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck10 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(11)"
             style="background-color: {{ theme.card }}; height: {{ deck11 ? '52px' : '0' }}; margin-bottom: {{ deck11 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck11 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(12)"
