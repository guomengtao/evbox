<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">{{ pageTitle }}</text>
      <div class="header-placeholder"></div>
    </div>

    <!-- 主屏：一屏只做抽取这件事 -->
    <div class="view" style="display: {{ view === 'main' ? 'flex' : 'none' }}">
      <div class="deck-head" onclick="openDecks" style="background-color: {{ theme.card }}">
        <text class="deck-name" style="color: {{ theme.text }}">{{ deckTitle }}</text>
      </div>

      <!-- 罗盘：盘面文字固定，只换一根指针，点盘面即抽 -->
      <div class="compass-box" onclick="draw" style="display: {{ compassOn ? 'flex' : 'none' }}">
        <div class="dial" style="width: {{ dialSize }}px; height: {{ dialSize }}px; border-radius: {{ dialRadius }}px; background-color: {{ theme.card }}">
          <div class="dial-tick" for="{{ dialLabels }}"
               style="left: {{ $item.left }}px; top: {{ $item.top }}px; background-color: {{ $item.hit ? theme.accent : 'transparent' }}">
            <text class="dial-tick-text" style="color: {{ $item.hit ? theme.bg : theme.text }}">{{ $item.text }}</text>
          </div>
          <image class="needle" src="{{ needleSrc }}"></image>
        </div>
        <div class="compass-result" style="display: {{ phase === 'done' ? 'flex' : 'none' }}">
          <text class="compass-result-text" style="color: {{ theme.accent }}">{{ resultText }}</text>
        </div>
      </div>

      <div class="stage" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <div class="spin-box" style="display: {{ phase === 'done' ? 'none' : 'flex' }}">
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ prevText }}</text>
          </div>
          <div class="spin-row" style="background-color: {{ theme.cardLight }}">
            <text class="spin-text" style="color: {{ theme.text }}">{{ midText }}</text>
          </div>
          <div class="spin-row" style="display: {{ flipOn ? 'none' : 'flex' }}">
            <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ nextText }}</text>
          </div>
        </div>
        <div class="result-box" style="display: {{ phase === 'done' ? 'flex' : 'none' }}">
          <text class="result-text" style="display: {{ multiOn ? 'none' : 'flex' }}; color: {{ theme.accent }}">{{ resultText }}</text>
          <div class="multi-result" style="display: {{ multiOn ? 'flex' : 'none' }}">
            <text class="multi-line" for="{{ resultLines }}" style="color: {{ theme.text }}">{{ $item }}</text>
          </div>
        </div>
      </div>

      <div class="pick-row" onclick="changePick" style="display: {{ pickRowOn ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <text class="pick-text" style="color: {{ theme.text }}">{{ pickText }}</text>
      </div>

      <div class="main-btn" onclick="draw" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.accent }}">
        <text class="main-btn-text" style="color: {{ theme.bg }}">{{ btnText }}</text>
      </div>

      <div class="sub-row" onclick="openDecks" style="display: {{ compassOn || pickRowOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">换卡组</text>
      </div>
      <div class="sub-row" onclick="openCustom" style="display: {{ compassOn ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">我的卡组</text>
      </div>

      <text class="status-line" style="display: {{ compassOn ? 'none' : 'flex' }}; color: {{ theme.textSecondary }}">{{ statusText }}</text>
    </div>

    <!-- 卡组列表：先选类，再选组 -->
    <div class="view" style="display: {{ view === 'decks' ? 'flex' : 'none' }}">
      <scroll class="list-scroll" scroll-y="true" style="display: {{ catIndex < 0 ? 'flex' : 'none' }}">
        <div class="list-row" for="{{ catList }}" onclick="pickCat($item.idx)"
             style="background-color: {{ theme.card }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ $item.name }}</text>
        </div>
      </scroll>
      <scroll class="list-scroll" scroll-y="true" style="display: {{ catIndex < 0 ? 'none' : 'flex' }}">
        <div class="list-row" for="{{ deckList }}" onclick="selectDeck($item.deckIndex)"
             style="background-color: {{ theme.card }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ $item.title }}</text>
        </div>
      </scroll>
    </div>

    <!-- 自定义卡组：逐项添加，保存即抽 -->
    <div class="view" style="display: {{ view === 'custom' ? 'flex' : 'none' }}">
      <text class="edit-tip" style="color: {{ theme.textSecondary }}">已加选项</text>
      <scroll class="item-scroll" scroll-y="true">
        <div class="item-row" for="{{ customItems }}" style="background-color: {{ theme.card }}">
          <text class="item-text" style="color: {{ theme.text }}">{{ $item }}</text>
        </div>
      </scroll>

      <div class="main-btn" onclick="addItem" style="background-color: {{ theme.accent }}">
        <text class="main-btn-text" style="color: {{ theme.bg }}">加一项</text>
      </div>
      <div class="main-btn" onclick="saveCustom" style="background-color: {{ theme.cardLight }}">
        <text class="main-btn-text" style="color: {{ theme.text }}">保存并抽</text>
      </div>
      <div class="sub-row" onclick="clearCustom" style="background-color: {{ theme.card }}">
        <text class="sub-text" style="color: {{ theme.text }}">清空重来</text>
      </div>

      <text class="status-line" style="color: {{ theme.textSecondary }}">{{ statusText }}</text>
    </div>

    <!-- 组合抽取：逐槽串行，最后出汇总卡 -->
    <div class="view" style="display: {{ view === 'combo' ? 'flex' : 'none' }}">
      <div class="combo-stage" style="display: {{ phase === 'done' ? 'none' : 'flex' }}; background-color: {{ theme.card }}">
        <text class="combo-slot-label" style="color: {{ theme.textSecondary }}">{{ slotLabel }}</text>
        <div class="spin-row">
          <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ slotPrevText }}</text>
        </div>
        <div class="spin-row" style="background-color: {{ theme.cardLight }}">
          <text class="spin-text" style="color: {{ theme.text }}">{{ slotMidText }}</text>
        </div>
        <div class="spin-row">
          <text class="spin-text" style="color: {{ theme.textSecondary }}">{{ slotNextText }}</text>
        </div>
      </div>

      <div class="combo-card" style="display: {{ phase === 'done' ? 'flex' : 'none' }}; background-color: {{ theme.card }}">
        <text class="combo-card-title" style="color: {{ theme.text }}">{{ comboTitle }}</text>
        <div class="combo-field" for="{{ comboResults }}" style="background-color: {{ theme.cardLight }}">
          <text class="combo-field-label" style="color: {{ theme.textSecondary }}">{{ $item.label }}</text>
          <text class="combo-field-value" style="color: {{ theme.text }}">{{ $item.value }}</text>
        </div>
      </div>

      <div class="main-btn" onclick="drawCombo" style="background-color: {{ theme.accent }}">
        <text class="main-btn-text" style="color: {{ theme.bg }}">{{ btnText }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var preset = require("../../data/decks/preset-decks.json")
var food = require("../../data/decks/preset-food.json")

var CUSTOM_DECK_KEY = "decide_custom_deck"
var DRAFT_KEY = "decide_draft_items"
var ADD_RESULT_KEY = "decide_add_item"
var MAX_ITEMS = 30
var MAX_P = 6
// 三行 24px 结果 102px 不超胶囊屏舞台 126px，四个及以上留 P2 拆页
var MAX_PICK = 3
var FRAMES = 24
var FRAME_STEP = 15
var PICK_LABEL = ["抽一个", "抽两个", "抽三个"]
// 动画定时器句柄放在模块作用域：private 里的值会被框架做响应式包装，
// 对 setTimeout 返回的句柄赋值/读取可能抛异常，导致动画永远停在首帧。
// JSC 实测（2026-11-14）：抽取按钮停在「抽取中」不进 done 即由此引起。
var spinTimer = null
// Vela 模拟器 JSC 实测：动画定时器回调链内调用 @system.vibrator 会让 vapp 退出，
// 真机复核通过后再置 true（方案 §4.2 的咔哒手感属 P3 增强，不阻塞抽取）
var VIBRATE_ENABLED = false
// Vela 模拟器 JSC：触摸事件回调里安排的 setTimeout 回调不派发（onReady 里安排则可以）。
// 默认同步揭晓保证功能可用；完整逐帧动画代码保留，真机复核后把此开关置 true。
var ANIM_ASYNC = false
// Vela JSC 下动画帧必须持续改一个已渲染的顶层文本才会重绘并推进定时器链；
// 用状态行的 loading 省略号承载，最长 5.5P 满足 ev-six 一行 ≤6P
var SPIN_TIPS = ["正在抽取", "正在抽取。", "正在抽取。。", "正在抽取。。。"]
function spinTip(step) {
  return SPIN_TIPS[step % 4]
}
// 罗盘上限由 ev-six 24px 下限与标签留白共同决定，圆屏 8 胶囊屏 4
var COMPASS_LIMIT_CIRCLE = 8
var COMPASS_LIMIT_PILL = 4

// 分类屏显短名：原名五到六字超过 168px 容器，按 ev-six 删字不缩字号
var CAT_SHORT = ["二元", "方位", "学科", "数字", "果蔬", "餐饮", "日常", "娱乐", "社交", "运动", "心情", "模板"]

export default {
  private: {
    iconTheme: "dark",
    theme: store.DEFAULT_THEME,
    view: "main",
    pageTitle: "抉择",
    phase: "idle",
    animKind: "wheel",
    currentDeck: null,
    customDeck: null,
    deckTitle: "要不要",
    items: ["要", "不要"],
    windowItems: [],
    // 滚动项用顶层字段绑定：JSC 下 for 数组更新不触发重绘，
    // 页面静止会让 setTimeout 链停摆（2026-11-14 胶囊屏实测）
    prevText: "",
    midText: "要",
    nextText: "不要",
    flipOn: false,
    resultText: "",
    resultIndex: 0,
    spinIndex: 0,
    spinStep: 0,
    totalSteps: 20,
    btnText: "抽一个",
    statusText: "点下面抽取",
    catIndex: -1,
    catList: [],
    deckList: [],
    customItems: [],
    compassOn: false,
    screenShape: "",
    dialSize: 160,
    dialRadius: 80,
    dialLabels: [],
    dialAngles: [],
    needleFrame: 0,
    needleSrc: "/common/icons/compass/needle_00.png",
    targetFrame: 0,
    pickCount: 1,
    pickText: "抽一个",
    pickRowOn: false,
    resultIndices: [],
    resultLines: [],
    multiOn: false,
    foodMode: false,
    comboTitle: "午饭搭配",
    comboSlots: [],
    comboPicks: [],
    comboResults: [],
    slotIndex: 0,
    slotLabel: "",
    slotItems: [],
    slotWindow: [],
    slotPrevText: "",
    slotMidText: "",
    slotNextText: "",
    slotSpinIndex: 0,
    slotStep: 0,
    slotTotal: 12
  },

  onInit() {
    this.applyTheme()
    this.buildCatList()
    this.setDeck(preset.decks[0])
    this.readShape()
    this.loadDraft()
    this.loadCustomDeck()
  },

  readShape() {
    var self = this
    try {
      require("@system.device").getInfo({
        success: function (data) {
          self.screenShape = data.screenShape || ""
          self.resolveAnim()
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  onShow() {
    this.applyTheme()
    this.checkInputResult()
  },

  onHide() {
    // 中断动画不改变结果，结果在 draw 时已先定
    if (this.phase === "spinning") {
      this.stopSpin()
      if (this.view === "combo") {
        this.finishComboNow()
      } else {
        this.finishDraw()
      }
    }
  },

  onDestroy() {
    this.stopSpin()
  },

  applyTheme() {
    var self = this
    store.getTheme(function (t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
    })
  },

  buildCatList() {
    var out = []
    for (var i = 0; i < preset.categories.length; i++) {
      out.push({ idx: i, name: CAT_SHORT[i] || preset.categories[i] })
    }
    if (this.customDeck) {
      out.push({ idx: -2, name: "我的" })
    }
    this.catList = out
  },

  setDeck(deck) {
    if (!deck || !deck.items || deck.items.length < 2) {
      return
    }
    this.stopSpin()
    this.currentDeck = deck
    this.deckTitle = deck.title
    this.items = deck.items.slice(0)
    this.pickCount = 1
    this.phase = "idle"
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.resultIndices = []
    this.resultIndex = 0
    this.spinIndex = 0
    this.btnText = "抽一个"
    this.resolveAnim()
    this.buildWindow()
  },

  // auto 策略：抽取规则优先，再判语义与项数上限；不满足一律回退 wheel
  resolveAnim() {
    var limit = (this.screenShape === "circle") ? COMPASS_LIMIT_CIRCLE : COMPASS_LIMIT_PILL
    var want = this.currentDeck && this.currentDeck.anim === "compass" && this.pickCount === 1
    var ok = want && this.items.length >= 2 && this.items.length <= limit
    if (ok) {
      for (var i = 0; i < this.items.length; i++) {
        if (this.posOf(this.items[i]) > 2) {
          ok = false
          break
        }
      }
    }
    this.compassOn = ok
    if (ok) {
      this.animKind = "compass"
      this.dialSize = (this.screenShape === "circle") ? 240 : 160
      this.dialRadius = this.dialSize / 2
      this.buildDial()
    } else {
      var flip = this.currentDeck && this.currentDeck.anim === "flip" && this.items.length === 2 && this.pickCount === 1
      this.animKind = flip ? "flip" : "wheel"
    }
    this.pickRowOn = !ok && this.items.length >= 3
    this.pickText = PICK_LABEL[this.pickCount - 1] || "抽一个"
    this.statusText = ok ? "点盘面抽取" : "点下面抽取"
  },

  // 刻度角度量化到 15 度帧，保证指针必然精确指向某个标签中心
  buildDial() {
    var n = this.items.length
    var cx = this.dialSize / 2
    var r = cx - 30
    var labels = []
    var angles = []
    for (var i = 0; i < n; i++) {
      var deg = (Math.round((i * 360 / n) / FRAME_STEP) * FRAME_STEP) % 360
      var rad = deg * Math.PI / 180
      angles.push(deg / FRAME_STEP)
      labels.push({
        text: this.items[i],
        left: Math.round(cx + r * Math.sin(rad) - 24),
        top: Math.round(cx - r * Math.cos(rad) - 17),
        hit: false
      })
    }
    this.dialAngles = angles
    this.dialLabels = labels
    this.updateNeedle(0, -1)
  },

  // 指针不用 transform rotate，全库无该能力用例，改用预渲染帧图换 src
  updateNeedle(frame, hitIndex) {
    this.needleFrame = frame
    var s = frame < 10 ? "0" + frame : "" + frame
    this.needleSrc = "/common/icons/compass/needle_" + s + ".png"
    var out = []
    for (var i = 0; i < this.dialLabels.length; i++) {
      var hit = hitIndex >= 0 ? (i === hitIndex) : (this.dialAngles[i] === frame)
      out.push({
        text: this.dialLabels[i].text,
        left: this.dialLabels[i].left,
        top: this.dialLabels[i].top,
        hit: hit
      })
    }
    this.dialLabels = out
  },

  // 单次内强制不重复，replace 固定 false
  pickIndices() {
    var pool = []
    for (var i = 0; i < this.items.length; i++) {
      pool.push(i)
    }
    for (var j = pool.length - 1; j > 0; j--) {
      var t = Math.floor(Math.random() * (j + 1))
      var tmp = pool[j]
      pool[j] = pool[t]
      pool[t] = tmp
    }
    return pool.slice(0, Math.min(this.pickCount, pool.length))
  },

  changePick() {
    if (this.phase === "spinning") {
      return
    }
    var max = Math.min(MAX_PICK, this.items.length - 1)
    this.pickCount = this.pickCount >= max ? 1 : this.pickCount + 1
    this.phase = "idle"
    this.resultText = ""
    this.resultLines = []
    this.multiOn = false
    this.btnText = "抽一次"
    this.resolveAnim()
  },

  draw() {
    if (this.phase === "spinning") {
      // 兜底：JSC 定时器链若在动画中途停摆，再次点击直接同步揭晓已定结果
      this.stopSpin()
      this.finishDraw()
      return
    }
    if (!this.items || this.items.length < 2) {
      this.statusText = "至少两项"
      return
    }
    this.stopSpin()
    // 结果先定后演，中断动画不改变结果
    this.resultIndices = this.pickIndices()
    this.resultIndex = this.resultIndices[0]
    this.resultLines = []
    this.multiOn = false
    this.resultText = ""
    this.spinStep = 0
    this.spinIndex = 0
    this.phase = "spinning"
    this.btnText = "抽取中"
    this.statusText = "正在抽取"
    if (this.compassOn) {
      this.targetFrame = this.dialAngles[this.resultIndex]
      this.totalSteps = FRAMES + this.targetFrame
      this.updateNeedle(0, -1)
      if (ANIM_ASYNC) {
        this.tickCompass()
      } else {
        this.finishDraw()
      }
    } else {
      this.totalSteps = 18 + Math.floor(Math.random() * 6)
      this.buildWindow()
      if (ANIM_ASYNC) {
        this.tick()
      } else {
        this.finishDraw()
      }
    }
  },

  tick() {
    var self = this
    var n = this.items.length
    this.spinStep = this.spinStep + 1
    this.statusText = spinTip(this.spinStep)
    // 末次回调不派发：揭晓提前到最后一个可靠帧内同步完成
    if (this.spinStep >= this.totalSteps - 1) {
      this.finishDraw()
      return
    }
    this.spinIndex = (this.spinIndex + 1) % n
    this.buildWindow()
    var t = this.spinStep / this.totalSteps
    var delay = 40 + Math.floor(190 * t * t * t)
    this.scheduleTick(function () {
      self.tick()
    }, delay)
  },

  tickCompass() {
    var self = this
    this.spinStep = this.spinStep + 1
    this.statusText = spinTip(this.spinStep)
    // 末次回调不派发：揭晓提前到最后一个可靠帧内同步完成
    if (this.spinStep >= this.totalSteps - 1) {
      this.finishDraw()
      return
    }
    this.updateNeedle((this.needleFrame + 1) % FRAMES, -1)
    var t = this.spinStep / this.totalSteps
    var delay = 35 + Math.floor(190 * t * t * t)
    this.scheduleTick(function () {
      self.tickCompass()
    }, delay)
  },

  // 定时器不可用时直接揭晓：结果在 draw 阶段已确定，跳过动画不改变结果
  scheduleTick(fn, delay) {
    try {
      spinTimer = setTimeout(fn, delay)
      if (!spinTimer) {
        throw new Error("timer unavailable")
      }
    } catch (e) {
      spinTimer = null
      this.abortAnim()
    }
  },

  abortAnim() {
    if (this.view === "combo") {
      this.finishComboNow()
    } else {
      this.finishDraw()
    }
  },

  finishDraw() {
    this.stopSpin()
    this.spinIndex = this.resultIndex
    if (this.compassOn) {
      this.updateNeedle(this.targetFrame, this.resultIndex)
      this.resultText = this.items[this.resultIndex]
    } else if (this.resultIndices.length > 1) {
      var lines = []
      for (var i = 0; i < this.resultIndices.length; i++) {
        lines.push(this.items[this.resultIndices[i]])
      }
      this.resultLines = lines
      this.multiOn = true
      this.resultText = ""
    } else {
      this.resultLines = []
      this.multiOn = false
      this.resultText = this.items[this.resultIndex]
    }
    this.buildWindow()
    this.vibrate()
    this.commitReveal()
  },

  // 揭晓态必须在最后一个可靠动画帧内同步提交。
  // Vela JSC 实测（2026-11-14，xiaomi_band 胶囊屏）：单条 setTimeout 链
  // 的末次回调不派发（探针稳定停在 totalSteps-1），额外再安排一个揭晓定时器
  // 会把 phase / btnText / statusText 整帧丢掉，画面停在「正在抽取」。
  commitReveal(btn, status) {
    spinTimer = null
    this.phase = "done"
    this.btnText = btn || "再抽一次"
    this.statusText = status || "已出结果"
  },

  buildWindow() {
    if (this.compassOn) {
      return
    }
    var n = this.items.length
    var mid = ((this.spinIndex % n) + n) % n
    this.flipOn = this.animKind === "flip"
    this.prevText = this.flipOn ? "" : this.items[((mid - 1) % n + n) % n]
    this.midText = this.items[mid]
    this.nextText = this.flipOn ? "" : this.items[((mid + 1) % n + n) % n]
  },

  stopSpin() {
    if (spinTimer) {
      try {
        clearTimeout(spinTimer)
      } catch (e) {}
      spinTimer = null
    }
  },

  vibrate() {
    if (!VIBRATE_ENABLED) {
      return
    }
    try {
      var vib = require("@system.vibrator")
      if (vib && typeof vib.vibrate === "function") {
        vib.vibrate({ mode: "short" })
      }
    } catch (e) {}
  },

  openDecks() {
    this.stopSpin()
    this.view = "decks"
    this.pageTitle = "卡组"
    this.catIndex = -1
    this.buildCatList()
  },

  openCustom() {
    this.stopSpin()
    this.view = "custom"
    this.pageTitle = "自定"
    this.statusText = "点加一项"
  },

  pickCat(idx) {
    if (idx === -2) {
      if (!this.customDeck) {
        return
      }
      this.catIndex = -2
      this.deckList = [{ idx: 0, title: "我的卡组", deckIndex: -1 }]
      return
    }
    this.catIndex = idx
    this.foodMode = false
    var cat = preset.categories[idx]
    var out = []
    for (var i = 0; i < preset.decks.length; i++) {
      // F01 是空占位卡组，运行时由餐饮数据接管，不显示为死项
      if (preset.decks[i].cat === cat && preset.decks[i].items && preset.decks[i].items.length >= 2) {
        out.push({ idx: out.length, title: preset.decks[i].title, deckIndex: i })
      }
    }
    // 餐饮类追加两个视图入口，不是新卡组，预设仍是 88 组
    if (cat === "餐饮") {
      out.push({ idx: out.length, title: "随便吃一道", deckIndex: -3 })
      out.push({ idx: out.length, title: "搭配抽", deckIndex: -4 })
    }
    this.deckList = out
  },

  selectDeck(deckIndex) {
    if (deckIndex === -3) {
      this.openFoodCats()
      return
    }
    if (deckIndex === -4) {
      this.startCombo()
      return
    }
    // -10 - i 编码餐饮 L1 大类索引
    if (deckIndex <= -10) {
      var ci = -10 - deckIndex
      var fc = food.categories[ci]
      if (!fc) {
        return
      }
      var names = []
      for (var q = 0; q < fc.items.length; q++) {
        names.push(fc.items[q].name)
      }
      this.setDeck({ id: "FOOD" + ci, title: fc.short, cat: "餐饮", items: names, anim: "wheel" })
      this.foodMode = false
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    if (deckIndex < 0) {
      if (!this.customDeck) {
        return
      }
      this.setDeck(this.customDeck)
    } else {
      this.setDeck(preset.decks[deckIndex])
    }
    this.view = "main"
    this.pageTitle = "抉择"
  },

  // OR：12 类选 1 类，再在该类里 wheel 抽 1 项
  openFoodCats() {
    this.stopSpin()
    this.foodMode = true
    this.catIndex = 5
    var out = []
    for (var i = 0; i < food.categories.length; i++) {
      out.push({ idx: i, title: food.categories[i].short, deckIndex: -10 - i })
    }
    this.deckList = out
    this.view = "decks"
    this.pageTitle = "吃什么"
  },

  // 槽位只从已有数据读取，不新增任何餐饮条目
  resolveSlot(slot) {
    var ref = slot.ref || ""
    if (ref.indexOf("deck:food/") === 0) {
      var cname = ref.slice(10)
      var rows = []
      for (var i = 0; i < food.categories.length; i++) {
        if (food.categories[i].name === cname) {
          rows = food.categories[i].items
        }
      }
      var f = slot.filter || {}
      var out = []
      for (var j = 0; j < rows.length; j++) {
        var r = rows[j]
        if ((f["口味"] && r["口味"] !== f["口味"]) ||
            (f["荤素"] && r["荤素"] !== f["荤素"]) ||
            (f["冷热"] && r["冷热"] !== f["冷热"]) ||
            (f["场景"] && r["场景"] !== f["场景"]) ||
            (f["sub"] && r["sub"] !== f["sub"])) {
          continue
        }
        out.push(r.name)
      }
      return out
    }
    if (ref.indexOf("deck:preset/") === 0) {
      var key = ref.slice(12)
      for (var m = 0; m < preset.decks.length; m++) {
        if (preset.decks[m].id === key || preset.decks[m].title === key) {
          return preset.decks[m].items.slice(0)
        }
      }
      return []
    }
    return (slot.items || []).slice(0)
  },

  // AND：多槽各抽 1 项拼成一个元组，逐槽串行揭晓
  startCombo() {
    this.stopSpin()
    var c = food.combos[0]
    var slots = []
    for (var i = 0; i < c.slots.length; i++) {
      slots.push({ label: c.slots[i].label, items: this.resolveSlot(c.slots[i]) })
    }
    this.comboTitle = c.title
    this.comboSlots = slots
    this.compassOn = false
    this.view = "combo"
    this.pageTitle = "搭配"
    this.foodMode = false
    this.drawCombo()
  },

  drawCombo() {
    if (this.phase === "spinning") {
      return
    }
    this.stopSpin()
    var picks = []
    for (var i = 0; i < this.comboSlots.length; i++) {
      var its = this.comboSlots[i].items
      picks.push(its.length ? its[Math.floor(Math.random() * its.length)] : "暂无")
    }
    this.comboPicks = picks
    this.comboResults = []
    this.slotIndex = 0
    this.phase = "spinning"
    this.btnText = "抽取中"
    if (ANIM_ASYNC) {
      this.runSlot()
    } else {
      this.finishComboNow()
    }
  },

  runSlot() {
    var slot = this.comboSlots[this.slotIndex]
    if (!slot || !slot.items.length) {
      this.finishSlot()
      return
    }
    this.slotItems = slot.items.slice(0)
    this.slotLabel = slot.label
    this.slotSpinIndex = 0
    this.slotStep = 0
    this.slotTotal = 10 + Math.floor(Math.random() * 5)
    this.buildSlotWindow()
    this.tickSlot()
  },

  buildSlotWindow() {
    var n = this.slotItems.length
    var mid = ((this.slotSpinIndex % n) + n) % n
    this.slotPrevText = this.slotItems[((mid - 1) % n + n) % n]
    this.slotMidText = this.slotItems[mid]
    this.slotNextText = this.slotItems[((mid + 1) % n + n) % n]
  },

  tickSlot() {
    var self = this
    this.slotStep = this.slotStep + 1
    this.statusText = spinTip(this.slotStep)
    // 同主抽取：末次回调不派发，槽位揭晓提前一帧同步完成
    if (this.slotStep >= this.slotTotal - 1) {
      this.finishSlot()
      return
    }
    this.slotSpinIndex = (this.slotSpinIndex + 1) % this.slotItems.length
    this.buildSlotWindow()
    var t = this.slotStep / this.slotTotal
    var delay = 45 + Math.floor(150 * t * t * t)
    this.scheduleTick(function () {
      self.tickSlot()
    }, delay)
  },

  finishSlot() {
    this.stopSpin()
    var slot = this.comboSlots[this.slotIndex]
    var out = this.comboResults.slice(0)
    out.push({ label: slot ? slot.label : "", value: this.comboPicks[this.slotIndex] || "暂无" })
    this.comboResults = out
    this.slotIndex = this.slotIndex + 1
    if (this.slotIndex < this.comboSlots.length) {
      this.runSlot()
      return
    }
    this.vibrate()
    this.commitReveal("整套重抽", "已出结果")
  },

  finishComboNow() {
    this.stopSpin()
    var out = []
    for (var i = 0; i < this.comboSlots.length; i++) {
      out.push({ label: this.comboSlots[i].label, value: this.comboPicks[i] || "暂无" })
    }
    this.comboResults = out
    this.commitReveal("整套重抽", "已出结果")
  },

  addItem() {
    var storage = require("@system.storage")
    storage.set({ key: "chinese_input_title", value: "加一项", fail: function () {} })
    storage.set({ key: "chinese_input_placeholder", value: "唱歌 不唱歌", fail: function () {} })
    storage.set({ key: "chinese_input_value", value: "", fail: function () {} })
    storage.set({ key: "chinese_input_maxlen", value: "24", fail: function () {} })
    storage.set({
      key: "chinese_input_return_key",
      value: ADD_RESULT_KEY,
      success: function () {
        router.push({ uri: "/pages/chinese-input" })
      },
      fail: function () {}
    })
  },

  checkInputResult() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: ADD_RESULT_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        storage.delete({ key: ADD_RESULT_KEY, fail: function () {} })
        var parsed = self.parseText(data)
        if (!parsed.length) {
          self.statusText = "选项为空"
          return
        }
        var items = self.customItems.slice(0)
        for (var i = 0; i < parsed.length; i++) {
          if (items.indexOf(parsed[i]) < 0 && items.length < MAX_ITEMS) {
            items.push(parsed[i])
          }
        }
        self.customItems = items
        self.statusText = "已加好"
        self.saveDraft()
      },
      fail: function () {}
    })
  },

  parseText(raw) {
    var parts = String(raw || "").split(/[\s,，、;；]+/)
    var out = []
    for (var i = 0; i < parts.length; i++) {
      var s = parts[i]
      if (!s || this.posOf(s) > MAX_P) {
        continue
      }
      if (out.indexOf(s) < 0) {
        out.push(s)
      }
      if (out.length >= MAX_ITEMS) {
        break
      }
    }
    return out
  },

  posOf(s) {
    var p = 0
    for (var i = 0; i < s.length; i++) {
      var c = s.charAt(i)
      if (/[\u4e00-\u9fa5]/.test(c)) {
        p = p + 1
      } else if (/[0-9A-Za-z]/.test(c)) {
        p = p + 0.55
      } else {
        p = p + 0.5
      }
    }
    return p
  },

  saveCustom() {
    if (this.customItems.length < 2) {
      this.statusText = "至少两项"
      return
    }
    var deck = {
      id: "CUSTOM",
      title: "我的卡组",
      cat: "我的",
      items: this.customItems.slice(0),
      anim: this.customItems.length === 2 ? "flip" : "wheel"
    }
    this.customDeck = deck
    var storage = require("@system.storage")
    storage.set({ key: CUSTOM_DECK_KEY, value: JSON.stringify(deck), fail: function () {} })
    this.setDeck(deck)
    this.view = "main"
    this.pageTitle = "抉择"
    this.buildCatList()
    this.draw()
  },

  clearCustom() {
    this.customItems = []
    this.saveDraft()
    this.statusText = "已清空"
  },

  saveDraft() {
    var storage = require("@system.storage")
    storage.set({ key: DRAFT_KEY, value: JSON.stringify(this.customItems), fail: function () {} })
  },

  loadDraft() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: DRAFT_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var arr = JSON.parse(data)
          if (arr && arr.length) {
            self.customItems = arr.slice(0, MAX_ITEMS)
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  loadCustomDeck() {
    var self = this
    var storage = require("@system.storage")
    storage.get({
      key: CUSTOM_DECK_KEY,
      success: function (data) {
        if (!data) {
          return
        }
        try {
          var deck = JSON.parse(data)
          if (deck && deck.items && deck.items.length >= 2) {
            self.customDeck = deck
            self.buildCatList()
          }
        } catch (e) {}
      },
      fail: function () {}
    })
  },

  goBack() {
    if (this.view === "combo") {
      this.stopSpin()
      this.phase = "idle"
      this.btnText = "抽一个"
      this.view = "decks"
      this.pageTitle = "卡组"
      this.pickCat(5)
      return
    }
    if (this.view === "decks") {
      if (this.foodMode) {
        this.foodMode = false
        this.pickCat(5)
        return
      }
      if (this.catIndex !== -1) {
        this.catIndex = -1
        return
      }
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    if (this.view === "custom") {
      this.view = "main"
      this.pageTitle = "抉择"
      return
    }
    this.stopSpin()
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 32px 12px 16px 12px;
}

.back-header {
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 36px;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.back-btn-wrapper {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 22px;
  height: 22px;
}

.header-title {
  flex: 1;
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
  min-width: 0;
}

.header-placeholder {
  width: 30px;
  height: 30px;
  flex-shrink: 0;
}

.view {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.deck-head {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.deck-name {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

/* 罗盘：盘面文字固定水平排布，只有指针帧在动 */
.compass-box {
  flex-direction: column;
  width: 100%;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.dial {
  position: relative;
  border-width: 2px;
  border-color: #444444;
  justify-content: center;
  align-items: center;
}

.dial-tick {
  position: absolute;
  width: 48px;
  height: 34px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.dial-tick-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.needle {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.compass-result {
  width: 100%;
  height: 60px;
  justify-content: center;
  align-items: center;
}

.compass-result-text {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
  text-align: center;
  lines: 2;
}

.multi-result {
  flex-direction: column;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.multi-line {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

/* 组合卡：字段标签 24 字段值 28 纵向排版，不用分隔符 */
.combo-stage {
  flex-direction: column;
  width: 100%;
  height: 180px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.combo-slot-label {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.combo-card {
  flex-direction: column;
  width: 100%;
  border-radius: 14px;
  padding: 8px 8px;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.combo-card-title {
  width: 100%;
  font-size: 30px;
  font-weight: bold;
  line-height: 40px;
  text-align: center;
  lines: 1;
  margin-bottom: 8px;
}

.combo-field {
  flex-direction: column;
  width: 100%;
  height: 72px;
  border-radius: 8px;
  padding: 0 8px;
  justify-content: center;
  margin-bottom: 4px;
}

.combo-field-label {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  lines: 1;
}

.combo-field-value {
  width: 100%;
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

.pick-row {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.pick-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.stage {
  flex-direction: column;
  width: 100%;
  height: 138px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.spin-box {
  flex-direction: column;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.spin-row {
  width: 100%;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
}

.spin-text {
  font-size: 28px;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

.result-box {
  flex-direction: column;
  width: 100%;
  justify-content: center;
  align-items: center;
}

.result-text {
  font-size: 44px;
  font-weight: bold;
  line-height: 60px;
  text-align: center;
  lines: 2;
}

.main-btn {
  width: 100%;
  height: 56px;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.main-btn-text {
  font-size: 28px;
  font-weight: bold;
  line-height: 38px;
  text-align: center;
  lines: 1;
}

.sub-row {
  width: 100%;
  height: 40px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.sub-text {
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.status-line {
  width: 100%;
  height: 34px;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  lines: 1;
}

.list-scroll {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.list-row {
  width: 100%;
  height: 52px;
  border-radius: 12px;
  padding: 0 8px;
  justify-content: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.list-text {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

.edit-tip {
  width: 100%;
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  margin-bottom: 8px;
}

.item-scroll {
  flex-direction: column;
  width: 100%;
  flex: 1;
  min-height: 100px;
  margin-bottom: 10px;
}

.item-row {
  width: 100%;
  height: 44px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.item-text {
  font-size: 28px;
  line-height: 38px;
  lines: 1;
}

@media (shape: circle) {
  .page {
    padding: 24px 20px 16px 20px;
  }
  .stage {
    height: 150px;
  }
  .compass-box {
    margin-bottom: 0;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 24px 12px 12px 12px;
  }
  .stage {
    height: 126px;
  }
}
</style>
