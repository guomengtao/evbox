      <div class="main-btn" onclick="drawCombo" style="background-color: {{ busy ? theme.cardLight : theme.accent }}">
        <text class="main-btn-text" style="color: {{ busy ? theme.textSecondary : theme.bg }}">{{ btnText }}</text>
