          <text class="list-text" style="color: {{ theme.text }}">{{ deck12 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(13)"
             style="background-color: {{ theme.card }}; height: {{ deck13 ? '52px' : '0' }}; margin-bottom: {{ deck13 ? '8px' : '0' }}">
          <text class="list-text" style="color: {{ theme.text }}">{{ deck13 }}</text>
        </div>
        <div class="list-row" onclick="selectDeckRow(14)"
