          <text class="list-text" style="color: {{ theme.text }}">{{ deck19 }}</text>
        </div>
      </scroll>
    </div>

    <!-- 自定义卡组：逐项添加，保存即抽 -->
    <div class="view" style="display: {{ view === 'custom' ? 'flex' : 'none' }}">
