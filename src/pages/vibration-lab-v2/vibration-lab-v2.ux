<import name="unlock-dialog" src="../../components/unlock-dialog"></import>
<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header" style="background-color: {{ theme.bg }}">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">震动自定义</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="scroll-body" scroll-y="true">

      <div class="hero" style="background-color: {{ theme.card }}">
        <text class="hero-name" style="color: {{ theme.text }}">{{ currentName }}</text>
        <text class="hero-desc" style="color: {{ theme.textSecondary }}">{{ duration }}ms · {{ interval }}ms · {{ count }}次</text>
        <div class="hero-btns">
          <input class="play-btn" type="button" value="试听" onclick="preview" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
          <input class="stop-btn" type="button" value="停止" onclick="stopVibration" if="{{ isPlaying }}" style="background-color: {{ theme.deleteBg }}; color: {{ theme.deleteText }}" />
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.text }}">震动提醒</text>
        <div class="remind-row">
          <div class="remind-row-item">
            <text class="remind-label" style="color: {{ theme.textSecondary }}">上课提醒</text>
            <input class="toggle-btn" type="button" value="{{ remindEnabled ? 'ON' : 'OFF' }}" onclick="toggleRemind" style="background-color: {{ remindEnabled ? theme.accent : theme.border }}; color: {{ remindEnabled ? theme.bg : theme.textSecondary }}" />
          </div>
          <div class="remind-row-item" if="{{ remindEnabled }}">
            <text class="remind-label" style="color: {{ theme.textSecondary }}">提前</text>
            <div class="minute-row">
              <input class="minute-btn" type="button" value="−" onclick="decreaseMinutes" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
              <text class="minute-value" style="color: {{ theme.accent }}">{{ remindMinutes }}分</text>
              <input class="minute-btn" type="button" value="+" onclick="increaseMinutes" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
            </div>
          </div>
        </div>
        <div if="{{ remindEnabled }}">
          <text class="section-subtitle" style="color: {{ theme.textSecondary }}">震动样式</text>
          <div class="vibe-list">
            <div for="{{ vibrationStyles }}" class="vibe-item {{ vibrationStyle === $item.key ? 'vibe-active' : '' }}" onclick="selectVibrationStyle($item.key)" style="background-color: {{ vibrationStyle === $item.key ? theme.cardLight : theme.border }}">
              <text class="vibe-label" style="color: {{ vibrationStyle === $item.key ? theme.accent : theme.text }}">{{ $item.label }}</text>
              <text class="vibe-desc" style="color: {{ vibrationStyle === $item.key ? theme.accent : theme.textSecondary }}">{{ $item.desc }}</text>
            </div>
          </div>
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.text }}">震动强度</text>
        <div class="stepper-row">
          <input class="step-btn" type="button" value="−" onclick="decreaseDuration" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="step-value" style="color: {{ theme.accent }}">{{ duration }}ms</text>
          <input class="step-btn" type="button" value="+" onclick="increaseDuration" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="quick-row">
          <input class="quick-btn {{ duration === 100 ? 'quick-active' : '' }}" type="button" value="100" onclick="setDuration100" style="background-color: {{ duration === 100 ? theme.accent : theme.border }}; color: {{ duration === 100 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ duration === 300 ? 'quick-active' : '' }}" type="button" value="300" onclick="setDuration300" style="background-color: {{ duration === 300 ? theme.accent : theme.border }}; color: {{ duration === 300 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ duration === 500 ? 'quick-active' : '' }}" type="button" value="500" onclick="setDuration500" style="background-color: {{ duration === 500 ? theme.accent : theme.border }}; color: {{ duration === 500 ? theme.bg : theme.textSecondary }}" />
        </div>
        <div class="quick-row">
          <input class="quick-btn {{ duration === 800 ? 'quick-active' : '' }}" type="button" value="800" onclick="setDuration800" style="background-color: {{ duration === 800 ? theme.accent : theme.border }}; color: {{ duration === 800 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ duration === 1000 ? 'quick-active' : '' }}" type="button" value="1000" onclick="setDuration1000" style="background-color: {{ duration === 1000 ? theme.accent : theme.border }}; color: {{ duration === 1000 ? theme.bg : theme.textSecondary }}" />
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.text }}">间隔时间</text>
        <div class="stepper-row">
          <input class="step-btn" type="button" value="−" onclick="decreaseInterval" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="step-value" style="color: {{ theme.accent }}">{{ interval }}ms</text>
          <input class="step-btn" type="button" value="+" onclick="increaseInterval" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="quick-row">
          <input class="quick-btn {{ interval === 100 ? 'quick-active' : '' }}" type="button" value="100" onclick="setInterval100" style="background-color: {{ interval === 100 ? theme.accent : theme.border }}; color: {{ interval === 100 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ interval === 200 ? 'quick-active' : '' }}" type="button" value="200" onclick="setInterval200" style="background-color: {{ interval === 200 ? theme.accent : theme.border }}; color: {{ interval === 200 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ interval === 500 ? 'quick-active' : '' }}" type="button" value="500" onclick="setInterval500" style="background-color: {{ interval === 500 ? theme.accent : theme.border }}; color: {{ interval === 500 ? theme.bg : theme.textSecondary }}" />
        </div>
        <div class="quick-row">
          <input class="quick-btn {{ interval === 800 ? 'quick-active' : '' }}" type="button" value="800" onclick="setInterval800" style="background-color: {{ interval === 800 ? theme.accent : theme.border }}; color: {{ interval === 800 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ interval === 1000 ? 'quick-active' : '' }}" type="button" value="1000" onclick="setInterval1000" style="background-color: {{ interval === 1000 ? theme.accent : theme.border }}; color: {{ interval === 1000 ? theme.bg : theme.textSecondary }}" />
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.text }}">震动次数</text>
        <div class="stepper-row">
          <input class="step-btn" type="button" value="−" onclick="decreaseCount" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
          <text class="step-value" style="color: {{ theme.accent }}">{{ count }}</text>
          <input class="step-btn" type="button" value="+" onclick="increaseCount" style="background-color: {{ theme.border }}; color: {{ theme.text }}" />
        </div>
        <div class="quick-row">
          <input class="quick-btn {{ count === 1 ? 'quick-active' : '' }}" type="button" value="1" onclick="setCount1" style="background-color: {{ count === 1 ? theme.accent : theme.border }}; color: {{ count === 1 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ count === 2 ? 'quick-active' : '' }}" type="button" value="2" onclick="setCount2" style="background-color: {{ count === 2 ? theme.accent : theme.border }}; color: {{ count === 2 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ count === 3 ? 'quick-active' : '' }}" type="button" value="3" onclick="setCount3" style="background-color: {{ count === 3 ? theme.accent : theme.border }}; color: {{ count === 3 ? theme.bg : theme.textSecondary }}" />
        </div>
        <div class="quick-row">
          <input class="quick-btn {{ count === 5 ? 'quick-active' : '' }}" type="button" value="5" onclick="setCount5" style="background-color: {{ count === 5 ? theme.accent : theme.border }}; color: {{ count === 5 ? theme.bg : theme.textSecondary }}" />
          <input class="quick-btn {{ count === 10 ? 'quick-active' : '' }}" type="button" value="10" onclick="setCount10" style="background-color: {{ count === 10 ? theme.accent : theme.border }}; color: {{ count === 10 ? theme.bg : theme.textSecondary }}" />
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.text }}">快捷预设</text>
        <div class="preset-row">
          <div class="preset-item" for="{{ presets }}" onclick="applyPreset($item.key)" style="background-color: {{ theme.border }}">
            <text class="preset-name" style="color: {{ theme.text }}">{{ $item.label }}</text>
            <text class="preset-info" style="color: {{ theme.textSecondary }}">{{ $item.duration }}ms×{{ $item.count }}</text>
          </div>
        </div>
      </div>

      <div class="section" style="background-color: {{ theme.card }}">
        <text class="section-title" style="color: {{ theme.text }}">我的方案</text>
        <div class="empty-hint" if="{{ savedPresets.length === 0 }}">
          <text class="empty-text" style="color: {{ theme.textMuted }}">暂无保存的方案</text>
        </div>
        <div class="saved-item" for="{{ savedPresets }}" onclick="loadPreset($idx)" style="background-color: {{ theme.border }}">
          <div class="saved-left">
            <text class="saved-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
            <text class="saved-info" style="color: {{ theme.textSecondary }}">{{ $item.duration }}ms / {{ $item.count }}次</text>
          </div>
          <input class="delete-btn" type="button" value="{{ deleteConfirmIndex === $idx ? '确认' : '删' }}" onclick="deletePreset($idx)" style="background-color: {{ deleteConfirmIndex === $idx ? theme.deleteText : theme.deleteBg }}; color: {{ deleteConfirmIndex === $idx ? theme.text : theme.deleteText }}" />
        </div>
      </div>

      <div class="save-section">
        <input class="save-btn" type="button" value="保存当前为方案" onclick="savePreset" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      </div>

      <div class="footer-pin">
        <text class="pin-link" onclick="pinToHome" style="color: {{ theme.textMuted }}">固定到首页</text>
      </div>
    </scroll>

    <unlock-dialog id="unlockDialog"></unlock-dialog>
  </div>
</template>

<script>
import router from "@system.router"
var pinHelper = require("../../data/pin-helper.js")

// 日志开关：发布态关闭，避免手环上字符串拼接与 IPC 开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}
import vibrator from "@system.vibrator"
import prompt from "@system.prompt"
const store = require("../../data/store.js")
const authStore = require("../../data/auth-store.js")

var presetMap = {
  short:       { label: "短震",   duration: 100,  interval: 200, count: 1 },
  long:        { label: "长震",   duration: 800,  interval: 200, count: 1 },
  doubleShort: { label: "双短震", duration: 100,  interval: 200, count: 2 },
  tripleShort: { label: "三连震", duration: 100,  interval: 200, count: 3 },
  sos:         { label: "SOS",    duration: 200,  interval: 200, count: 3 },
  heartbeat:   { label: "心跳",   duration: 80,   interval: 100, count: 8 }
}

var presetKeys = Object.keys(presetMap)

var currentTaskId = 0
var fallbackTimer = null

export default {
  private: {
    iconTheme: "dark",
    isPro: false,
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      deleteBg: '#2a1a3e',
      deleteText: '#e08080'
    },
    duration: 500,
    interval: 800,
    count: 5,
    currentName: "标准震动",
    isPlaying: false,
    presets: [],
    savedPresets: [],
    deleteConfirmIndex: -1,
    remindEnabled: true,
    remindMinutes: 5,
    vibrationStyle: "short",
    vibrationStyles: []
  },

  onInit() {
    var self = this
    this.vibrationStyles = store.getVibrationStyles ? store.getVibrationStyles() : []
    this.presets = presetKeys.map(function(key) {
      return {
        key: key,
        label: presetMap[key].label,
        duration: presetMap[key].duration,
        count: presetMap[key].count
      }
    })
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadPresets()
    this.loadRemindSettings()
    this.loadVibrationStyle()
    this.checkProStatus()
  },

  checkProStatus() {
    var self = this
    authStore.checkStatus(function(status) {
      self.isPro = status.isActivated
    })
  },

  loadPresets() {
    var self = this
    store.getVibrationPresets(function(presets) {
      self.savedPresets = presets || []
    })
  },

  increaseDuration() {
    if (this.duration < 2000) {
      this.duration = Math.min(2000, this.duration + 50)
      this.currentName = "自定义"
    }
  },

  decreaseDuration() {
    if (this.duration > 50) {
      this.duration = Math.max(50, this.duration - 50)
      this.currentName = "自定义"
    }
  },

  setDuration100() { this.duration = 100; this.currentName = "自定义" },
  setDuration300() { this.duration = 300; this.currentName = "自定义" },
  setDuration500() { this.duration = 500; this.currentName = "自定义" },
  setDuration800() { this.duration = 800; this.currentName = "自定义" },
  setDuration1000() { this.duration = 1000; this.currentName = "自定义" },

  increaseInterval() {
    if (this.interval < 2000) {
      this.interval = Math.min(2000, this.interval + 50)
      this.currentName = "自定义"
    }
  },

  decreaseInterval() {
    if (this.interval > 50) {
      this.interval = Math.max(50, this.interval - 50)
      this.currentName = "自定义"
    }
  },

  setInterval100() { this.interval = 100; this.currentName = "自定义" },
  setInterval200() { this.interval = 200; this.currentName = "自定义" },
  setInterval500() { this.interval = 500; this.currentName = "自定义" },
  setInterval800() { this.interval = 800; this.currentName = "自定义" },
  setInterval1000() { this.interval = 1000; this.currentName = "自定义" },

  increaseCount() {
    if (this.count < 20) {
      this.count++
      this.currentName = "自定义"
    }
  },

  decreaseCount() {
    if (this.count > 1) {
      this.count--
      this.currentName = "自定义"
    }
  },

  setCount1() { this.count = 1; this.currentName = "自定义" },
  setCount2() { this.count = 2; this.currentName = "自定义" },
  setCount3() { this.count = 3; this.currentName = "自定义" },
  setCount5() { this.count = 5; this.currentName = "自定义" },
  setCount10() { this.count = 10; this.currentName = "自定义" },

  applyPreset(key) {
    var p = presetMap[key]
    if (!p) return
    this.duration = p.duration
    this.interval = p.interval
    this.count = p.count
    this.currentName = p.label
    this.preview()
  },

  preview() {
    this.stopVibration()
    var self = this
    self.isPlaying = true

    vibrator.start({
      duration: self.duration,
      interval: self.interval,
      count: self.count,
      success: function(data) {
        currentTaskId = data.id
      },
      fail: function(data, code) {
        dlog("[VIBRATION] start fail, code=" + code + ", fallback to vibrate")
        self.fallbackVibrate()
      }
    })
  },

  fallbackVibrate() {
    var self = this
    var i = 0
    function loop() {
      if (i >= self.count || !self.isPlaying) {
        self.isPlaying = false
        return
      }
      var mode = self.duration > 300 ? "long" : "short"
      vibrator.vibrate({ mode: mode })
      i++
      if (i < self.count && self.isPlaying) {
        fallbackTimer = setTimeout(loop, self.interval + self.duration)
      } else {
        self.isPlaying = false
      }
    }
    loop()
  },

  stopVibration() {
    if (currentTaskId) {
      vibrator.stop(currentTaskId)
      currentTaskId = 0
    }
    if (fallbackTimer) {
      clearTimeout(fallbackTimer)
      fallbackTimer = null
    }
    this.isPlaying = false
  },

  savePreset() {
    var self = this
    if (!self.isPro) {
      store.showUnlockDialog({
        title: "解锁震动自定义",
        description: "一次性解锁，永久使用全部高级功能",
        benefits: ["保存震动方案", "多套震动方案", "数据备份与恢复", "首页自定义"],
        cancelText: "暂不需要"
      })
      return
    }
    var name = "方案" + (this.savedPresets.length + 1)
    var preset = {
      name: name,
      duration: this.duration,
      interval: this.interval,
      count: this.count
    }
    this.savedPresets.push(preset)
    store.setVibrationPresets(this.savedPresets)
    this.currentName = name
    prompt.showToast({ message: "方案已保存" })
  },

  loadPreset(idx) {
    var p = this.savedPresets[idx]
    if (!p) return
    this.duration = p.duration
    this.interval = p.interval
    this.count = p.count
    this.currentName = p.name
    this.preview()
  },

  deletePreset(idx) {
    if (this.deleteConfirmIndex !== idx) {
      this.deleteConfirmIndex = idx
      var self = this
      this.deleteTimer = setTimeout(function() {
        self.deleteConfirmIndex = -1
      }, 5000)
      return
    }
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
    this.savedPresets.splice(idx, 1)
    this.deleteConfirmIndex = -1
    store.setVibrationPresets(this.savedPresets)
    prompt.showToast({ message: "方案已删除" })
  },

  loadRemindSettings() {
    var self = this
    store.getRemindSettings(function(settings) {
      if (settings) {
        self.remindEnabled = settings.enabled
        self.remindMinutes = settings.minutes
      }
    })
  },

  loadVibrationStyle() {
    var self = this
    store.getVibrationStyle(function(style) {
      self.vibrationStyle = style || "short"
    })
  },

  toggleRemind() {
    this.remindEnabled = !this.remindEnabled
    this.saveRemindSettings()
  },

  increaseMinutes() {
    if (this.remindMinutes < 30) {
      this.remindMinutes++
      this.saveRemindSettings()
    }
  },

  decreaseMinutes() {
    if (this.remindMinutes > 0) {
      this.remindMinutes--
      this.saveRemindSettings()
    }
  },

  saveRemindSettings() {
    store.setRemindSettings({
      enabled: this.remindEnabled,
      minutes: this.remindMinutes
    })
  },

  selectVibrationStyle(style) {
    this.vibrationStyle = style
    this.previewVibrationStyle(style)
    store.setVibrationStyle(style)
  },

  previewVibrationStyle(style) {
    var pattern = null
    var styles = this.vibrationStyles
    for (var i = 0; i < styles.length; i++) {
      if (styles[i].key === style) {
        pattern = styles[i]
        break
      }
    }
    if (!pattern) {
      this.fallbackVibrateOnce("short")
      return
    }
    var self = this
    vibrator.start({
      duration: pattern.duration,
      interval: pattern.interval,
      count: pattern.count,
      success: function() {},
      fail: function(data, code) {
        dlog("[VIBRATION-LAB] vibrator.start fail, code=" + code + ", fallback")
        self.fallbackVibratePattern(pattern)
      }
    })
  },

  fallbackVibrateOnce(mode) {
    var vibrateMode = (mode === "long" || mode === 400) ? "long" : "short"
    vibrator.vibrate({ mode: vibrateMode })
  },

  fallbackVibratePattern(pattern) {
    var idx = 0
    function loop() {
      if (idx >= pattern.count) return
      var mode = pattern.duration > 300 ? "long" : "short"
      vibrator.vibrate({ mode: mode })
      idx++
      if (idx < pattern.count) {
        setTimeout(loop, pattern.interval + pattern.duration)
      }
    }
    loop()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  },

  goBack() {
    this.stopVibration()
    router.back()
  },

  pinToHome() {
    pinHelper.pinPage("震动实验室", "/pages/vibration-lab")
  },

  onDestroy() {
    this.stopVibration()
    if (this.deleteTimer) {
      clearTimeout(this.deleteTimer)
      this.deleteTimer = null
    }
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 30px 16px 16px 16px;
}

.scroll-body {
  flex: 1;
  flex-direction: column;
}

.hero {
  flex-direction: column;
  align-items: center;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 10px;
}

.hero-name {
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  line-height: 34px;
  lines: 1;
  text-overflow: ellipsis;
}

.hero-desc {
  font-size: 20px;
  text-align: center;
  line-height: 28px;
  margin-top: 4px;
  lines: 1;
  text-overflow: ellipsis;
}

.hero-btns {
  flex-direction: row;
  margin-top: 10px;
}

.play-btn {
  width: 80px;
  height: 40px;
  border-radius: 8px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  line-height: 34px;
  margin-right: 8px;
}

.stop-btn {
  width: 80px;
  height: 40px;
  border-radius: 8px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  line-height: 34px;
}

.section {
  flex-direction: column;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 10px;
}

.section-title {
  font-size: 22px;
  font-weight: bold;
  line-height: 32px;
  margin-bottom: 8px;
  lines: 1;
  text-overflow: ellipsis;
}

.section-subtitle {
  font-size: 20px;
  line-height: 28px;
  margin-bottom: 6px;
  lines: 1;
  text-overflow: ellipsis;
}

.remind-row {
  flex-direction: column;
}

.remind-row-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0;
}

.remind-label {
  font-size: 22px;
  line-height: 32px;
  lines: 1;
  text-overflow: ellipsis;
}

.toggle-btn {
  width: 52px;
  height: 40px;
  border-radius: 8px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  line-height: 34px;
}

.minute-row {
  flex-direction: row;
  align-items: center;
}

.minute-btn {
  width: 40px;
  height: 40px;
  border-radius: 6px;
  font-size: 24px;
