<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">设备ID诊断</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="body" scroll-y="true">
      <div class="cell">
        <div class="btn-item" onclick="doLocalUUID" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">1. 本地 UUID</text>
        </div>
        <text class="item-res" if="{{ r.localUUID }}" style="color: {{ r.localUUID.ok ? theme.text : '#e74c3c' }}">{{ r.localUUID.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="doGetInfo" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">2. getInfo</text>
        </div>
        <text class="item-res" if="{{ r.getInfo }}" style="color: {{ r.getInfo.ok ? theme.text : '#e74c3c' }}">{{ r.getInfo.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="doGetUA" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">3. getUA</text>
        </div>
        <text class="item-res" if="{{ r.getUA }}" style="color: {{ r.getUA.ok ? theme.text : '#e74c3c' }}">{{ r.getUA.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="doGetDeviceId" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">4. getDeviceId</text>
        </div>
        <text class="item-res" if="{{ r.getDeviceId }}" style="color: {{ r.getDeviceId.ok ? theme.text : '#e74c3c' }}">{{ r.getDeviceId.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="doGetSerial" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">5. getSerial</text>
        </div>
        <text class="item-res" if="{{ r.getSerial }}" style="color: {{ r.getSerial.ok ? theme.text : '#e74c3c' }}">{{ r.getSerial.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="doGetMac" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">6. getMac</text>
        </div>
        <text class="item-res" if="{{ r.getMac }}" style="color: {{ r.getMac.ok ? theme.text : '#e74c3c' }}">{{ r.getMac.value }}</text>
      </div>

      <div class="cell">
        <div class="btn-item" onclick="doGetId" style="background-color: {{ theme.card }}">
          <text class="btn-label" style="color: {{ theme.accent }}">7. getId</text>
        </div>
        <text class="item-res" if="{{ r.getId }}" style="color: {{ r.getId.ok ? theme.text : '#e74c3c' }}">{{ r.getId.value }}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
var device = require("@system.device")
var storage = require("@system.storage")
var store = require("../../data/store.js")

var PROGRESS_KEY = "diag_progress_v2"
var UUID_KEY = "diag_uuid_v1"

function generateUUID() {
  var d = new Date().getTime()
  var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
  return uuid.replace(/[xy]/g, function(c) {
    var r = (d + Math.random() * 16) % 16 | 0
    d = Math.floor(d / 16)
    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16)
  })
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    r: {
      localUUID: null,
      getInfo: null,
      getUA: null,
      getDeviceId: null,
      getSerial: null,
      getMac: null,
      getId: null
    },
    running: false
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
    })
  },

  // ===== 7 个按钮，点哪个测哪个，结果直接显示在该按钮下方 =====

  doLocalUUID() {
    this.runTest('localUUID', function(done) {
      storage.get({
        key: UUID_KEY,
        success: function(data) {
          if (data) {
            done(true, String(data))
          } else {
            var uuid = generateUUID()
            storage.set({
              key: UUID_KEY,
              value: uuid,
              success: function() { done(true, uuid) },
              fail: function() { done(false, uuid + '(存储失败)') }
            })
          }
        },
        fail: function() { done(false, '读取失败') }
      })
    })
  },

  doGetInfo() {
    this.runTest('getInfo', function(done) {
      device.getInfo({
        success: function(ret) {
          var id = ret.deviceId || ret.serialNumber || ret.udid || ''
          done(!!id, id || '(无)')
        },
        fail: function() { done(false, '获取失败') }
      })
    })
  },

  doGetUA() {
    this.runTest('getUA', function(done) {
      if (typeof device.getUA !== 'function') { done(false, 'API不存在'); return }
      device.getUA({
        success: function(data) { done(true, JSON.stringify(data)) },
        fail: function() { done(false, '获取失败') }
      })
    })
  },

  doGetDeviceId() {
    this.runTest('getDeviceId', function(done) {
      device.getDeviceId({
        success: function(data) {
          var raw = data.deviceId
          done(!!(raw && raw !== 'NA'), raw || '(空)')
        },
        fail: function() { done(false, '获取失败') }
      })
    })
  },

  doGetSerial() {
    this.runTest('getSerial', function(done) {
      device.getSerial({
        success: function(data) {
          var raw = data.serial
          done(!!(raw && raw !== 'NA'), raw || '(空)')
        },
        fail: function() { done(false, '获取失败') }
      })
    })
  },

  doGetMac() {
    this.runTest('getMac', function(done) {
      if (typeof device.getMac !== 'function') { done(false, 'API不存在'); return }
      device.getMac({
        success: function(data) {
          var raw = data.mac || data.address || ''
          done(!!raw, raw || '(空)')
        },
        fail: function() { done(false, '获取失败') }
      })
    })
  },

  doGetId() {
    this.runTest('getId', function(done) {
      if (typeof device.getId !== 'function') { done(false, 'API不存在'); return }
      device.getId({
        success: function(data) { done(true, JSON.stringify(data)) },
        fail: function() { done(false, '获取失败') }
      })
    })
  },

  // 单次测试：落盘进度 → 延时 → 执行 → 显示结果
  runTest(key, runner) {
    var self = this
    if (self.running) return
    self.running = true
    storage.set({
      key: PROGRESS_KEY,
      value: key,
      success: function() { self.execTest(key, runner) },
      fail: function() { self.execTest(key, runner) }
    })
  },

  execTest(key, runner) {
    var self = this
    // 延时确保进度落盘完成后再调用可能崩溃的 API
    setTimeout(function() {
      var finish = function(ok, value) {
        self.running = false
        self.setRes(key, ok, value)
        storage.set({ key: PROGRESS_KEY, value: '' })
      }
      try {
        runner(finish)
      } catch (e) {
        finish(false, '异常')
      }
    }, 350)
  },

  setRes(key, ok, value) {
    var o = this.r
    // 整体重建对象后再赋值，确保视图刷新（不用循环）
    var nr = {
      localUUID: o.localUUID,
      getInfo: o.getInfo,
      getUA: o.getUA,
      getDeviceId: o.getDeviceId,
      getSerial: o.getSerial,
      getMac: o.getMac,
      getId: o.getId
    }
    nr[key] = { ok: ok, value: value }
    this.r = nr
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 8px 8px 6px 8px;
}

.body {
  flex: 1;
  flex-direction: column;
}

.cell {
  flex-direction: column;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.btn-item {
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 10px 12px;
}

.btn-label {
  font-size: 24px;
  line-height: 32px;
  lines: 1;
}

.item-res {
  font-size: 22px;
  line-height: 30px;
  padding: 4px 4px 0 4px;
  lines: 0;
  word-break: break-all;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 8px 10px 6px 10px;
  }
}

@media (shape: circle) {
  .page {
    padding: 24px 36px 24px 36px;
  }
}

@media (shape: rect) {
  .page {
    padding: 6px 10px 12px 10px;
  }
}
</style>
