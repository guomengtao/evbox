    line-height: 22px;
    margin-top: 6px;
  }
}

@media (shape: rect) {
  .settings-page {
    padding: 6px 6px 6px 6px;
  }
  .back-header {
    margin-bottom: 6px;
  }
  .back-btn-wrapper {
    width: 50px;
    height: 48px;
  }
  .header-title {
    font-size: 30px;
    line-height: 40px;
  }
  .row-label {
    font-size: 28px;
    line-height: 38px;
  }
  .row-hint {
    font-size: 24px;
    line-height: 32px;
  }
  .toggle-btn {
    width: 52px;
