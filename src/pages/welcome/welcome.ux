<template>
  <div class="home-page" style="background-color: {{ theme.bg }}">
    <div class="logo-area">
      <text class="app-name" style="color: {{ theme.accent }}">EvBox工具箱</text>
      <text class="app-subtitle" style="color: {{ theme.textSecondary }}">你的随身工具箱</text>
    </div>

    <div class="action-area">
      <input class="enter-btn" type="button" value="进入首页" onclick="enterHome" style="background-color: {{ theme.accent }}; color: {{ theme.bg }}" />
      <input class="settings-btn" type="button" value="设置" onclick="openSettings" style="background-color: {{ theme.cardLight }}; color: {{ theme.text }}" />
      <!-- 显式退出入口：作为返回键在某些运行时不生效时的最后兜底 -->
      <input class="exit-btn" type="button" value="退出" onclick="exitApp" style="background-color: {{ theme.cardLight }}; color: {{ theme.textSecondary }}" />
    </div>
  </div>
</template>

<script>
const store = require("../../data/store.js")

// 首屏预热：把首页要用的存储读取提前到欢迎页完成。
// 用户点击"进入首页"时，这些数据已在内存缓存中，避免进入时串行读盘造成卡顿。
var _warmedUp = false
function warmUp() {
  if (_warmedUp) return
  _warmedUp = true
  try {
    store.getBaseFontSize(function() {})
    store.getHomepageSettings(function() {})
  } catch (e) {}
}

export default {
  private: {
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566'
    },
    targetPage: "index"
  },

  onInit() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    })
    store.getDefaultHomepage(function(settings) {
      self.targetPage = settings.targetPage || "index"
      warmUp()
    })
  },

  onShow() {
    var self = this
    store.getTheme(function(t) {
      self.theme = t
    }, true)
  },

  enterHome() {
    var router = require("@system.router")
    var uri = "/pages/" + this.targetPage
    router.replace({
      uri: uri
    })
  },

  openSettings() {
    var router = require("@system.router")
    router.push({ uri: "/pages/settings" })
  },

  exitApp() {
    var utils = require("../../data/utils.js")
    var ok = utils.exitApp()
    if (!ok) {
      // 运行时不提供任何退出入口时，明确告知用户改用系统手势，避免"点了没反应"
      var prompt = require("@system.prompt")
      prompt.showToast({ message: "请用系统手势退出应用" })
    }
  },

  onBackPress() {
    // 只有主动退出成功才消费返回键（return true）。
    // 若退出入口不可用却仍 return true，返回键会被"吃掉"且毫无反应——
    // 这正是"安装后无法退出"的根因。失败时必须 return false 交还系统默认行为。
    var utils = require("../../data/utils.js")
    return utils.exitApp() === true
  }
}
</script>

<style>
.home-page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 20px;
}

.logo-area {
  flex-direction: column;
  align-items: center;
  margin-bottom: 24px;
}

.app-name {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 8px;
  line-height: 44px;
  /* 2026-10-02 按用户反馈「标题禁止换行」 */
  lines: 1;
  text-overflow: ellipsis;
  width: 100%;
  text-align: center;
}

.app-subtitle {
  font-size: 20px;
  line-height: 28px;
}

.action-area {
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.enter-btn {
  width: 220px;
  height: 52px;
  border-radius: 26px;
  font-size: 20px;
  font-weight: bold;
  text-align: center;
  border-width: 0;
  margin-bottom: 16px;
  line-height: 28px;
}

.settings-btn {
  width: 180px;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 28px;
}

.exit-btn {
  width: 180px;
  height: 48px;
  border-radius: 24px;
  font-size: 20px;
  text-align: center;
  border-width: 0;
  line-height: 28px;
  margin-top: 12px;
}

@media (shape: circle) {
  .home-page {
    padding: 44px 36px;
  }
  .app-name {
    font-size: 28px;
    margin-bottom: 4px;
  }
  .app-subtitle {
    font-size: 20px;
  }
  .enter-btn {
    width: 180px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    margin-bottom: 12px;
  }
  /* 原为 44px（低于 48px 规范），提到 48px */
  .settings-btn {
    width: 160px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
  }
  .exit-btn {
    width: 160px;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    margin-top: 12px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .home-page {
    padding: 60px 12px 30px 12px;
  }
  .app-name {
    /* 胶囊屏内容宽约 160px：「EvBox工具箱」= 5 拉丁字符 + 3 汉字，
       30px 下溢出换行，24px 可稳定单行（配合 lines:1 强制不换行） */
    font-size: 24px;
    line-height: 32px;
  }
  .enter-btn {
    width: 160px;
    max-width: 100%;
    height: 48px;
    font-size: 22px;
    line-height: 32px;
  }
  /* 原为 40px（低于 48px 规范），提到 48px */
  .settings-btn {
    width: 140px;
    max-width: 100%;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    line-height: 30px;
  }
  .exit-btn {
    width: 140px;
    max-width: 100%;
    height: 48px;
    border-radius: 24px;
    font-size: 20px;
    line-height: 30px;
    margin-top: 12px;
  }
}

@media (shape: rect) {
  .home-page {
    padding: 6px 8px 20px 8px;
  }
}
</style>