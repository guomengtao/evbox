<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="back-header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">工具</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="tool-scroll" scroll-y="true">
      <!-- 单一列表：一行一工具，28px 名称 + 24px 实时摘要（取不到就整行不显示，不留空行） -->
      <div class="tool-list">
        <div class="tool-row" for="{{ tools }}" onclick="openTool($item.uri)" style="background-color: {{ theme.card }}">
          <text class="tool-name" style="color: {{ theme.text }}">{{ $item.name }}</text>
          <text class="tool-sum" style="display: {{ $item.summary ? 'flex' : 'none' }}; color: {{ theme.textSecondary }}">{{ $item.summary }}</text>
        </div>
      </div>

      <!-- 诊断单独一段：靠底色与间距分组，不写「调试」「API测试」这类文字徽标，不画分隔线 -->
      <div class="tool-list debug-list">
        <div class="tool-row debug-row" onclick="openDeviceInfo" style="background-color: {{ theme.cardLight }}">
          <text class="tool-name" style="color: {{ theme.text }}">设备信息</text>
        </div>
        <div class="tool-row debug-row" onclick="openDeviceIdDiagnosis" style="background-color: {{ theme.cardLight }}">
          <text class="tool-name" style="color: {{ theme.text }}">设备ID诊断</text>
        </div>
        <div class="tool-row debug-row" onclick="openBlackScreenCheck" style="background-color: {{ theme.cardLight }}">
          <text class="tool-name" style="color: {{ theme.text }}">黑屏检测</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")
var toolSummaries = require("../index/modules/tool-summaries.js")
var textFit = require("../../common/text-fit.js")

// 工具全集：名称 ≤2 字（返回键 + 标题共存时 30px 只容得下 2 字，超出会被裁）
var TOOLS = [
  { id: "countdown", name: "倒数日", uri: "/pages/countdown-manage" },
  { id: "lunar", name: "农历", uri: "/pages/lunar-calendar" },
  { id: "calculator", name: "计算器", uri: "/pages/calculator" },
  { id: "quote", name: "一言", uri: "/pages/daily-quote" },
  { id: "answer", name: "答案", uri: "/pages/answer-book" },
  { id: "qrcode", name: "二维码", uri: "/pages/qrcode-generator" },
  { id: "vibrate", name: "震动", uri: "/pages/vibration-lab" },
  { id: "decide", name: "抉择", uri: "/pages/decide" }
]

// 静态定位兜底：实时摘要取不到（系统接口未就绪、无数据）时用它，
// 保证每行都有完整副标题，不出现空行也不出现残句。≤6P。
var FALLBACK = {
  countdown: "纪念日倒数",
  lunar: "宜忌与节气",
  calculator: "四则与换算",
  quote: "每日一句",
  answer: "想问就问",
  qrcode: "生成与分享",
  vibrate: "震动试试",
  decide: "随机抽签"
}

export default {
  private: {
    iconTheme: "dark",
    theme: {
      bg: '#1a1a2e',
      card: '#16213e',
      cardLight: '#0f3460',
      accent: '#7ec8e3',
      text: '#ffffff',
      textSecondary: '#888899',
      textMuted: '#555566',
      border: '#0f3460',
      borderLight: '#2a2a5a',
      icon: '●',
      progressOngoing: 'rgba(126,200,227,0.2)',
      progressDone: 'rgba(74,138,154,0.25)'
    },
    tools: TOOLS
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    this.loadSummaries()
  },

  onShow() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.updateIconSrc(themeName)
    })
    this.loadSummaries()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === 'light' || themeName === 'warm') ? 'light' : 'dark'
  },

  /**
   * 组装列表行：实时摘要优先，取不到或超预算就用静态定位兜底。
   * 同一套口径来自 text-fit.js（≤6P 完整语义），装不下就整段不要，绝不出现残句。
   */
  buildRows(map) {
    var out = []
    for (var i = 0; i < TOOLS.length; i++) {
      var t = TOOLS[i]
      var live = ""
      if (map && map[t.id]) live = map[t.id]
      var summary = ""
      try {
        summary = textFit.fitSummary(live) || textFit.fitSummary(FALLBACK[t.id] || "")
      } catch (e) {
        summary = ""
      }
      out.push({ id: t.id, name: t.name, uri: t.uri, summary: summary })
    }
    return out
  },

  // 首帧先用静态兜底，避免等异步接口导致整列没有副标题
  loadSummaries() {
    var self = this
    self.tools = self.buildRows(null)
    try {
      toolSummaries.getAll(function(map) {
        self.tools = self.buildRows(map)
      })
    } catch (e) {}
  },

  openTool(uri) {
    if (!uri) return
    router.push({ uri: uri })
  },

  openDeviceInfo() {
    router.push({ uri: "/pages/device-info" })
  },

  openDeviceIdDiagnosis() {
    router.push({ uri: "/pages/device-id-diagnosis" })
  },

  openBlackScreenCheck() {
    router.push({ uri: "/pages/black-screen-check" })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 44px 12px 16px 12px;
}

.back-header {
  flex-direction: row;
  width: 100%;
  align-items: center;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.back-btn-wrapper {
  width: 48px;
  height: 40px;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.back-btn-icon {
  width: 24px;
  height: 24px;
}

.header-title {
  flex: 1;
  font-size: 30px;
  font-weight: bold;
  text-align: center;
  line-height: 40px;
  lines: 1;
}

.header-placeholder {
  width: 48px;
  height: 40px;
  flex-shrink: 0;
}

.tool-scroll {
  flex: 1;
  flex-direction: column;
}

.tool-list {
  flex-direction: column;
  width: 100%;
}

/* 行内容纵向排列：名称在上、摘要在下，192px 宽屏才不会把摘要挤成两三个字 */
.tool-row {
  flex-direction: column;
  width: 100%;
  align-items: flex-start;
  justify-content: center;
  border-radius: 12px;
  padding: 8px 8px;
  margin-bottom: 8px;
}

.tool-name {
  font-size: 28px;
  line-height: 36px;
  lines: 1;
  width: 100%;
}

.tool-sum {
  font-size: 24px;
  line-height: 32px;
  lines: 1;
  width: 100%;
  margin-top: 2px;
}

/* 诊断段：只靠留白与底色区分，不加标题文字、不画分隔线 */
.debug-list {
  margin-top: 16px;
}

.debug-row {
  min-height: 52px;
}
</style>
