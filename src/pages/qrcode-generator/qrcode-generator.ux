  font-size: 28px;
  font-weight: bold;
  line-height: 34px;
}

.add-btn {
  height: 44px;
  border-radius: 12px;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}

.add-btn-text {
  font-size: 22px;
  font-weight: bold;
  line-height: 30px;
  lines: 1;
}

.list-area {
  flex: 1;
  flex-direction: column;
}

.accordion-item {
  flex-direction: column;
  border-radius: 12px;
  margin-bottom: 6px;
}

.accordion-header {
  flex-direction: row;
  align-items: center;
  padding: 10px 12px;
}

.item-name {
  flex: 1;
  font-size: 24px;
  font-weight: bold;
  line-height: 34px;
  lines: 1;
  text-overflow: ellipsis;
}

.item-arrow {
  font-size: 20px;
  line-height: 34px;
  flex-shrink: 0;
  margin-left: 6px;
}

.accordion-body {
  flex-direction: column;
  align-items: center;
  padding: 10px 0;
}

.qr-wrapper {
  padding: 6px;
  border-radius: 8px;
  margin-bottom: 8px;
  align-items: center;
  justify-content: center;
}

.content-text {
  font-size: 20px;
  line-height: 28px;
  lines: 3;
  text-overflow: ellipsis;
  text-align: center;
  margin-bottom: 8px;
  width: 100%;
}

.action-row {
  flex-direction: row;
  width: 100%;
}

.action-btn {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.edit-btn {
  margin-right: 4px;
}

.delete-btn {
  margin-left: 4px;
}

.action-btn-text {
  font-size: 20px;
  font-weight: bold;
  line-height: 28px;
  lines: 1;
}

.empty-state {
  flex: 1;
  justify-content: center;
  align-items: center;
  padding: 40px 0;
}

.empty-text {
  font-size: 22px;
  line-height: 30px;
  text-align: center;
}

@media (shape: capsule), (shape: pill-shaped) {
  .page-root {
    padding: 8px;
  }
        .home-bar {
    height: 40px;
    margin-bottom: 6px;
  }
  .home-icon {
    width: 28px;
    height: 28px;
  }
  .add-btn {
    height: 44px;
    margin-bottom: 8px;
  }
  .add-btn-text {
    font-size: 22px;
    line-height: 30px;
  }
  .accordion-header {
    padding: 10px 12px;
  }
  .item-name {
    font-size: 24px;
    line-height: 34px;
  }
  .item-arrow {
    font-size: 20px;
    line-height: 34px;
  }
  .accordion-body {
    padding: 10px 0;
  }
  .qr-wrapper {
    padding: 6px;
    margin-bottom: 8px;
  }
  .content-text {
    font-size: 20px;
    line-height: 28px;
  }
  .action-btn {
    height: 40px;
  }
  .action-btn-text {
    font-size: 20px;
    line-height: 28px;
  }
  .empty-text {
    font-size: 22px;
    line-height: 30px;
  }
}

@media (shape: rect) {
  .page-root {
    padding: 12px;
  }
        .home-bar {
    height: 46px;
    margin-bottom: 8px;
  }
  .home-icon {
    width: 32px;
    height: 32px;
  }
    .add-btn {
    height: 50px;
    margin-bottom: 10px;
  }
  .add-btn-text {
    font-size: 26px;
    line-height: 34px;
  }
  .accordion-header {
    padding: 14px 16px;
  }
  .item-name {
    font-size: 28px;
    line-height: 40px;
  }
  .item-arrow {
    font-size: 20px;
    line-height: 40px;
  }
  .accordion-body {
    padding: 14px 0;
  }
  .qr-wrapper {
    padding: 8px;
    margin-bottom: 10px;
  }
  .content-text {
    font-size: 22px;
    line-height: 30px;
  }
  .action-btn {
    height: 44px;
  }
  .action-btn-text {
    font-size: 22px;
    line-height: 30px;
  }
  .empty-text {
    font-size: 24px;
    line-height: 34px;
  }
}

@media (shape: circle) {
  .page-root {
    padding: 8px;
  }
        .home-bar {
    height: 40px;
    margin-bottom: 6px;
  }
  .home-icon {
    width: 28px;
    height: 28px;
  }
  .add-btn {
    height: 44px;
    margin-bottom: 8px;
  }
  .add-btn-text {
    font-size: 22px;
    line-height: 30px;
  }
  .accordion-header {
    padding: 10px 12px;
  }
  .item-name {
    font-size: 24px;
    line-height: 34px;
  }
  .item-arrow {
    font-size: 20px;
    line-height: 34px;
  }
  .accordion-body {
    padding: 0 6px 10px 6px;
  }
  .qr-wrapper {
    padding: 6px;
    margin-bottom: 8px;
  }
  .content-text {
    font-size: 20px;
    line-height: 28px;
  }
  .action-btn {
    height: 40px;
  }
  .action-btn-text {
    font-size: 20px;
    line-height: 28px;
  }
  .empty-text {
    font-size: 22px;
    line-height: 30px;
  }
}
</style>