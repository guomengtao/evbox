<template>
  <div class="page" style="background-color: {{ theme.bg }}">
    <div class="header">
      <div class="back-btn-wrapper" onclick="goBack" style="background-color: {{ theme.card }}">
        <image class="back-btn-icon" src="/common/icons/{{ iconTheme }}/icon_back.png"></image>
      </div>
      <text class="header-title" style="color: {{ theme.text }}">周模板</text>
      <div class="header-placeholder"></div>
    </div>

    <scroll class="scroll-wrap">
      <div class="list">
        <div class="card" for="(idx, tpl) in templateList" onclick="selectTemplate(tpl.id)"
             style="background-color: {{ theme.card }}; border-color: {{ selectedId === tpl.id ? theme.accent : 'transparent' }}">
          <div class="card-left">
            <text class="radio-dot {{ selectedId === tpl.id ? 'active' : '' }}"
                  style="color: {{ selectedId === tpl.id ? theme.accent : theme.textMuted }}">{{ selectedId === tpl.id ? '●' : '○' }}</text>
            <div class="card-info">
              <text class="card-name" style="color: {{ theme.text }}">{{ tpl.name }}</text>
              <text class="card-desc" style="color: {{ theme.textSecondary }}">{{ tpl.desc }}</text>
            </div>
          </div>
          <text class="card-check" if="{{ selectedId === tpl.id }}" style="color: {{ theme.accent }}">✓</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
const store = require("../../data/store.js")

var TEMPLATES = [
  { id: "minimal-char", name: "Minimal Char", desc: "Single Chinese character per subject, pure color blocks, no extra info" },
  { id: "minimal-en", name: "Minimal EN", desc: "English 3-letter abbreviation, clean blocks" },
  { id: "standard-block", name: "Standard Block", desc: "Full name + classroom + time, row numbers" },
  { id: "compact-grid", name: "Compact Grid", desc: "High density layout, show more items at once" },
  { id: "color-pastel", name: "Color Pastel", desc: "Soft pastel color scheme, gentle on eyes" }
]

export default {
  private: {
    iconTheme: "dark",
    theme: {},
    templateList: TEMPLATES,
    selectedId: "minimal-char"
  },

  onInit() {
    var self = this
    store.getTheme(function(t, themeName) {
      self.theme = t
      self.updateIconSrc(themeName)
    })
    store.getWeekViewTemplate(function(id) {
      self.selectedId = id || "minimal-char"
    })
  },

  selectTemplate(id) {
    var self = this
    self.selectedId = id
    store.setWeekViewTemplate(id, function() {
      router.back()
    })
  },

  goBack() {
    router.back()
  },

  updateIconSrc: function(themeName) {
    this.iconTheme = (themeName === "light" || themeName === "warm") ? "light" : "dark"
  }
}
</script>

<style>
@import '../../common/header.css';

.page {
  flex-direction: column;
  padding: 44px 10px 12px 10px;
  width: 100%;
  height: 100%;
  
}

.scroll-wrap {
  flex: 1;
}

.list {
  flex-direction: column;
  width: 100%;
}

.card {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 14px;
  margin-bottom: 10px;
  border-radius: 12px;
  border-width: 2px;
}

.card-left {
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.radio-dot {
  font-size: 24px;
  width: 28px;
  margin-right: 12px;
  text-align: center;
  line-height: 32px;
}

.card-info {
  flex-direction: column;
  flex: 1;
}

.card-name {
  font-size: 32px;
  font-weight: bold;
  line-height: 40px;
  lines: 1;
  text-overflow: ellipsis;
}

.card-desc {
  font-size: 28px;
  line-height: 36px;
  margin-top: 4px;
  lines: 2;
  text-overflow: ellipsis;
}

.card-check {
  font-size: 24px;
  font-weight: bold;
  margin-left: 10px;
  line-height: 32px;
}

@media (shape: circle) {
  .page {
    padding: 44px 36px 44px 36px;
  }
  
  
  
  .card {
    padding: 14px 12px;
  }
  .card-name {
    font-size: 32px;
  }
  .card-desc {
    font-size: 28px;
  }
  .radio-dot {
    font-size: 24px;
    width: 28px;
  }
}

@media (shape: capsule), (shape: pill-shaped) {
  .page {
    padding: 30px 8px 30px 8px;
  }
  
  
  
  .card {
    padding: 12px 10px;
    margin-bottom: 8px;
  }
  .radio-dot {
    margin-right: 6px;
  }
  .card-name {
    font-size: 32px;
    lines: 1;
    text-overflow: ellipsis;
  }
  .card-desc {
    font-size: 28px;
    lines: 1;
    text-overflow: ellipsis;
  }
  .card-check {
    margin-left: 6px;
  }

}

@media (shape: rect) {
  .page {
    padding: 6px 16px 12px 16px;
  }
  
  
}
</style>