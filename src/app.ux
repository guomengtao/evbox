<script>
var store = require("./data/store.js")
var authStore = require("./data/auth-store.js")
var syncChannel = require("./data/sync-channel.js")

// 日志开关：发布态关闭，避免手环上字符串拼接开销
var DEBUG = false
function dlog() {
  if (DEBUG) console.log.apply(console, arguments)
}

// 历史字号迁移：fontScale(倍率) -> baseFontSize(px)
function migrateFontScale() {
  var storage = require("@system.storage")
  storage.get({
    key: "fontScale",
    success: function(data) {
      var oldScale = parseFloat(data)
      if (oldScale && oldScale >= 0.5) {
        var newSize = Math.round(48 * oldScale)
        storage.set({
          key: "baseFontSize",
          value: String(newSize),
          success: function() {
            storage.delete({
              key: "fontScale",
              fail: function() {}
            })
          }
        })
      }
    },
    fail: function() {}
  })
}

export default {
  onCreate() {
    authStore.initAuth()
    store.getBaseFontSize(function(size) {
      if (!size) {
        store.setBaseFontSize(48)
      }
    })
    migrateFontScale()
    this.startSyncChannel()
  },

  // 同步通道：**默认关闭**（零耗电、不常驻）；用户在设置页开启后才 resident + interconnect
  startSyncChannel() {
    var resident = null
    try {
      resident = require("@system.resident")
    } catch (e) {
      resident = null
    }
    syncChannel.isEnabled(function(on) {
      if (!on) {
        dlog("[SYNC] 通道未开启，跳过常驻与连接")
        return
      }
      if (resident) {
        try {
          resident.start({
            success: function() { dlog("[SYNC] resident started") },
            fail: function(code) { dlog("[SYNC] resident start fail: " + code) }
          })
        } catch (e) {
          dlog("[SYNC] resident error: " + e)
        }
      }
      syncChannel.setup()
    })
  },

  // 刻意不 stop resident：保持通道在后台存活（与参考工程一致）
  onDestroy() {}
}
</script>
